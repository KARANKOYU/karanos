# live-build derleme çıktıları — bunlar CI'da üretilir, depoya girmez
iso/chroot/
iso/binary/
iso/cache/
iso/.build/
iso/local/
iso/build.log
iso/chroot.files
iso/chroot.packages.*
iso/*.iso
iso/*.img
iso/*.contents
iso/*.packages
iso/*.files
iso/config/binary
iso/config/bootstrap
iso/config/chroot
iso/config/common
iso/config/source
# ISO'ya girecek kavis-*.deb'ler CI'da buraya indirilir, depoda durmaz
iso/config/packages.chroot/

# Paket ağacına derleme sırasında kopyalanan kaynaklar — aslı assets/ altında
packages/*/src/logo/
packages/*/src/boot/

# Derlenmiş paketler
*.deb
*.buildinfo
*.changes
# dpkg-buildpackage'in paket ağacında bıraktıkları. Desenler
# packages/*/debian/ altını da tutmalı — başında `debian/` yazınca git
# bunu yalnızca depo kökünde arıyor ve derleme ağacı depoya giriyordu.
**/debian/.debhelper/
**/debian/files
**/debian/*.substvars
**/debian/*.debhelper
**/debian/*.debhelper.log
**/debian/debhelper-build-stamp
**/debian/kavis-*/
**/debian/tmp/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Çeviri derleme çıktısı (.po kaynak, .mo üretilir)
*.mo

# Test çıktıları
out/
serial-*.log

# Editör / araç ayarları (kişiye özel, depoya girmez)
.vscode/
.claude/
*.swp
.DS_Store

# Vala derleme ara ürünü (dh_auto_clean siler ama derleme sonrası kalır)
packages/kavis-panel/kavis-panel
packages/kavis-panel/kavis-snap
*.ddeb

# Ortak kaynakların derleme kopyaları (madde 61) — kanonik dosyalar
# packages/kavis-common/, kopyaları build-packages.sh koyar
packages/*/src/logic/appinit.vala
packages/*/src/appinit.vala
packages/kavis-panel/po/
packages/kavis-panel/src/logic/picker_data.vala
packages/kavis-panel/src/logic/emoji_names.vala
packages/kavis-panel/src/logic/power.vala
packages/kavis-tools/src/power.vala
packages/kavis-tools/kavis-tools
packages/kavis-settings/kavis-settings
