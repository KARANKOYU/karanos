# live-build outputs — produced in CI, never committed
iso/chroot/
iso/binary/
iso/cache/
iso/.build/
iso/local/
iso/build.log
iso/chroot.files
iso/chroot.packages.*
iso/*.iso
iso/*.img
iso/*.contents
iso/*.packages
iso/*.files
iso/config/binary
iso/config/bootstrap
iso/config/chroot
iso/config/common
iso/config/source
# kavis-*.deb files destined for the ISO are downloaded here in CI, not kept in the repo
iso/config/packages.chroot/

# Assets copied into the package trees at build time — the originals live under assets/
packages/*/src/logo/
packages/*/src/boot/

# Built packages
*.deb
*.buildinfo
*.changes
# Leftovers dpkg-buildpackage drops in the package tree. The patterns must
# also cover packages/*/debian/ — with a leading `debian/` git only looked
# at the repo root and the build tree ended up committed.
**/debian/.debhelper/
**/debian/files
**/debian/*.substvars
**/debian/*.debhelper
**/debian/*.debhelper.log
**/debian/debhelper-build-stamp
**/debian/kavis-*/
**/debian/tmp/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Compiled translations (.po is the source, .mo is generated)
*.mo

# Test outputs
out/
serial-*.log

# Editor / tool settings (personal, not committed)
.vscode/
.claude/
*.swp
.DS_Store

# Vala build intermediates (dh_auto_clean removes them, but they linger after a build)
packages/kavis-panel/kavis-panel
packages/kavis-panel/kavis-snap
packages/kavis-panel/kavis-osd
packages/kavis-settings/kavis-settings
packages/kavis-tools/kavis-tools
*.ddeb

# Build-time copies of shared sources (item 61) — canonical files live in
# packages/kavis-common/, the copies are placed by build-packages.sh
packages/*/src/logic/appinit.vala
packages/*/src/headerbar.vala
packages/*/src/theme.vala
packages/*/src/logic/theme.vala
packages/*/src/logic/easing.vala
packages/*/src/logic/sunclock.vala
packages/*/src/logic/nightlight.vala
packages/kavis-tools/src/config.vala
packages/kavis-taskmanager/src/config.vala
packages/kavis-taskmanager/src/sysinfo.vala
packages/kavis-settings/src/logic/sysinfo.vala
packages/*/src/logic/config.vala
packages/*/src/logic/powerplan.vala
packages/*/src/logic/brightness.vala
packages/*/src/logic/xkb.vala
packages/*/src/appinit.vala
packages/kavis-panel/po/
packages/kavis-panel/src/logic/picker_data.vala
packages/kavis-panel/src/logic/emoji_names.vala
packages/kavis-panel/src/logic/power.vala
packages/kavis-tools/src/power.vala
packages/kavis-tools/kavis-tools
packages/kavis-settings/kavis-settings
packages/kavis-tools/fastfetch/os-release
packages/kavis-selftest/scenarios/
packages/kavis-selftest/kavis-selftest
packages/kavis-taskmanager/kavis-taskmanager
