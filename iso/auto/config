#!/bin/sh
# Kavis — live-build yapılandırması
#
# Bu dosya `lb config` çalıştığında otomatik yürütülür.
# ELLE `lb config` PARAMETRESİ VERME — her şey burada dursun ki
# GitHub Actions ile yerel çalıştırma aynı sonucu üretsin.

set -e

# Ürün kimliği TEK kaynaktan: tema paketindeki os-release. Görünen ad
# (NAME) ve kimlik (ID) buraya elle yazılmıyor — isim değişirse yalnızca
# o dosya güncellenir. Bu script iso/ dizininden çalışır (lb config).
OS_RELEASE="../packages/kavis-theme/src/os-release"
if [ ! -f "$OS_RELEASE" ]; then
	echo "HATA: $OS_RELEASE yok — ürün kimliği okunamadı." >&2
	exit 1
fi
# shellcheck disable=SC1090
. "$OS_RELEASE"

# Sürüm: CI ortam değişkeninden gelir, yoksa geliştirme sürümü
KAVIS_VERSION="${KAVIS_VERSION:-${VERSION_ID}-dev}"

# Açılış satırı.
# NOT: `quiet splash` şu an KAPALI — 1. aşamada boot mesajlarını görmek
# istiyoruz. 3. aşamada (Plymouth teması) açılacak.
# console=ttyS0 CI'daki QEMU testinin boot günlüğünü okuyabilmesi için;
# seri portu olmayan gerçek donanımda hiçbir etkisi yok.
BOOTAPPEND="boot=live components \
username=karan \
hostname=${ID} \
user-default-groups=audio,cdrom,dip,floppy,video,plugdev,netdev,scanner,bluetooth,sudo,nopasswdlogin \
locales=tr_TR.UTF-8 \
timezone=Europe/Istanbul \
keyboard-layouts=tr \
quiet splash plymouth.ignore-serial-consoles \
console=tty0 console=ttyS0,115200n8"

# `quiet splash` 3. aşamada eklendi: `splash` Plymouth açılış ekranını
# başlatıyor, `quiet` de çekirdek mesajlarının splash'in üstüne
# taşmasını engelliyor.
#
# `plymouth.ignore-serial-consoles` ŞART: çekirdek satırında
# `console=ttyS0` varken Plymouth seri konsolu birincil sayıyor ve
# grafik splash'i hiç çizmiyor — VGA ekranında yalnızca systemd'nin
# metin çıktısı akıyor. CI seri konsolu bırakamayacağımız için (duman
# testinin tek çıktı kanalı o) splash'i açık tutmanın yolu bu bayrak.
#
# DİKKAT: `quiet` seri konsola giden çekirdek mesajlarını da kısıyor.
# Duman testi eskiden "Linux version" satırına bakarak çekirdeğin
# başladığını anlıyordu; o satır artık görünmediği için
# tools/qemu-smoke-test.sh daha geniş bir desene bakıyor. Boot-check'in
# kendi çıktısı systemd üzerinden geldiği için etkilenmiyor.

lb config noauto \
	--mode debian \
	--distribution trixie \
	--parent-distribution trixie \
	--architecture amd64 \
	--archive-areas "main contrib non-free non-free-firmware" \
	--parent-archive-areas "main contrib non-free non-free-firmware" \
	--binary-images iso-hybrid \
	--bootloaders "grub-pc,grub-efi" \
	--uefi-secure-boot enable \
	--linux-flavours amd64 \
	--debian-installer none \
	--memtest none \
	--win32-loader false \
	--apt-indices false \
	--apt-recommends false \
	--updates true \
	--security true \
	--backports false \
	--firmware-binary false \
	--firmware-chroot false \
	--image-name "${ID}" \
	--iso-application "${NAME}" \
	--iso-publisher "${NAME}; ${HOME_URL}" \
	--iso-volume "${NAME} ${KAVIS_VERSION}" \
	--bootappend-live "${BOOTAPPEND}" \
	"${@}"

# --------------------------------------------------------------------------
# Seçimlerin gerekçeleri (silme, ileride "bu neden böyle" diye sorulacak):
#
# --apt-recommends false   : Hafiflik (prompt 20). Bunun bedeli, gereken her
#                            paketi listelerde AÇIKÇA yazmak zorunda olmamız.
#                            Kurulu sistemde tavsiye paketleri yeniden açılır
#                            (hooks/normal/9990-apt-recommends.hook.chroot).
# --firmware-chroot false  : live-build'in tüm firmware-* paketlerini
#                            gelişigüzel eklemesini istemiyoruz; prompt 16'daki
#                            listeyi elle veriyoruz (03-firmware listesi).
# --uefi-secure-boot enable: Debian'ın imzalı shim/grub'unu kullanır.
#                            Prompt 2 + 18: Secure Boot açıkken boot etmeli.
# --debian-installer none  : Kurulum Calamares ile olacak (prompt 14),
#                            d-i ISO'ya gömülmeyecek.
# --memtest none,
# --apt-indices false      : ISO boyutu (1.5 GB hedefi).
# --------------------------------------------------------------------------
