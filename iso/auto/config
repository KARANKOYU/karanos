#!/bin/sh
# Kavis — live-build configuration
#
# This file runs automatically when `lb config` is invoked.
# NEVER PASS `lb config` PARAMETERS BY HAND — keep everything here so that
# GitHub Actions and a local run produce the same result.

set -e

# Product identity from a SINGLE source: the os-release in the theme
# package. The display name (NAME) and identifier (ID) are not written
# here by hand — if the name changes, only that file is updated. This
# script runs from the iso/ directory (lb config).
OS_RELEASE="../packages/kavis-theme/src/os-release"
if [ ! -f "$OS_RELEASE" ]; then
	echo "ERROR: $OS_RELEASE missing — product identity could not be read." >&2
	exit 1
fi
# shellcheck disable=SC1090
. "$OS_RELEASE"

# Version: comes from the CI environment variable, otherwise a dev version
KAVIS_VERSION="${KAVIS_VERSION:-${VERSION_ID}-dev}"

# Architecture from a SINGLE variable (multi-arch readiness rule). Only the
# amd64 ISO is produced today; when arm64 is wanted, KAVIS_ARCH=arm64 must
# be enough and nothing else in this file should need to change. The
# string amd64 appears below only in this case block.
KAVIS_ARCH="${KAVIS_ARCH:-amd64}"
case "$KAVIS_ARCH" in
amd64)
	# BIOS (grub-pc) + UEFI; Secure Boot with Debian's signed shim/grub.
	BOOTLOADERS="grub-pc,grub-efi"
	;;
arm64)
	# No BIOS concept; UEFI only. Debian ships signed shim/grub for arm64
	# too. NOTE: the arm64 build is NOT in CI yet and has never been
	# tried — this branch is "one line is enough when the day comes"
	# preparation.
	BOOTLOADERS="grub-efi"
	;;
*)
	echo "ERROR: unsupported architecture: $KAVIS_ARCH (amd64|arm64)" >&2
	exit 1
	;;
esac

# Boot line.
# Default language EN (decision of 2 Sep 2026 — global release):
# locales=en_US.UTF-8; the KEYBOARD STAYS TR Q (keyboard-layouts=tr).
# GRUB/splash/F3 texts are English too (9600/9601 hooks and the
# kavis-boot SVGs). Switching back to TR via Settings > Language (Group F).
# NOTE: `quiet splash` is currently OFF — we want to see the boot messages
# in stage 1. Turned on in stage 3 (Plymouth theme).
# console=ttyS0 lets the QEMU test in CI read the boot log; it has no
# effect on real hardware without a serial port.
BOOTAPPEND="boot=live components \
username=karan \
hostname=${ID} \
user-default-groups=audio,cdrom,dip,floppy,video,plugdev,netdev,scanner,bluetooth,sudo,nopasswdlogin,input \
locales=en_US.UTF-8,tr_TR.UTF-8 \
timezone=Europe/Istanbul \
keyboard-layouts=tr \
quiet loglevel=3 vt.global_cursor_default=0 rd.udev.log_level=3 \
splash plymouth.ignore-serial-consoles \
console=tty0 console=ttyS0,115200n8"

# `quiet splash` was added in stage 3: `splash` starts the Plymouth boot
# screen and `quiet` keeps kernel messages from spilling over the splash.
#
# `loglevel=3` hides more than quiet does: no kernel message up to and
# including KERN_ERR (3) reaches the console, only crit/alert/emerg (0-2)
# show. On VirtualBox's default VMSVGA controller, vmwgfx "*ERROR* ...
# unsupported hypervisor" lines were scrolling in red between GRUB and
# the splash and between the splash and the desktop; they are harmless
# (the driver falls back to simpledrm, boot continues) but must not be the
# first thing the user sees. The messages stay in journald (`journalctl
# -k` has the full log); only the CONSOLE is muted — a real problem is
# still readable from the CI diagnostics artifact and journalctl.
#
# `vt.global_cursor_default=0` turns off the virtual console's blinking
# cursor (the white line that appears in the corner before/after the
# splash).
# `rd.udev.log_level=3` quiets systemd-udevd inside the initramfs (the
# rd. prefix means "applies in the initrd"; udevd accepts both forms).
#
# `plymouth.ignore-serial-consoles` is REQUIRED: with `console=ttyS0` on
# the kernel line Plymouth treats the serial console as primary and never
# draws the graphical splash — only systemd's text output flows on the
# VGA screen. Since we cannot drop the serial console in CI (it is the
# smoke test's only output channel), this flag is how the splash stays on.
#
# NOTE: `quiet` also mutes the kernel messages going to the serial
# console. The smoke test used to detect kernel start by the "Linux
# version" line; since that line no longer shows,
# tools/qemu-smoke-test.sh looks for a broader pattern. Boot-check's own
# output comes through systemd and is unaffected.

lb config noauto \
	--mode debian \
	--distribution trixie \
	--parent-distribution trixie \
	--architecture "$KAVIS_ARCH" \
	--archive-areas "main contrib non-free non-free-firmware" \
	--parent-archive-areas "main contrib non-free non-free-firmware" \
	--binary-images iso-hybrid \
	--bootloaders "$BOOTLOADERS" \
	--uefi-secure-boot enable \
	--linux-flavours "$KAVIS_ARCH" \
	--debian-installer none \
	--memtest none \
	--win32-loader false \
	--apt-indices false \
	--apt-recommends false \
	--updates true \
	--security true \
	--backports false \
	--firmware-binary false \
	--firmware-chroot false \
	--image-name "${ID}" \
	--iso-application "${NAME}" \
	--iso-publisher "${NAME}; ${HOME_URL}" \
	--iso-volume "${NAME} ${KAVIS_VERSION}" \
	--bootappend-live "${BOOTAPPEND}" \
	"${@}"

# --------------------------------------------------------------------------
# Rationale for the choices (do not delete; "why is this so" will be asked):
#
# --apt-recommends false   : Lightness (prompt 20). The price is that every
#                            needed package must be written EXPLICITLY in
#                            the lists. Recommends are re-enabled on the
#                            installed system
#                            (hooks/normal/9990-apt-recommends.hook.chroot).
# --firmware-chroot false  : We do not want live-build to add every
#                            firmware-* package indiscriminately; the list
#                            from prompt 16 is given by hand (03-firmware).
# --uefi-secure-boot enable: Uses Debian's signed shim/grub.
#                            Prompt 2 + 18: must boot with Secure Boot on.
# --debian-installer none  : Installation will be done with Calamares
#                            (prompt 14); d-i is not embedded in the ISO.
# --memtest none,
# --apt-indices false      : ISO size (1.5 GB target).
# --------------------------------------------------------------------------
