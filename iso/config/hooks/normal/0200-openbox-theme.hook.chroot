#!/bin/sh
# Kavis — switch Openbox to the Kavis theme
#
# WHY A HOOK, WHY NOT REPLACE THE WHOLE FILE:
# Openbox's window theme is independent of the GTK theme; <theme><name>
# in /etc/xdg/openbox/rc.xml sets it. Replacing that file with our own
# looks easy, but rc.xml also carries ALL mouse and keyboard bindings —
# in an rc.xml without a <mouse> section you cannot drag a window by its
# title bar or click its buttons. So we keep Debian's full file and
# change only two fields.

set -e

# --- Host guard (4 Sep 2026 incident) --------------------------------
# This hook edits the RUNNING system. On a developer machine that means
# the real /home, /etc, initramfs or systemd state — one stray run cost
# a whole Codespace (its user account and /home had to be rebuilt).
# live-build copies includes.chroot before the normal hooks, so the
# marker exists inside the build chroot and nowhere else.
if [ ! -f /usr/share/kavis/build-marker ]; then
	echo "E: $0 runs only inside the live-build chroot (marker missing)" >&2
	exit 1
fi

RC=/etc/xdg/openbox/rc.xml

if [ ! -f "$RC" ]; then
	echo "E: $RC missing — is openbox installed?" >&2
	exit 1
fi

# The FIRST <name> in the <theme> block is the theme name; the following
# ones are font names. Hence "first match" logic instead of plain sed.
awk '
	/<theme>/            { intheme = 1 }
	intheme && !done && /<name>/ {
		sub(/<name>[^<]*<\/name>/, "<name>Kavis</name>")
		done = 1
	}
	{ print }
' "$RC" > "$RC.new"
mv "$RC.new" "$RC"

# Windows-like title bar: icon, title, then minimize/maximize/close
sed -i 's|<titleLayout>[^<]*</titleLayout>|<titleLayout>NLIMC</titleLayout>|' "$RC"

if grep -q '<name>Kavis</name>' "$RC"; then
	echo "I: Openbox theme set to Kavis"
else
	echo "E: could not write the theme name into rc.xml" >&2
	exit 1
fi
