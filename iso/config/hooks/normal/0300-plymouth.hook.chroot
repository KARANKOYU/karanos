#!/bin/sh
# Kavis — embed the Plymouth theme into the initramfs
#
# WHY A SEPARATE HOOK:
# The boot screen must show BEFORE the root file system is mounted, i.e.
# the theme must be inside the initramfs. `plymouth-set-default-theme -R`
# does that in one step, but -R regenerates the initramfs on every
# package installation; in the live-build chroot that adds minutes to the
# build. So kavis-boot's postinst only selects the theme, and we generate
# the initramfs once here.
#
# This hook runs after the packages (chroot_local-packages ->
# chroot_local-hooks), so the theme is installed at this point.

set -e

if [ ! -d /usr/share/plymouth/themes/kavis ]; then
	echo "E: kavis Plymouth theme missing — is kavis-boot installed?" >&2
	exit 1
fi

# Is the theme selected (postinst should have done it; make sure)
plymouth-set-default-theme kavis

selected=$(plymouth-set-default-theme)
if [ "$selected" != "kavis" ]; then
	echo "E: default theme did not become 'kavis', still '$selected'" >&2
	exit 1
fi

update-initramfs -u

# Is the theme really inside the initramfs? Otherwise a black screen
# shows instead of the splash at boot, and the cause cannot be seen
# without booting the ISO.
img=$(ls -1 /boot/initrd.img-* 2>/dev/null | sort | tail -1)
if [ -z "$img" ]; then
	echo "E: initrd not found" >&2
	exit 1
fi

contents=$(lsinitramfs "$img" 2>/dev/null)

if echo "$contents" | grep -q "plymouth/themes/kavis"; then
	echo "I: Plymouth theme entered the initramfs ($img)"
else
	echo "E: kavis theme not inside the initramfs — splash will not show" >&2
	echo "E: initrd: $img" >&2
	exit 1
fi

# The splash is drawn on the DRM (KMS) device. If the display driver is
# not in the initramfs there is no DRM device either, and Plymouth falls
# back to text mode: kernel text scrolls instead of the splash. Exactly
# this happened. At least one from the list in
# /etc/initramfs-tools/modules must have made it in.
drm_found=$(echo "$contents" |
	grep -oE '/(bochs|bochs_drm|qxl|virtio_gpu|vmwgfx|vboxvideo|simpledrm|i915|amdgpu|nouveau)\.ko' |
	sed 's|^/||; s|\.ko$||' | sort -u | tr '\n' ' ')
drm_count=$(echo "$drm_found" | wc -w)
if [ "$drm_count" -gt 0 ]; then
	echo "I: initramfs has $drm_count display (DRM) driver(s): $drm_found"
	# Virtual machine drivers are reported separately: if one is missing,
	# Plymouth falls back to text mode on that hypervisor and the splash
	# does not show. vboxvideo is critical on VirtualBox (vmwgfx does not
	# work there), bochs on QEMU. Real hardware drivers
	# (i915/amdgpu/nouveau) are on the list too: if they are not in the
	# initramfs the splash is delayed until the driver loads after the
	# root mount (boot experience task, TASK 1).
	for required in bochs qxl virtio_gpu vboxvideo vmwgfx i915 amdgpu nouveau; do
		case " $drm_found " in
		*" $required "*) echo "I:   ✓ $required" ;;
		*) echo "W:   ! $required not in the initramfs — splash may not show on that virtual machine" >&2 ;;
		esac
	done
else
	echo "E: no DRM driver in the initramfs at all — Plymouth falls back to text mode" >&2
	echo "E: was /etc/initramfs-tools/modules read?" >&2
	exit 1
fi
