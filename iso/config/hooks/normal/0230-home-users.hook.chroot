#!/bin/sh
# Kavis — /home → /users symbolic link (test8 E3)
#
# Homes live under /users (Group B decision: autologin + /users/karan);
# an empty /home was confusing in the file manager. /home is now a link
# to /users — both paths lead to the same place.

set -e

# --- Host guard (4 Sep 2026 incident) --------------------------------
# This hook edits the RUNNING system. On a developer machine that means
# the real /home, /etc, initramfs or systemd state — one stray run cost
# a whole Codespace (its user account and /home had to be rebuilt).
# live-build copies includes.chroot before the normal hooks, so the
# marker exists inside the build chroot and nowhere else.
if [ ! -f /usr/share/kavis/build-marker ]; then
	echo "E: $0 runs only inside the live-build chroot (marker missing)" >&2
	exit 1
fi

if [ -L /home ]; then
	echo "I: /home is already a link"
	exit 0
fi
if [ -d /home ] && [ -n "$(ls -A /home 2>/dev/null)" ]; then
	echo "W: /home is not empty, link skipped (contents preserved)" >&2
	exit 0
fi
rmdir /home 2>/dev/null || true
mkdir -p /users
ln -sfn /users /home
echo "I: /home -> /users link created"
