#!/bin/sh
# Kavis — /home → /users symbolic link (test8 E3)
#
# Homes live under /users (Group B decision: autologin + /users/karan);
# an empty /home was confusing in the file manager. /home is now a link
# to /users — both paths lead to the same place.

set -e

if [ -L /home ]; then
	echo "I: /home is already a link"
	exit 0
fi
if [ -d /home ] && [ -n "$(ls -A /home 2>/dev/null)" ]; then
	echo "W: /home is not empty, link skipped (contents preserved)" >&2
	exit 0
fi
rmdir /home 2>/dev/null || true
mkdir -p /users
ln -sfn /users /home
echo "I: /home -> /users link created"
