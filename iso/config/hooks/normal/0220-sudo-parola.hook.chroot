#!/bin/sh
# Kavis — sudo parola yıldızları (test8 E1)
#
# Windows'tan gelen kullanıcı parola yazarken hiçbir şey görünmemesini
# "donmuş" sanıyor; pwfeedback her karakterde * basar.
# sudoers.d dosyası 0440 + root sahipli olmak zorunda; visudo -c ile
# sözdizimi doğrulanır — bozuk dosya sudo'yu kilitler.

set -e

DOSYA=/etc/sudoers.d/kavis
printf '# Kavis: parola yazarken yildiz goster (test8 E1)\nDefaults pwfeedback\n' > "$DOSYA"
chmod 0440 "$DOSYA"
chown root:root "$DOSYA"

if command -v visudo >/dev/null 2>&1; then
	visudo -cf "$DOSYA" >/dev/null || {
		echo "E: sudoers.d/kavis gecersiz" >&2
		rm -f "$DOSYA"
		exit 1
	}
fi
echo "I: sudo pwfeedback etkin"
