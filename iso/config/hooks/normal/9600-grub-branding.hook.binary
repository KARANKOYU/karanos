#!/bin/sh
# Kavis — brand the GRUB boot menu as Kavis
#
# WHY IT EXISTS: the menu was Debian/live-build branded — "Live system
# (amd64)" entries, the "Live Boot Menu with GRUB" title, Debian's splash.
# It is the first screen the user sees; it must carry the distro's
# identity.
#
# ACTUAL LAYOUT (learned in the v0.2-test1 run — the first version
# targeted the wrong file):
#   - The menu ENTRIES are in grub.cfg AND loopback.cfg (NOT in
#     config.cfg; that holds only settings).
#   - The visual theme is live-theme/theme.txt (gfxmenu) — but ONLY active
#     while /boot/grub/splash.png exists (the condition in theme.cfg). The
#     first version deleted splash.png as a "Debian leftover" and turned
#     the theme off by accident; the right thing is to write our own
#     background OVER it.
#
# WORKING DIRECTORY: binary hooks run INSIDE the `binary/` directory.
#
# THIS HOOK DOES NOT STOP THE BUILD (cosmetic), but the "in-ISO bootloader
# verification" step in CI checks the result through grub.cfg — silent
# failure is now caught there.

set -e

# --- product name: from the single source -----------------------------
PRODUCT=""
for osr in ../chroot/etc/os-release chroot/etc/os-release; do
	if [ -f "$osr" ]; then
		PRODUCT=$(sed -n 's/^NAME="\?\([^"]*\)"\?$/\1/p' "$osr" | head -1)
		break
	fi
done
if [ -z "$PRODUCT" ]; then
	echo "W: could not read the product name from os-release, branding skipped" >&2
	exit 0
fi
echo "I: product name (os-release): $PRODUCT"

grubdir=""
for candidate in boot/grub ../binary/boot/grub binary/boot/grub; do
	if [ -d "$candidate" ]; then
		grubdir="$candidate"
		break
	fi
done
if [ -z "$grubdir" ]; then
	echo "W: GRUB directory not found, branding skipped (working directory: $(pwd))" >&2
	exit 0
fi
echo "I: GRUB directory: $grubdir"

# --- names of the menu entries ----------------------------------------
# The entries are in both grub.cfg and loopback.cfg (live-build writes
# both). One-to-one mapping instead of a blanket sed: if an unexpected
# name shows up we leave it as-is rather than breaking it silently.
for cfg in "$grubdir/grub.cfg" "$grubdir/loopback.cfg"; do
	[ -f "$cfg" ] || continue
	sed -i \
		-e "s|menuentry \"Live system (\([^)]*\) fail-safe mode)\"|menuentry \"$PRODUCT (safe mode, \1)\" --class safemode|" \
		-e "s|menuentry \"Live system (\([^)]*\))\"|menuentry \"$PRODUCT (\1)\" --class kavis|" \
		-e "s|menuentry \"Live system, kernel \([^\"]*\)\"|menuentry \"$PRODUCT (kernel \1)\" --class kavis|" \
		-e "s|menuentry \"Debian GNU/Linux[^\"]*\"|menuentry \"$PRODUCT\" --class kavis|" \
		"$cfg"
	count=$(grep -c "menuentry \"$PRODUCT" "$cfg" || true)
	echo "I: $(basename "$cfg"): $count entries branded"
done

# --- background: the gfxmenu theme's splash.png -----------------------
# Rule (item 1): ALWAYS the dark logo in GRUB. The kavis-theme build
# produces a flat-background image from koyu-k-logo; we write it under
# the name the live-build theme expects (splash.png) — the theme stays
# active.
bg=""
for candidate in \
	../chroot/usr/share/kavis/logo/grub-background.png \
	chroot/usr/share/kavis/logo/grub-background.png
do
	if [ -f "$candidate" ]; then
		bg="$candidate"
		break
	fi
done
if [ -n "$bg" ]; then
	cp "$bg" "$grubdir/splash.png"
	echo "I: GRUB background (splash.png) placed ($bg)"
else
	echo "W: grub-background.png not found, live-build splash kept" >&2
fi

# --- gfxmenu theme: Kavis's OWN theme.txt (test8 H1) ------------------
# Instead of repainting the live-build theme's palette, the theme is
# written from scratch: dark ground + logo in the middle
# (grub-background.png in the top third), entry icons (--class match), the
# SELECTED entry in a rounded turquoise box (9 slices), countdown + hint
# line at the bottom.
#
# GRUB LIMITS (things that are not possible — H1 asked, so it is written
# down):
#   - a box can be given ONLY to the selected entry (no item_pixmap);
#     unselected entries stay plain text.
#   - a SEPARATE description line under an entry cannot be drawn; the
#     description follows the title as "— ..." (already so).
#   - no mouse/hover; keyboard menu.
THEME_DIR="$grubdir/live-theme"
THEME="$THEME_DIR/theme.txt"
if [ -d "$THEME_DIR" ]; then
	# Assets: the slices + icons + background produced by the theme package.
	assets=""
	for candidate in \
		../chroot/usr/share/kavis/logo/grub-theme \
		chroot/usr/share/kavis/logo/grub-theme
	do
		if [ -d "$candidate" ]; then
			assets="$candidate"
			break
		fi
	done
	if [ -n "$assets" ]; then
		cp "$assets"/select_*.png "$THEME_DIR"/
		mkdir -p "$THEME_DIR/icons"
		cp "$assets"/icons/*.png "$THEME_DIR/icons/"
	else
		echo "W: grub-theme assets missing, no box/icons will show" >&2
	fi
	if [ -n "$bg" ]; then
		cp "$bg" "$THEME_DIR/kavis-background.png"
	fi

	cat > "$THEME" <<'TEOF'
# Kavis GRUB gfxmenu theme — generated by the 9600 hook (test8 H1)
title-text: ""
desktop-image: "kavis-background.png"
desktop-color: "#0D141B"
terminal-font: "Unifont Regular 16"

+ boot_menu {
	left = 20%
	width = 60%
	top = 45%
	height = 38%
	item_font = "Unifont Regular 16"
	item_color = "#E6EDF3"
	selected_item_color = "#0D141B"
	item_height = 36
	item_spacing = 8
	item_padding = 4
	icon_width = 24
	icon_height = 24
	item_icon_space = 12
	selected_item_pixmap_style = "select_*.png"
}

#countdown (Kavis)
+ label {
	id = "__timeout__"
	left = 0
	width = 100%
	top = 100%-80
	height = 20
	align = "center"
	color = "#8B9BA8"
	font = "Unifont Regular 16"
	text = "Starting automatically in %d seconds"
}

+ label {
	left = 0
	width = 100%
	top = 100%-52
	height = 20
	align = "center"
	color = "#8B9BA8"
	font = "Unifont Regular 16"
	text = "Enter: start    F3: advanced menu"
}
TEOF

	if grep -q '__timeout__' "$THEME" && grep -q 'boot_menu' "$THEME"; then
		echo "I: Kavis gfxmenu theme written (box + icons + countdown)"
	else
		echo "E: theme.txt write could not be verified" >&2
		exit 1
	fi
else
	echo "W: live-theme directory missing, theme skipped" >&2
fi

# --- text mode fallback (if the theme cannot load) --------------------
# theme.cfg falls back to text colors when splash.png is missing or the
# theme cannot be set up; so that our palette applies instead of the
# cyan/blue there, we write to the END of config.cfg (config.cfg keeps
# being read after it sources theme.cfg; the last writer wins).
CFG="$grubdir/config.cfg"
if [ -f "$CFG" ]; then
	cat >> "$CFG" <<EOF

### $PRODUCT — text mode colors (gfxmenu fallback) ###
set color_normal=light-gray/black
set color_highlight=black/cyan
set menu_color_normal=light-gray/black
set menu_color_highlight=black/cyan
EOF
fi

echo "I: GRUB menu branded as $PRODUCT"
