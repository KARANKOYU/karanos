#!/bin/sh
# Kavis — genel kısayol altyapısı (madde 6)
#
# NEDEN HOOK: 0200 ile aynı sebep — Debian'ın rc.xml'i komple
# değiştirilmez (fare bölümü ve varsayılan kısayollar kaybolur), yalnız
# Kavis bloğu </keyboard> kapanışından önce enjekte edilir. Kısayollar
# TEK yerde (bu blok) durur; Ayarlar (Grup F, madde 29E) aynı bloğu
# düzenleyecek.
#
# Pencere yerleştirme (Windows karşılıkları):
#   Win+Sol/Sağ  : yarım ekran sola/sağa (önce büyütme kaldırılır —
#                  büyütülmüş pencerede MoveResizeTo işlemez)
#   Win+Yukarı   : büyüt
#   Win+Aşağı    : büyütülmüşse eski boyut, değilse simge durumuna
#   Alt+Tab      : Debian varsayılanı zaten var, dokunulmuyor
#   Ctrl+Alt+ok  : masaüstü geçişi — Debian varsayılanında var
# Sürükleyerek kenara yapıştırma klavyenin işi değil: kavis-snap
# daemon'u yapıyor (kavis-panel paketi).

set -e

RC=/etc/xdg/openbox/rc.xml

if [ ! -f "$RC" ]; then
	echo "E: $RC yok — openbox kurulu mu?" >&2
	exit 1
fi

if grep -q "Kavis kisayollari" "$RC"; then
	echo "I: kisayollar zaten ekli"
	exit 0
fi

SNIPPET=$(mktemp)
cat > "$SNIPPET" <<'EOF'
    <!-- Kavis kisayollari (madde 6) — 0210 hook'u ekledi -->
    <keybind key="W-Left">
      <action name="Unmaximize"/>
      <action name="MoveResizeTo">
        <x>0</x><y>0</y><width>50%</width><height>100%</height>
      </action>
    </keybind>
    <keybind key="W-Right">
      <action name="Unmaximize"/>
      <action name="MoveResizeTo">
        <x>-0</x><y>0</y><width>50%</width><height>100%</height>
      </action>
    </keybind>
    <keybind key="W-Up">
      <action name="Maximize"/>
    </keybind>
    <keybind key="W-Down">
      <action name="If">
        <maximized>yes</maximized>
        <then><action name="Unmaximize"/></then>
        <else><action name="Iconify"/></else>
      </action>
    </keybind>
    <!-- Genel bakis (madde 55): calisan panele DBus ile soyleniyor -->
    <keybind key="W-Tab">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Panel --object-path /org/kavis/Panel --method org.kavis.Panel.ShowOverview</command>
      </action>
    </keybind>
    <!-- Snap yerlesim menusu (sonraki-isler 4) -->
    <keybind key="W-z">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Panel --object-path /org/kavis/Panel --method org.kavis.Panel.ShowSnapMenu</command>
      </action>
    </keybind>
    <!-- Pano gecmisi (madde 7) — artik birlesik panelin pano sekmesi -->
    <keybind key="W-v">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Panel --object-path /org/kavis/Panel --method org.kavis.Panel.ShowClipboard</command>
      </action>
    </keybind>
    <!-- Emoji ve daha fazlasi (sonraki-isler 5): son kullanilan sekme -->
    <keybind key="W-period">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Panel --object-path /org/kavis/Panel --method org.kavis.Panel.ShowPicker last</command>
      </action>
    </keybind>
    <!-- Ses/parlaklik/medya tuslari -> kavis-osd (sonraki-isler 6a):
         panelden ayri surec, panel cokse bile calisir -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Osd --object-path /org/kavis/Osd --method org.kavis.Osd.VolumeUp</command>
      </action>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Osd --object-path /org/kavis/Osd --method org.kavis.Osd.VolumeDown</command>
      </action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Osd --object-path /org/kavis/Osd --method org.kavis.Osd.VolumeMute</command>
      </action>
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Osd --object-path /org/kavis/Osd --method org.kavis.Osd.BrightnessUp</command>
      </action>
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Osd --object-path /org/kavis/Osd --method org.kavis.Osd.BrightnessDown</command>
      </action>
    </keybind>
    <keybind key="XF86AudioPlay">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Osd --object-path /org/kavis/Osd --method org.kavis.Osd.Media play</command>
      </action>
    </keybind>
    <keybind key="XF86AudioNext">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Osd --object-path /org/kavis/Osd --method org.kavis.Osd.Media next</command>
      </action>
    </keybind>
    <keybind key="XF86AudioPrev">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Osd --object-path /org/kavis/Osd --method org.kavis.Osd.Media prev</command>
      </action>
    </keybind>
    <!-- Ekran goruntusu (madde 29): PrtScr arac menusu, Ctrl+PrtScr
         sormadan hizli yakalama (ne yakalanacagi capture.conf'tan) -->
    <keybind key="Print">
      <action name="Execute">
        <command>kavis-tools capture</command>
      </action>
    </keybind>
    <keybind key="C-Print">
      <action name="Execute">
        <command>kavis-tools capture --quick</command>
      </action>
    </keybind>
    <!-- Renk secici (sonraki-isler 5c): dogrudan renk modu -->
    <keybind key="W-S-c">
      <action name="Execute">
        <command>kavis-tools capture --color</command>
      </action>
    </keybind>
EOF

# Win+sayı (sonraki-isler 2): soldan N. görev çubuğu yuvası —
# çalışmıyorsa başlat, çalışıyorsa odakla; Shift'liyle yeni pencere.
# W-0 onuncu yuva. 20 bağ elle yazmak yerine üretiliyor.
for n in 1 2 3 4 5 6 7 8 9 0; do
	cat >> "$SNIPPET" <<EOF2
    <keybind key="W-$n">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Panel --object-path /org/kavis/Panel --method org.kavis.Panel.ActivateSlot $n false</command>
      </action>
    </keybind>
    <keybind key="W-S-$n">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Panel --object-path /org/kavis/Panel --method org.kavis.Panel.ActivateSlot $n true</command>
      </action>
    </keybind>
EOF2
done

awk -v snippet="$SNIPPET" '
	/<\/keyboard>/ && !done {
		while ((getline line < snippet) > 0) print line
		close(snippet)
		done = 1
	}
	{ print }
' "$RC" > "$RC.yeni"
mv "$RC.yeni" "$RC"
rm -f "$SNIPPET"

if grep -q "Kavis kisayollari" "$RC"; then
	echo "I: pencere yerlestirme kisayollari rc.xml'e eklendi"
else
	echo "E: kisayollar rc.xml'e yazilamadi" >&2
	exit 1
fi

# rc.xml hala gecerli XML mi? Bozuk rc.xml openbox'i VARSAYILANLARLA
# baslatir ve hata sessizce yutulur.
if command -v python3 >/dev/null 2>&1; then
	python3 -c "import xml.dom.minidom, sys; xml.dom.minidom.parse('$RC')" || {
		echo "E: rc.xml artik gecerli XML degil" >&2
		exit 1
	}
fi
