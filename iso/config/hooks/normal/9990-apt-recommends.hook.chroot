#!/bin/sh
# Kavis — kurulu sistemde "Recommends" tekrar açılsın
#
# ISO derlenirken --apt-recommends false kullanıyoruz (hafiflik, prompt 20).
# Ama kullanıcı sisteme kurduktan sonra mağazadan bir program yüklediğinde
# tavsiye paketlerinin gelmesi gerekir; yoksa uygulamalar eksik çalışır
# (örn. VLC kodeksiz, GIMP eklentisiz gelir).
#
# Bu hook paket kurulumları BİTTİKTEN sonra çalışır, o yüzden ISO boyutunu
# etkilemez — sadece kurulu sistemin davranışını düzeltir.
set -e

cat > /etc/apt/apt.conf.d/99kavis-recommends <<'EOF'
// Kavis: ISO derlemesinde kapalı olan Recommends, kullanıcı sisteminde açık.
APT::Install-Recommends "true";
APT::Install-Suggests "false";
EOF

echo "I: /etc/apt/apt.conf.d/99kavis-recommends yazildi"
