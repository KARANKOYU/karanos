#!/bin/sh
# Kavis — turn "Recommends" back on for the installed system
#
# While building the ISO we use --apt-recommends false (lightness, prompt
# 20). But once the user has installed the system and installs a program
# from the store, the recommended packages must come along; otherwise
# applications work half-way (e.g. VLC without codecs, GIMP without
# plugins).
#
# This hook runs AFTER the package installations, so it does not affect
# the ISO size — it only fixes the behaviour of the installed system.
set -e

# --- Host guard (4 Sep 2026 incident) --------------------------------
# This hook edits the RUNNING system. On a developer machine that means
# the real /home, /etc, initramfs or systemd state — one stray run cost
# a whole Codespace (its user account and /home had to be rebuilt).
# live-build copies includes.chroot before the normal hooks, so the
# marker exists inside the build chroot and nowhere else.
if [ ! -f /usr/share/kavis/build-marker ]; then
	echo "E: $0 runs only inside the live-build chroot (marker missing)" >&2
	exit 1
fi

cat > /etc/apt/apt.conf.d/99kavis-recommends <<'EOF'
// Kavis: Recommends is off during the ISO build, on in the user's system.
APT::Install-Recommends "true";
APT::Install-Suggests "false";
EOF

echo "I: /etc/apt/apt.conf.d/99kavis-recommends written"
