#!/bin/sh
# Kavis — GRUB'a "Gelişmiş menü (F3)" alt menüsünü ekler (madde 30)
#
# 9600 (marka) hook'undan SONRA çalışır; girdiler o noktada Kavis adlı.
# HEDEF DOSYA grub.cfg — menü girdileri orada (config.cfg'de yalnız
# ayarlar var; ilk sürüm bunu yanlış bilip v0.2-test1'de boşa döndü).
#
# Yapılanlar:
#   1. live-build'in İngilizce "Utilities..." alt menüsü kaldırılır
#      (içindekiler bizim menüye tablodaki EN başlıklarla taşınır)
#   2. "güvenli mod" girdisi üst düzeyden alt menüye taşınır
#   3. "Detaylı açılış kayıtları" girdisi üretilir (quiet/splash'sız)
#   4. Açılış ortamı doğrulama girdisi (live-build üretmişse) tablodaki
#      başlıkla yeniden kurulur
#   5. memtest86+ girdileri (yalnız x86 — MİMARİ kuralı; BIOS'ta
#      linux16, UEFI'de chainloader, imzasız olduğu için Secure Boot
#      kapalıyken) ve UEFI ayarları girdisi eklenir
#
# Menü metinleri docs/kavis-arayuz-metinleri.md `boot.*` anahtarlarından
# (GRUB tek dilli; varsayılan dil EN — 2 Eyl 2026 kararı). Girdi başlıkları "ad — tek satır
# açıklama" biçiminde: GRUB girdi altına ayrı açıklama satırı çizemiyor.
#
# F3 kısayolu: trixie'nin GRUB 2.12'si submenu --hotkey=f3 destekliyor
# (grub-core/commands/menuentry.c hotkey_aliases tablosundan doğrulandı).
#
# HENÜZ OLMAYANLAR BİLEREK YOK: A/B önceki sürüm (27), snapshot listesi
# (26), kurtarma ortamı (33). Kural: var olmayan özelliğin girdisi olmaz.
#
# ÇALIŞMA DİZİNİ: binary hook'lar `binary/` dizininin İÇİNDE çalışır.
# Alt menü eklenemezse ISO normal girdiyle açılmaya devam eder; CI'daki
# önyükleyici doğrulaması eksikliği yakalar.

set -e

kok=""
for aday in boot/grub ../binary/boot/grub binary/boot/grub; do
	if [ -d "$aday" ]; then
		kok="$aday"
		break
	fi
done
if [ -z "$kok" ]; then
	echo "W: GRUB dizini bulunamadi, gelismis menu atlandi" >&2
	exit 0
fi

CFG="$kok/grub.cfg"
if [ ! -f "$CFG" ]; then
	echo "W: $CFG yok, gelismis menu atlandi" >&2
	exit 0
fi

# --- ürün adı ---------------------------------------------------------
AD=""
for osr in ../chroot/etc/os-release chroot/etc/os-release; do
	if [ -f "$osr" ]; then
		AD=$(sed -n 's/^NAME="\?\([^"]*\)"\?$/\1/p' "$osr" | head -1)
		break
	fi
done
[ -n "$AD" ] || AD="Linux"

# --- normal girdinin çekirdek satırları -------------------------------
# "güvenli mod" girdisi atlanır; kalan ilk menuentry normal olandır.
# Girinti korunur (blok içinde yeniden kullanılıyor).
normal_linux=$(awk '
	/^menuentry / { icinde = ($0 !~ /safe mode/) }
	icinde && /^[ \t]*linux/  { print; exit }
' "$CFG")
normal_initrd=$(awk '
	/^menuentry / { icinde = ($0 !~ /safe mode/) }
	icinde && /^[ \t]*initrd/ { print; exit }
' "$CFG")

if [ -z "$normal_linux" ] || [ -z "$normal_initrd" ]; then
	echo "W: grub.cfg icinde linux/initrd satiri bulunamadi, gelismis menu atlandi" >&2
	exit 0
fi

# --- güvenli mod bloğunu üst düzeyden al ------------------------------
guvenli_blok=$(awk '
	/^menuentry .*safe mode/ { al = 1 }
	al { print }
	al && /^\}/ { exit }
' "$CFG")

awk '
	/^menuentry .*safe mode/ { atla = 1 }
	!atla { print }
	atla && /^\}/ { atla = 0 }
' "$CFG" > "$CFG.yeni"
mv "$CFG.yeni" "$CFG"

# --- doğrulama girdisinin çekirdek satırları (varsa) ------------------
# live-build, checksums etkinse "Verify integrity of the boot medium"
# girdisini Utilities altına koyuyor; append'i (verify-checksums'lı)
# oradan alıp Türkçe başlıkla yeniden kuracağız.
dogrula_linux=$(awk '
	/menuentry "Verify integrity/ { al = 1 }
	al && /^[ \t]*linux/  { print; exit }
' "$CFG")
dogrula_initrd=$(awk '
	/menuentry "Verify integrity/ { al = 1 }
	al && /^[ \t]*initrd/ { print; exit }
' "$CFG")

# --- live-build'in Utilities alt menüsünü kaldır ----------------------
# İçeriği (fwsetup, verify) bizim Türkçe alt menümüze taşınıyor; iki
# alt menü hem kalabalık hem yarısı İngilizce olurdu.
if grep -q "^submenu 'Utilities" "$CFG"; then
	awk '
		/^submenu .Utilities/ { atla = 1 }
		!atla { print }
		atla && /^\}/ { atla = 0 }
	' "$CFG" > "$CFG.yeni"
	mv "$CFG.yeni" "$CFG"
	echo "I: Utilities alt menusu kaldirildi (icerik Turkce menuye tasindi)"
fi

# --- detaylı açılış: quiet/splash olmadan -----------------------------
detayli_linux=$(printf '%s\n' "$normal_linux" \
	| sed -e 's/ quiet//g' -e 's/ splash//g' \
	      -e 's/ plymouth\.ignore-serial-consoles//g')

# --- memtest86+ (yalnız x86 — MİMARİ kuralı) --------------------------
memtest_bin=0
memtest_efi=0
for c in ../chroot chroot; do
	[ -d "$c" ] || continue
	if [ -f "$c/boot/memtest86+x64.bin" ]; then
		cp "$c/boot/memtest86+x64.bin" "$kok/../memtest86+x64.bin"
		memtest_bin=1
	fi
	if [ -f "$c/boot/memtest86+x64.efi" ]; then
		cp "$c/boot/memtest86+x64.efi" "$kok/../memtest86+x64.efi"
		memtest_efi=1
	fi
	break
done

# --- alt menüyü yaz ---------------------------------------------------
{
	echo ""
	echo "### $AD — gelişmiş menü (F3) ###"
	echo "submenu \"Advanced menu (F3)\" --hotkey=f3 {"
	echo "	source /boot/grub/theme.cfg"

	if [ -n "$guvenli_blok" ]; then
		printf '%s\n' "$guvenli_blok" | sed 's/^/	/'
	fi

	echo "	menuentry \"Verbose boot — disable quiet boot\" {"
	printf '	%s\n' "$detayli_linux"
	printf '	%s\n' "$normal_initrd"
	echo "	}"

	if [ -n "$dogrula_linux" ] && [ -n "$dogrula_initrd" ]; then
		echo "	menuentry \"Verify integrity of the boot medium\" {"
		printf '	%s\n' "$dogrula_linux"
		printf '	%s\n' "$dogrula_initrd"
		echo "	}"
	fi

	if [ "$memtest_bin" -eq 1 ]; then
		echo "	if [ \"\$grub_platform\" = \"pc\" ]; then"
		echo "		menuentry \"RAM test (memtest86+)\" {"
		echo "			linux16 /boot/memtest86+x64.bin"
		echo "		}"
		echo "	fi"
	fi
	if [ "$memtest_efi" -eq 1 ]; then
		echo "	if [ \"\$grub_platform\" = \"efi\" ]; then"
		echo "		menuentry \"RAM test (memtest86+, requires Secure Boot off)\" {"
		echo "			chainloader /boot/memtest86+x64.efi"
		echo "		}"
		echo "	fi"
	fi

	echo "	if [ \"\$grub_platform\" = \"efi\" ]; then"
	echo "		menuentry \"Enter UEFI/BIOS setup\" {"
	echo "			fwsetup"
	echo "		}"
	echo "	fi"

	echo "}"
} >> "$CFG"

echo "I: gelismis menu eklendi (guvenli=$([ -n "$guvenli_blok" ] && echo 1 || echo 0) dogrula=$([ -n "$dogrula_linux" ] && echo 1 || echo 0) memtest_bios=$memtest_bin memtest_efi=$memtest_efi)"
grep -c '^menuentry\|^	menuentry\|^submenu' "$CFG" | sed 's/^/I: grub.cfg girdi sayisi: /'
