#!/bin/sh
# Kavis — add a countdown and a serial console to the GRUB menu
#
# WHY IT EXISTS:
# The boot/grub/config.cfg that live-build produces has NO `set timeout`
# LINE. With timeout undefined, the GRUB menu waits for a key forever. On
# a real machine the user presses Enter and never notices; but in an
# automated test (and with the "turn it on, walk away, come back, it has
# booted" expectation) the system sits in the menu. Exactly this happened
# in the first CI run: all three QEMU tests waited 25 minutes in the menu
# and timed out.
#
# Also, config.cfg says `terminal_output gfxterm` — GRUB output went only
# to the screen and nothing was written to the serial port. We add the
# serial console too, so that if it gets stuck again we can see the MENU
# in the CI log.
#
# WORKING DIRECTORY: live-build runs binary hooks INSIDE the `binary/`
# directory, not in the build root. On the first attempt I wrote the path
# as `binary/boot/...`, the hook could not find the file and stopped the
# build. Hence several candidate paths are tried below.

set -e

CFG=""
for candidate in \
	boot/grub/config.cfg \
	binary/boot/grub/config.cfg \
	../binary/boot/grub/config.cfg
do
	if [ -f "$candidate" ]; then
		CFG="$candidate"
		break
	fi
done

if [ -z "$CFG" ]; then
	echo "E: GRUB config.cfg not found." >&2
	echo "E: working directory: $(pwd)" >&2
	echo "E: contents here:" >&2
	ls -la >&2 || true
	echo "E: Without fixing this hook the ISO gets stuck in the menu; stopping the build." >&2
	exit 1
fi

echo "I: GRUB configuration found: $CFG"

cat >> "$CFG" <<'EOF'

### Kavis ###
# B1 (v0.4-test2): the menu is HIDDEN BY DEFAULT — boots straight through
# like Windows. If Shift is held (keystatus) the menu appears and waits;
# once shown, F3 opens the advanced submenu (9601). Fallback for some UEFI
# firmwares where keystatus does not work: ESC/F4 during the 1 s hidden
# countdown shows the menu. timeout=0 was not chosen: then there would be
# no ESC window either.
set default=0
if keystatus --shift; then
set timeout=-1
set timeout_style=menu
else
set timeout=1
set timeout_style=hidden
fi
# H3a (test8): GRUB's framebuffer is HANDED OVER to the kernel — no mode
# change, GRUB's last frame stays until Plymouth starts; the black screen
# between GRUB and the kernel goes away.
set gfxpayload=keep

# Send GRUB output to the serial port as well — so the QEMU test in CI
# can see the menu. On real hardware without a serial port the `serial`
# command fails, the block is skipped, and there is no effect.
if serial --unit=0 --speed=115200; then
	terminal_input  --append serial
	terminal_output --append serial
fi
EOF

if grep -q '^set timeout=1$' "$CFG" \
	&& grep -q '^set timeout_style=hidden$' "$CFG" \
	&& grep -q '^set gfxpayload=keep$' "$CFG"; then
	echo "I: GRUB menu hidden (timeout=1 hidden, menu with Shift), gfxpayload=keep and serial console added"
else
	echo "E: the write appears to have failed, no timeout inside $CFG" >&2
	exit 1
fi
