#!/bin/sh
# Kavis — GRUB menüsüne geri sayım ve seri konsol ekle
#
# NEDEN VAR:
# live-build'in ürettiği boot/grub/config.cfg dosyasında `set timeout`
# SATIRI YOK. GRUB'da timeout tanımsızsa menü sonsuza kadar tuş bekler.
# Gerçek makinede kullanıcı Enter'a basar ve fark edilmez; ama otomatik
# testte (ve "aç, git, gel, açılmış olsun" beklentisinde) sistem menüde
# takılı kalır. İlk CI koşusunda tam olarak bu oldu: üç QEMU testi de
# 25 dakika menüde bekleyip zaman aşımına uğradı.
#
# Ayrıca config.cfg `terminal_output gfxterm` diyor — yani GRUB çıktısı
# yalnızca ekrana gidiyor, seri porta hiçbir şey yazmıyordu. Seri konsolu
# da ekliyoruz ki bir daha takılırsa CI günlüğünde MENÜYÜ görebilelim.
#
# ÇALIŞMA DİZİNİ: live-build binary hook'ları `binary/` dizininin İÇİNDE
# çalıştırır, derleme kökünde değil. İlk denemede yolu `binary/boot/...`
# yazdığım için hook dosyayı bulamayıp derlemeyi durdurdu. Bu yüzden
# aşağıda birkaç aday yol deneniyor.

set -e

CFG=""
for candidate in \
	boot/grub/config.cfg \
	binary/boot/grub/config.cfg \
	../binary/boot/grub/config.cfg
do
	if [ -f "$candidate" ]; then
		CFG="$candidate"
		break
	fi
done

if [ -z "$CFG" ]; then
	echo "E: GRUB config.cfg bulunamadi." >&2
	echo "E: calisma dizini: $(pwd)" >&2
	echo "E: buradaki icerik:" >&2
	ls -la >&2 || true
	echo "E: Bu hook duzeltilmeden ISO menude takilir, derleme durduruluyor." >&2
	exit 1
fi

echo "I: GRUB yapilandirmasi bulundu: $CFG"

cat >> "$CFG" <<'EOF'

### Kavis ###
# Menü 10 saniye görünür, sonra ilk girdi (Live system) kendiliğinden açılır.
set default=0
set timeout=10
# H3a (test8): GRUB'un framebuffer'ı çekirdeğe DEVREDİLİR — mod
# değişimi olmaz, GRUB'un son karesi Plymouth başlayana kadar kalır;
# GRUB→çekirdek arasındaki siyah ekran kapanır.
set gfxpayload=keep
set timeout_style=menu

# GRUB çıktısını seri porta da ver — CI'daki QEMU testi menüyü görebilsin.
# Seri portu olmayan gerçek donanımda `serial` komutu başarısız olur ve
# blok atlanır, hiçbir etkisi olmaz.
if serial --unit=0 --speed=115200; then
	terminal_input  --append serial
	terminal_output --append serial
fi
EOF

if grep -q '^set timeout=10$' "$CFG" \
	&& grep -q '^set gfxpayload=keep$' "$CFG"; then
	echo "I: GRUB menusune timeout=10, gfxpayload=keep ve seri konsol eklendi"
else
	echo "E: yazma basarisiz gorunuyor, $CFG icinde timeout yok" >&2
	exit 1
fi
