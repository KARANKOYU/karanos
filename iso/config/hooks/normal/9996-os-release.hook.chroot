#!/bin/sh
# Kavis — restore /etc/os-release to kavis-theme's version
#
# WHY IT IS NEEDED:
# On Debian, /etc/os-release is a symbolic link to /usr/lib/os-release.
# The kavis-theme package takes over /usr/lib/os-release with dpkg-divert,
# so the link should lead to our file too.
#
# But at an early stage of the build live-build DELETES /etc/os-release
# and writes a REAL FILE in its place: Debian's content at that moment +
# IMAGE_ID and BUILD_ID lines. Since this happens before our package is
# installed, the resulting file said "Debian GNU/Linux 13" — the system
# thought it was Debian even though /usr/lib/os-release on the ISO was
# correct.
#
# Here we rewrite the file. The lines live-build added (IMAGE_ID /
# BUILD_ID) are preserved: they identify the build, they are not
# information we override.
#
# This hook must run after the 9990s and before the cleanup (9995); the
# name was chosen accordingly. Packages are installed BEFORE the chroot
# hooks, so /usr/lib/os-release is our file at this point.

set -e

ETC=/etc/os-release
LIB=/usr/lib/os-release

if [ ! -f "$LIB" ]; then
	echo "E: $LIB missing — is kavis-theme not installed?" >&2
	exit 1
fi

# The product name is not embedded in code (single source: the os-release
# in kavis-theme). The "is it our file" test is inverted: if the Debian
# identity is still there, dpkg-divert did not work.
if grep -q '^ID=debian$' "$LIB"; then
	echo "E: $LIB is still Debian's file, dpkg-divert did not work." >&2
	head -3 "$LIB" >&2
	exit 1
fi

# extract the lines live-build added itself
PRESERVED=""
if [ -f "$ETC" ]; then
	PRESERVED=$(grep -E '^(IMAGE_ID|IMAGE_VERSION|BUILD_ID)=' "$ETC" 2>/dev/null || true)
fi

{
	cat "$LIB"
	if [ -n "$PRESERVED" ]; then
		echo "$PRESERVED"
	fi
} > "$ETC.new"
mv "$ETC.new" "$ETC"
chmod 0644 "$ETC"

if ! grep -q '^ID=debian$' "$ETC"; then
	echo "I: /etc/os-release taken over"
	grep -E '^(PRETTY_NAME|ID|IMAGE_ID|BUILD_ID)=' "$ETC" | sed 's/^/I:   /'
else
	echo "E: could not write /etc/os-release" >&2
	exit 1
fi
