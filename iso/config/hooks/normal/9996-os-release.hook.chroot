#!/bin/sh
# Kavis — /etc/os-release'i kavis-theme'in sürümüne geri döndür
#
# NEDEN GEREKLİ:
# Debian'da /etc/os-release, /usr/lib/os-release'e giden bir sembolik
# bağdır. kavis-theme paketi /usr/lib/os-release'i dpkg-divert ile
# devralıyor, dolayısıyla bağ da bizim dosyamıza çıkmalı.
#
# Ama live-build derlemenin erken bir aşamasında /etc/os-release'i
# SİLİP yerine GERÇEK BİR DOSYA yazıyor: Debian'ın o anki içeriği +
# IMAGE_ID ve BUILD_ID satırları. Bu iş bizim paketimiz kurulmadan önce
# olduğu için ortaya çıkan dosyada "Debian GNU/Linux 13" yazıyordu —
# ISO'daki /usr/lib/os-release doğru olmasına rağmen sistem kendini
# Debian sanıyordu.
#
# Burada dosyayı yeniden yazıyoruz. live-build'in eklediği IMAGE_ID /
# BUILD_ID gibi satırlar korunuyor: bunlar derlemenin kimliği, bizim
# üstümüze aldığımız bilgi değil.
#
# Bu hook 9990'lardan sonra, temizlikten (9995) önce çalışmalı; adı
# ona göre seçildi. Paketler chroot hook'larından ÖNCE kurulduğu için
# /usr/lib/os-release bu noktada bizim dosyamız.

set -e

ETC=/etc/os-release
LIB=/usr/lib/os-release

if [ ! -f "$LIB" ]; then
	echo "E: $LIB yok — kavis-theme kurulmamis mi?" >&2
	exit 1
fi

# Ürün adı koda gömülü değil (tek kaynak: kavis-theme'deki os-release).
# "Bizim dosyamız mı" testi tersinden: Debian kimliği hâlâ duruyorsa
# dpkg-divert çalışmamış demektir.
if grep -q '^ID=debian$' "$LIB"; then
	echo "E: $LIB hâlâ Debian'ın dosyasi, dpkg-divert calismamis." >&2
	head -3 "$LIB" >&2
	exit 1
fi

# live-build'in kendi eklediği satırları ayıkla
KORUNAN=""
if [ -f "$ETC" ]; then
	KORUNAN=$(grep -E '^(IMAGE_ID|IMAGE_VERSION|BUILD_ID)=' "$ETC" 2>/dev/null || true)
fi

{
	cat "$LIB"
	if [ -n "$KORUNAN" ]; then
		echo "$KORUNAN"
	fi
} > "$ETC.yeni"
mv "$ETC.yeni" "$ETC"
chmod 0644 "$ETC"

if ! grep -q '^ID=debian$' "$ETC"; then
	echo "I: /etc/os-release devralindi"
	grep -E '^(PRETTY_NAME|ID|IMAGE_ID|BUILD_ID)=' "$ETC" | sed 's/^/I:   /'
else
	echo "E: /etc/os-release yazilamadi" >&2
	exit 1
fi
