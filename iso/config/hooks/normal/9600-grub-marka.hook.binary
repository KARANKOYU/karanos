#!/bin/sh
# Kavis — GRUB açılış menüsünü Kavis markasına çevir
#
# NEDEN VAR: menü hâlâ Debian markalıydı — "Debian GNU/Linux ... (trixie)"
# başlığı, Debian logosu ve Debian'ın kırmızı/gri renkleri. Kullanıcının
# gördüğü ilk ekran bu; dağıtımın kendi kimliğini taşımalı.
#
# ÇALIŞMA DİZİNİ: binary hook'lar `binary/` dizininin İÇİNDE çalışır.
# 9500 hook'unda bu bir kez ısırdı, aynı çoklu-yol yaklaşımı burada da.
#
# BU HOOK DERLEMEYİ DURDURMAZ. 9500 (timeout) durduruyor çünkü o olmadan
# ISO hiç açılmıyor. Marka ise kozmetik: bir dosya beklediğimiz yerde
# değilse uyarı yazıp devam ediyoruz, yoksa her live-build sürüm
# değişikliği derlemeyi kırar. Ne bulduğunu günlüğe yazıyor ki yapı
# değişirse bir sonraki koşuda görelim.

set -e

# Yeni koyu palet (bölüm 4). GRUB yalnızca 16 adlandırılmış renk
# tanıyor; turkuazın karşılığı "cyan", zeminin karşılığı "black".
# Tam altıgen değerler yalnızca tema dosyasında kullanılabiliyor.
RENK_NORMAL="light-gray/black"
RENK_SECILI="black/cyan"

# --- ürün adı: tek kaynaktan ------------------------------------------
# Menü girdilerine yazılacak ad koda gömülü değil; chroot'a kurulmuş
# os-release'ten okunuyor (kavis-theme paketi koyuyor). Okunamazsa
# kozmetik hook felsefesine uygun biçimde markasız devam ediyoruz.
AD=""
for osr in ../chroot/etc/os-release chroot/etc/os-release; do
	if [ -f "$osr" ]; then
		AD=$(sed -n 's/^NAME="\?\([^"]*\)"\?$/\1/p' "$osr" | head -1)
		break
	fi
done
if [ -z "$AD" ]; then
	echo "W: os-release'ten urun adi okunamadi, marka atlandi" >&2
	exit 0
fi
echo "I: urun adi (os-release): $AD"

kok=""
for aday in boot/grub ../binary/boot/grub binary/boot/grub; do
	if [ -d "$aday" ]; then
		kok="$aday"
		break
	fi
done

if [ -z "$kok" ]; then
	echo "W: GRUB dizini bulunamadi, marka atlandi (calisma dizini: $(pwd))" >&2
	exit 0
fi

echo "I: GRUB dizini: $kok"
echo "I: icerigi:"
ls -1 "$kok" | sed 's/^/I:   /'

CFG="$kok/config.cfg"
if [ ! -f "$CFG" ]; then
	echo "W: $CFG yok, marka atlandi" >&2
	exit 0
fi

# --- menü girdilerinin adları ----------------------------------------
# live-build "Live system (amd64)" gibi adlar üretiyor. Kullanıcı ürün
# adını görmeli. Sed yerine tek tek eşleme: beklenmedik bir ad gelirse
# sessizce bozmak yerine olduğu gibi bırakıyoruz.
sed -i \
	-e "s|menuentry \"Live system (\([^)]*\) fail-safe mode)\"|menuentry \"$AD (güvenli mod, \1)\"|" \
	-e "s|menuentry \"Live system (\([^)]*\))\"|menuentry \"$AD (\1)\"|" \
	-e "s|menuentry \"Debian GNU/Linux[^\"]*\"|menuentry \"$AD\"|" \
	"$CFG"

# --- renkler ve başlık ------------------------------------------------
cat >> "$CFG" <<EOF

### $AD — marka ###
set color_normal=${RENK_NORMAL}
set color_highlight=${RENK_SECILI}
set menu_color_normal=${RENK_NORMAL}
set menu_color_highlight=${RENK_SECILI}
EOF

# --- arka plan --------------------------------------------------------
# Kural (madde 1): GRUB'da HER ZAMAN koyu logo. kavis-theme derlemesi
# koyu-k-logo'dan düz zeminli bir arka plan üretiyor; onu kopyalıyoruz.
arka=""
for aday in \
	../chroot/usr/share/kavis/logo/grub-arkaplan.png \
	chroot/usr/share/kavis/logo/grub-arkaplan.png
do
	if [ -f "$aday" ]; then
		arka="$aday"
		break
	fi
done

if [ -n "$arka" ]; then
	cp "$arka" "$kok/kavis-arkaplan.png"
	cat >> "$CFG" <<'EOF'
# GRUB'un png modulu yoksa bu satir sessizce basarisiz olur ve menu duz
# renk zeminde gorunur — okunurlugu bozmaz.
if background_image /boot/grub/kavis-arkaplan.png; then
	true
fi
EOF
	echo "I: GRUB arka plani kondu ($arka)"
else
	echo "W: grub-arkaplan.png bulunamadi, GRUB arka plani duz renk kalacak" >&2
fi

# --- Debian markalı kalıntılar ---------------------------------------
# desktop-base'ten gelen Debian logosu/arka planı varsa kaldır.
for artik in "$kok/splash.png" "$kok/debian.png" "$kok/themes/debian"; do
	if [ -e "$artik" ]; then
		rm -rf "$artik"
		echo "I: Debian markali dosya kaldirildi: $artik"
	fi
done

echo "I: GRUB menusu $AD markasina cevrildi"
grep -c "menuentry \"$AD" "$CFG" | sed 's/^/I: marka girdisi sayisi: /'
