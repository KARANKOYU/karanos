#!/bin/sh
# Kavis — GRUB açılış menüsünü Kavis markasına çevir
#
# NEDEN VAR: menü Debian/live-build markalıydı — "Live system (amd64)"
# girdileri, "Live Boot Menu with GRUB" başlığı, Debian'ın splash'i.
# Kullanıcının gördüğü ilk ekran bu; dağıtımın kimliğini taşımalı.
#
# GERÇEK YERLEŞİM (v0.2-test1 koşusunda öğrenildi — ilk sürüm yanlış
# dosyayı hedefliyordu):
#   - Menü GİRDİLERİ grub.cfg VE loopback.cfg içinde (config.cfg'de
#     DEĞİL; orada yalnız ayarlar var).
#   - Görsel tema live-theme/theme.txt (gfxmenu) — ama YALNIZ
#     /boot/grub/splash.png varken etkin (theme.cfg'deki koşul). İlk
#     sürüm splash.png'yi "Debian kalıntısı" diye silip temayı istemeden
#     kapatıyordu; doğrusu ÜZERİNE kendi arka planımızı yazmak.
#
# ÇALIŞMA DİZİNİ: binary hook'lar `binary/` dizininin İÇİNDE çalışır.
#
# BU HOOK DERLEMEYİ DURDURMAZ (kozmetik) ama CI'daki "ISO içi
# önyükleyici doğrulaması" adımı sonucu grub.cfg üzerinden denetler —
# sessiz başarısızlık artık orada yakalanır.

set -e

# --- ürün adı: tek kaynaktan ------------------------------------------
AD=""
for osr in ../chroot/etc/os-release chroot/etc/os-release; do
	if [ -f "$osr" ]; then
		AD=$(sed -n 's/^NAME="\?\([^"]*\)"\?$/\1/p' "$osr" | head -1)
		break
	fi
done
if [ -z "$AD" ]; then
	echo "W: os-release'ten urun adi okunamadi, marka atlandi" >&2
	exit 0
fi
echo "I: urun adi (os-release): $AD"

kok=""
for aday in boot/grub ../binary/boot/grub binary/boot/grub; do
	if [ -d "$aday" ]; then
		kok="$aday"
		break
	fi
done
if [ -z "$kok" ]; then
	echo "W: GRUB dizini bulunamadi, marka atlandi (calisma dizini: $(pwd))" >&2
	exit 0
fi
echo "I: GRUB dizini: $kok"

# --- menü girdilerinin adları -----------------------------------------
# Girdiler hem grub.cfg'de hem loopback.cfg'de (live-build ikisine de
# basıyor). Sed yerine tek tek eşleme: beklenmedik bir ad gelirse
# sessizce bozmak yerine olduğu gibi bırakıyoruz.
for cfg in "$kok/grub.cfg" "$kok/loopback.cfg"; do
	[ -f "$cfg" ] || continue
	sed -i \
		-e "s|menuentry \"Live system (\([^)]*\) fail-safe mode)\"|menuentry \"$AD (güvenli mod, \1)\"|" \
		-e "s|menuentry \"Live system (\([^)]*\))\"|menuentry \"$AD (\1)\"|" \
		-e "s|menuentry \"Live system, kernel \([^\"]*\)\"|menuentry \"$AD (çekirdek \1)\"|" \
		-e "s|menuentry \"Debian GNU/Linux[^\"]*\"|menuentry \"$AD\"|" \
		"$cfg"
	adet=$(grep -c "menuentry \"$AD" "$cfg" || true)
	echo "I: $(basename "$cfg"): $adet girdi markalandi"
done

# --- arka plan: gfxmenu temasının splash.png'si -----------------------
# Kural (madde 1): GRUB'da HER ZAMAN koyu logo. kavis-theme derlemesi
# koyu-k-logo'dan düz zeminli arka plan üretiyor; live-build temasının
# beklediği ada (splash.png) yazıyoruz — tema etkin kalıyor.
arka=""
for aday in \
	../chroot/usr/share/kavis/logo/grub-arkaplan.png \
	chroot/usr/share/kavis/logo/grub-arkaplan.png
do
	if [ -f "$aday" ]; then
		arka="$aday"
		break
	fi
done
if [ -n "$arka" ]; then
	cp "$arka" "$kok/splash.png"
	echo "I: GRUB arka plani (splash.png) kondu ($arka)"
else
	echo "W: grub-arkaplan.png bulunamadi, live-build splash'i kaldi" >&2
fi

# --- gfxmenu temasını Kavis paletine çek ------------------------------
TEMA="$kok/live-theme/theme.txt"
if [ -f "$TEMA" ]; then
	sed -i \
		-e "s|^title-text: .*|title-text: \"$AD\"|" \
		-e "s|^title-color: .*|title-color: \"#E6EDF3\"|" \
		-e "s|item_color = \"[^\"]*\"|item_color = \"#8B9BA8\"|" \
		-e "s|selected_item_color= \"[^\"]*\"|selected_item_color= \"#2DD4BF\"|" \
		"$TEMA"
	echo "I: gfxmenu temasi Kavis paletine cevrildi"

	# --- geri sayım: gri kutu yerine sade satır (İş 3) ----------------
	# live-build teması geri sayımı `progress_bar { id = "__timeout__" }`
	# ile çiziyor: gri zeminli bir kutu + İngilizce "The highlighted
	# entry will be executed automatically in %ds". Koyu temanın ortasında
	# sırıtıyor. GRUB'da id'si __timeout__ olan HERHANGİ bir bileşen
	# varsayılan geri sayım kutusunu devre dışı bırakır ve `text`
	# özelliğindeki %d her saniye kalan süreyle basılır — kutu yerine
	# ikincil metin renginde tek satır yazıyoruz. Metin tablodan:
	# boot.autoboot_countdown (docs/kavis-arayuz-metinleri.md). Unifont
	# Türkçe glifleri içeriyor (menü girdilerinde zaten kullanılıyor).
	# progress_bar temadaki SON blok; oradan dosya sonuna kadar siliyoruz.
	sed -i '/^#progress bar$/,$d' "$TEMA"
	cat >> "$TEMA" <<'EOF'
#geri sayim (Kavis)
+ label {
	id = "__timeout__"
	left = 0
	width = 100%
	top = 100%-80
	height = 20
	align = "center"
	color = "#8B9BA8"
	font = "Unifont Regular 16"
	text = "%d saniye içinde otomatik başlıyor"
}
EOF
	if grep -q '__timeout__' "$TEMA" && ! grep -q 'progress_bar' "$TEMA"; then
		echo "I: geri sayim kutusu sade Turkce satira cevrildi"
	else
		echo "W: geri sayim degisikligi dogrulanamadi" >&2
	fi
else
	echo "W: live-theme/theme.txt yok, tema paleti atlandi" >&2
fi

# --- metin kipi yedeği (tema yüklenemezse) ----------------------------
# theme.cfg splash.png yoksa/tema kurulamazsa metin renklerine düşüyor;
# oradaki cyan/blue yerine paletimiz geçerli olsun diye config.cfg'nin
# SONUNA yazıyoruz (config.cfg theme.cfg'yi kaynakladıktan sonra
# okunmaya devam ediyor, son yazan kazanıyor).
CFG="$kok/config.cfg"
if [ -f "$CFG" ]; then
	cat >> "$CFG" <<EOF

### $AD — metin kipi renkleri (gfxmenu yedegi) ###
set color_normal=light-gray/black
set color_highlight=black/cyan
set menu_color_normal=light-gray/black
set menu_color_highlight=black/cyan
EOF
fi

echo "I: GRUB menusu $AD markasina cevrildi"
