#!/bin/sh
# Kavis — enable our own systemd services
set -e

chmod 0755 /usr/lib/kavis/boot-check
# The live-config component must be executable; includes.chroot
# permissions are not preserved in every environment, so make sure.
chmod 0755 /usr/lib/live/config/0031-kavis-dirs

systemctl enable kavis-boot-check.service

echo "I: kavis services enabled"
