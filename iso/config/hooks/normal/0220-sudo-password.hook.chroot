#!/bin/sh
# Kavis — sudo password asterisks (test8 E1)
#
# A user coming from Windows thinks the terminal is "frozen" when nothing
# shows while typing the password; pwfeedback prints * per character.
# The sudoers.d file must be 0440 and root-owned; syntax is verified with
# visudo -c — a broken file locks sudo out.

set -e

# --- Host guard (4 Sep 2026 incident) --------------------------------
# This hook edits the RUNNING system. On a developer machine that means
# the real /home, /etc, initramfs or systemd state — one stray run cost
# a whole Codespace (its user account and /home had to be rebuilt).
# live-build copies includes.chroot before the normal hooks, so the
# marker exists inside the build chroot and nowhere else.
if [ ! -f /usr/share/kavis/build-marker ]; then
	echo "E: $0 runs only inside the live-build chroot (marker missing)" >&2
	exit 1
fi

FILE=/etc/sudoers.d/kavis
printf '# Kavis: show asterisks while typing the password (test8 E1)\nDefaults pwfeedback\n' > "$FILE"
chmod 0440 "$FILE"
chown root:root "$FILE"

if command -v visudo >/dev/null 2>&1; then
	visudo -cf "$FILE" >/dev/null || {
		echo "E: sudoers.d/kavis is invalid" >&2
		rm -f "$FILE"
		exit 1
	}
fi
echo "I: sudo pwfeedback enabled"
