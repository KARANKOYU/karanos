#!/bin/sh
# Kavis — global shortcut infrastructure (item 6)
#
# WHY A HOOK: same reason as 0200 — Debian's rc.xml is not replaced
# wholesale (the mouse section and default bindings would be lost); only
# the Kavis block is injected before the </keyboard> closing tag. The
# shortcuts live in ONE place (this block); Settings (Group F, item 29E)
# will edit the same block.
#
# Window placement (Windows equivalents):
#   Win+Left/Right : half screen left/right (unmaximize first —
#                    MoveResizeTo does nothing on a maximized window)
#   Win+Up         : maximize
#   Win+Down       : restore if maximized, otherwise iconify
#   Alt+Tab        : Debian default already exists, untouched
#   Ctrl+Alt+arrow : desktop switching — in the Debian default
# Snap-by-dragging-to-edge is not the keyboard's job: the kavis-snap
# daemon does it (kavis-panel package).

set -e

# --- Host guard (4 Sep 2026 incident) --------------------------------
# This hook edits the RUNNING system. On a developer machine that means
# the real /home, /etc, initramfs or systemd state — one stray run cost
# a whole Codespace (its user account and /home had to be rebuilt).
# live-build copies includes.chroot before the normal hooks, so the
# marker exists inside the build chroot and nowhere else.
if [ ! -f /usr/share/kavis/build-marker ]; then
	echo "E: $0 runs only inside the live-build chroot (marker missing)" >&2
	exit 1
fi

RC=/etc/xdg/openbox/rc.xml

if [ ! -f "$RC" ]; then
	echo "E: $RC missing — is openbox installed?" >&2
	exit 1
fi

if grep -q "Kavis keybindings" "$RC"; then
	echo "I: keybindings already added"
	exit 0
fi

# --- removed from the Debian defaults (test8 I1/I2/I3/I5) -------------
# Debian's own rc.xml bindings were running TOGETHER with ours (openbox
# runs every binding of the same key):
#   I1: A-F4 Close + our alt-f4 → after the window closed the tool saw
#       "no focused window" and opened the shutdown dialog.
#   I2: Print/A-Print → scrot (not installed, error box) + our tool.
#   I3: In Desktop/Root/MoveResize the wheel switched desktops, on Root
#       middle click opened the client list and right click the openbox
#       root menu (desktop right click is nemo-desktop's job).
#   I5: Titlebar Drag was only Move — a maximized window could not be
#       dragged; Windows behaviour: Unmaximize first (no effect on a
#       normal window).
awk '
	# skip mode comes before every rule: wait for the end of the block
	skip == 1 {
		if ($0 ~ end_tag) skip = 0
		next
	}
	/<context name="/ {
		q = index($0, "name=\"") + 6
		rest = substr($0, q)
		ctx = substr(rest, 1, index(rest, "\"") - 1)
	}
	/<\/context>/ { ctx = "" }
	/<keybind key="A-F4">/ || /<keybind key="Print">/ || /<keybind key="A-Print">/ {
		skip = 1; end_tag = "</keybind>"; next
	}
	(ctx == "Desktop" || ctx == "Root" || ctx == "MoveResize") \
		&& /<mousebind button="([CA]-)*(Up|Down)" action="Click">/ {
		skip = 1; end_tag = "</mousebind>"; next
	}
	ctx == "Root" && /<mousebind button="(Middle|Right)" action="Press">/ {
		skip = 1; end_tag = "</mousebind>"; next
	}
	ctx == "Titlebar" && /<mousebind button="Left" action="Drag">/ {
		# C3 (v0.4-test1): on a maximized window openbox does NOTHING —
		# kavis-snap takes over the drag (restores and puts the window
		# under the pointer, W11). Move on a normal window.
		print "    <mousebind button=\"Left\" action=\"Drag\">"
		print "      <action name=\"If\">"
		print "        <maximized>yes</maximized>"
		print "        <then/>"
		print "        <else><action name=\"Move\"/></else>"
		print "      </action>"
		print "    </mousebind>"
		skip = 1; end_tag = "</mousebind>"; next
	}
	# C4: the stock W-e (Debian: terminal/file manager) would run
	# TOGETHER with our W-e (lesson I1) — remove it.
	/<keybind key="W-e">/ {
		skip = 1; end_tag = "</keybind>"; next
	}
	{ print }
' "$RC" > "$RC.clean"
mv "$RC.clean" "$RC"

# (the word scrot may remain in comment lines — look at the real binding)
if grep -q "<command>scrot" "$RC"; then
	echo "E: scrot bindings are still there" >&2
	exit 1
fi
echo "I: Debian default bindings cleaned (A-F4, Print, wheel, root menus; Drag=Unmaximize+Move)"

# 2A: openbox must NOT switch desktops when a window is dragged to an
# edge — it was shadowing kavis-snap's edge snapping (left/right = half,
# top = maximize). 0 = off.
sed -i 's|<screenEdgeWarpTime>[0-9]*</screenEdgeWarpTime>|<screenEdgeWarpTime>0</screenEdgeWarpTime>|' "$RC"
if ! grep -q "<screenEdgeWarpTime>0</screenEdgeWarpTime>" "$RC"; then
	echo "E: could not disable screenEdgeWarpTime" >&2
	exit 1
fi
echo "I: desktop switching on edge drag disabled (screenEdgeWarpTime=0)"

SNIPPET=$(mktemp)
cat > "$SNIPPET" <<'EOF'
    <!-- Kavis keybindings (item 6) — added by the 0210 hook -->
    <keybind key="W-Left">
      <action name="Unmaximize"/>
      <action name="MoveResizeTo">
        <x>0</x><y>0</y><width>50%</width><height>100%</height>
      </action>
    </keybind>
    <keybind key="W-Right">
      <action name="Unmaximize"/>
      <action name="MoveResizeTo">
        <x>-0</x><y>0</y><width>50%</width><height>100%</height>
      </action>
    </keybind>
    <keybind key="W-Up">
      <action name="Maximize"/>
    </keybind>
    <keybind key="W-Down">
      <action name="If">
        <maximized>yes</maximized>
        <then><action name="Unmaximize"/></then>
        <else><action name="Iconify"/></else>
      </action>
    </keybind>
    <!-- Overview (item 55): told to the running panel over DBus -->
    <keybind key="W-Tab">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Panel --object-path /org/kavis/Panel --method org.kavis.Panel.ShowOverview</command>
      </action>
    </keybind>
    <!-- Snap layout menu (next-tasks 4) -->
    <keybind key="W-z">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Panel --object-path /org/kavis/Panel --method org.kavis.Panel.ShowSnapMenu</command>
      </action>
    </keybind>
    <!-- Clipboard history (item 7) — now the unified panel's clipboard tab -->
    <keybind key="W-v">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Panel --object-path /org/kavis/Panel --method org.kavis.Panel.ShowClipboard</command>
      </action>
    </keybind>
    <!-- Emoji and more (next-tasks 5): last used tab -->
    <keybind key="W-period">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Panel --object-path /org/kavis/Panel --method org.kavis.Panel.ShowPicker last</command>
      </action>
    </keybind>
    <!-- Volume/brightness/media keys -> kavis-osd (next-tasks 6a):
         separate process from the panel, works even if the panel crashes -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Osd --object-path /org/kavis/Osd --method org.kavis.Osd.VolumeUp</command>
      </action>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Osd --object-path /org/kavis/Osd --method org.kavis.Osd.VolumeDown</command>
      </action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Osd --object-path /org/kavis/Osd --method org.kavis.Osd.VolumeMute</command>
      </action>
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Osd --object-path /org/kavis/Osd --method org.kavis.Osd.BrightnessUp</command>
      </action>
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Osd --object-path /org/kavis/Osd --method org.kavis.Osd.BrightnessDown</command>
      </action>
    </keybind>
    <keybind key="XF86AudioPlay">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Osd --object-path /org/kavis/Osd --method org.kavis.Osd.Media play</command>
      </action>
    </keybind>
    <keybind key="XF86AudioNext">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Osd --object-path /org/kavis/Osd --method org.kavis.Osd.Media next</command>
      </action>
    </keybind>
    <keybind key="XF86AudioPrev">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Osd --object-path /org/kavis/Osd --method org.kavis.Osd.Media prev</command>
      </action>
    </keybind>
    <!-- Screenshot (item 29): PrtScr tool menu, Ctrl+PrtScr quick
         capture without asking (what to capture comes from capture.conf) -->
    <keybind key="Print">
      <action name="Execute">
        <command>kavis-tools capture</command>
      </action>
    </keybind>
    <keybind key="C-Print">
      <action name="Execute">
        <command>kavis-tools capture --quick</command>
      </action>
    </keybind>
    <!-- Alt+F4 on the desktop (6e): close the window if there is one,
         otherwise the shutdown dialog. Same WM_DELETE path when windowed. -->
    <keybind key="A-F4">
      <action name="Execute">
        <command>kavis-tools alt-f4</command>
      </action>
    </keybind>
    <!-- Ctrl+Alt+Del screen (next-tasks 6d): independent of the panel -->
    <keybind key="C-A-Delete">
      <action name="Execute">
        <command>kavis-tools secure-menu</command>
      </action>
    </keybind>
    <!-- Ctrl+Shift+Esc (feedback G1): Windows' task manager shortcut -->
    <keybind key="C-S-Escape">
      <action name="Execute">
        <command>kavis-taskmanager</command>
      </action>
    </keybind>
    <!-- Color picker (next-tasks 5c): direct color mode -->
    <keybind key="W-S-c">
      <action name="Execute">
        <command>kavis-tools capture --color</command>
      </action>
    </keybind>
    <!-- C4 (v0.4-test1): Windows equivalents. Win alone: xcape turns a
         Super_L tap into XF86Launch5 (autostart), XF86Launch5 opens the
         start menu; Win+letter shortcuts see Super as a modifier, xcape
         leaves those alone. -->
    <keybind key="XF86Launch5">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Panel --object-path /org/kavis/Panel --method org.kavis.Panel.ShowStartMenu false</command>
      </action>
    </keybind>
    <!-- Ctrl+Esc: Windows' old shortcut; also reaches the start menu when
         the VirtualBox host captures Win. -->
    <keybind key="C-Escape">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Panel --object-path /org/kavis/Panel --method org.kavis.Panel.ShowStartMenu false</command>
      </action>
    </keybind>
    <keybind key="W-r">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Panel --object-path /org/kavis/Panel --method org.kavis.Panel.ShowStartMenu true</command>
      </action>
    </keybind>
    <keybind key="W-e">
      <action name="Execute">
        <command>nemo</command>
      </action>
    </keybind>
    <keybind key="W-i">
      <action name="Execute">
        <command>kavis-settings</command>
      </action>
    </keybind>
    <keybind key="W-S-s">
      <action name="Execute">
        <command>kavis-tools capture</command>
      </action>
    </keybind>
EOF

# Win+number (next-tasks 2): Nth taskbar slot from the left — launch if
# not running, focus if running; with Shift a new window. W-0 is the
# tenth slot. Generated instead of writing 20 bindings by hand.
for n in 1 2 3 4 5 6 7 8 9 0; do
	cat >> "$SNIPPET" <<EOF2
    <keybind key="W-$n">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Panel --object-path /org/kavis/Panel --method org.kavis.Panel.ActivateSlot $n false</command>
      </action>
    </keybind>
    <keybind key="W-S-$n">
      <action name="Execute">
        <command>gdbus call --session --dest org.kavis.Panel --object-path /org/kavis/Panel --method org.kavis.Panel.ActivateSlot $n true</command>
      </action>
    </keybind>
EOF2
done

awk -v snippet="$SNIPPET" '
	/<\/keyboard>/ && !done {
		while ((getline line < snippet) > 0) print line
		close(snippet)
		done = 1
	}
	{ print }
' "$RC" > "$RC.new"
mv "$RC.new" "$RC"
rm -f "$SNIPPET"

if grep -q "Kavis keybindings" "$RC"; then
	echo "I: window placement keybindings added to rc.xml"
else
	echo "E: could not write the keybindings into rc.xml" >&2
	exit 1
fi

# Is rc.xml still valid XML? A broken rc.xml starts openbox with the
# DEFAULTS and the error is swallowed silently.
if command -v python3 >/dev/null 2>&1; then
	python3 -c "import xml.dom.minidom, sys; xml.dom.minidom.parse('$RC')" || {
		echo "E: rc.xml is no longer valid XML" >&2
		exit 1
	}
fi
