[Unit]
Description=Kavis boot check (CI smoke test)
Documentation=https://github.com/KARANKOYU/karanos
After=graphical.target
# Runs only in the live (USB/ISO) session — not on the installed system.
ConditionPathExists=/run/live/medium

[Service]
Type=oneshot
RemainAfterExit=yes
# Waits at most 120 seconds for the X server to really come up and
# writes the result to the serial console. The QEMU test on GitHub
# Actions looks for that line.
ExecStart=/usr/lib/kavis/boot-check
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=graphical.target
