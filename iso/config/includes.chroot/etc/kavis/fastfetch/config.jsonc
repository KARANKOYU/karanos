// Kavis — fastfetch configuration (item 71).
//
// The product name is NOT written here: the "os" module reads
// /etc/os-release, which is the single source of the identity (brand
// rule). Renaming the distribution changes os-release and this file
// keeps working.
//
// The logo is the K mark in the accent colour. `kavisfetch` passes the
// colour for the active theme; plain `fastfetch` gets this file through
// /etc/fastfetch/config.jsonc and uses the default below.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/etc/kavis/fastfetch/logo.txt",
        "color": { "1": "38;2;45;212;191" },
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;45;212;191" }
    },
    "modules": [
        "title",
        "separator",
        { "type": "os", "key": "OS" },
        { "type": "host", "key": "Host" },
        { "type": "kernel", "key": "Kernel" },
        { "type": "uptime", "key": "Uptime" },
        { "type": "packages", "key": "Packages" },
        { "type": "shell", "key": "Shell" },
        { "type": "display", "key": "Display" },
        // The desktop is ours on top of openbox; fastfetch would
        // otherwise report "Openbox", which is the window manager and
        // not what the user is looking at.
        { "type": "custom", "key": "DE", "format": "Kavis (Openbox)" },
        { "type": "theme", "key": "Theme" },
        { "type": "icons", "key": "Icons" },
        { "type": "font", "key": "Font" },
        { "type": "terminal", "key": "Terminal" },
        { "type": "cpu", "key": "CPU" },
        { "type": "gpu", "key": "GPU" },
        { "type": "memory", "key": "Memory" },
        { "type": "swap", "key": "Swap" },
        { "type": "disk", "key": "Disk" },
        "break",
        "colors"
    ]
}
