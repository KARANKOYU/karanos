# Kavis — Openbox session startup

# --- Wallpaper -------------------------------------------------------
# Comes from the kavis-theme package. If the package is absent (bare
# ISO) we fall back to a flat color so the screen still says "it's up".
# xsettings: theme/icons/scale from a single source, live (item 38).
# Settings writes this file and sends SIGHUP; generate a default on the
# first start.
XS_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/xsettingsd/xsettingsd.conf"
if command -v xsettingsd >/dev/null 2>&1; then
	if [ ! -f "$XS_CONF" ]; then
		mkdir -p "$(dirname "$XS_CONF")"
		printf 'Net/ThemeName "Kavis"\nNet/IconThemeName "Kavis"\nGtk/FontName "DejaVu Sans 10"\n' > "$XS_CONF"
	fi
	xsettingsd -c "$XS_CONF" &
fi

if command -v xwallpaper >/dev/null 2>&1 &&
	[ -f /usr/share/backgrounds/kavis/kavis.png ]; then
	# The wallpaper chosen in Settings > Appearance is in kavis.conf;
	# otherwise the default (a light grep for the shell — no keyfile
	# parsing).
	WALLPAPER=$(grep -m1 '^wallpaper=' "${XDG_CONFIG_HOME:-$HOME/.config}/kavis/kavis.conf" 2>/dev/null | cut -d= -f2-)
	[ -f "$WALLPAPER" ] || WALLPAPER=/usr/share/backgrounds/kavis/kavis.png
	xwallpaper --zoom "$WALLPAPER" &
else
	xsetroot -solid "#0D141B" &
fi

# --- Cursor ----------------------------------------------------------
# Unless the cursor on the root window is set separately, X's thick cross
# cursor stays on the empty desktop area and the theme cursor shows only
# in windows.
xsetroot -cursor_name left_ptr &

# --- Compositor ------------------------------------------------------
# For shadows and rounded corners. Starts BEFORE the panel: at startup
# the panel checks whether compositing exists and draws the power menu
# accordingly. The xrender backend needs no 3D.
if command -v picom >/dev/null 2>&1; then
	# When Settings > Appearance changes corners/animation it writes a
	# user copy (picom knows no live reload) — use that if present.
	PICOM_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/kavis/picom.conf"
	[ -f "$PICOM_CONF" ] || PICOM_CONF=/etc/xdg/picom-kavis.conf
	picom --backend xrender --config "$PICOM_CONF" &
	# A short margin so the panel can see the compositing.
	sleep 1
fi

# --- Taskbar and start menu (stage 4) --------------------------------
# WHY WE LOG: on the first try the panel crashed in the live environment
# and, since its output went nowhere, the reason was invisible — the
# smoke test could only say "not running". Now the error text stays here
# and boot-check dumps it to the serial console.
#
# WHY WE RETRY: the panel connects to the window manager through Wnck;
# when openbox runs the autostart it is sometimes not fully ready yet.
# Three attempts, one second apart.
KAVIS_PANEL_LOG="${XDG_RUNTIME_DIR:-/tmp}/kavis-panel.log"
export KAVIS_PANEL_LOG

if command -v kavis-panel >/dev/null 2>&1; then
	(
		attempt=1
		while [ "$attempt" -le 3 ]; do
			echo "--- kavis-panel attempt $attempt ---" >>"$KAVIS_PANEL_LOG"
			kavis-panel >>"$KAVIS_PANEL_LOG" 2>&1 && exit 0
			echo "--- panel exited (code $?), retrying ---" \
				>>"$KAVIS_PANEL_LOG"
			attempt=$((attempt + 1))
			sleep 1
		done
	) &
fi

# --- Win key (C4) ----------------------------------------------------
# A lone Super_L tap → XF86Launch5 (rc.xml: start menu). Chords (Win+E...)
# are unaffected; -t 300: a press longer than 300 ms does not count as a
# tap.
if command -v xcape >/dev/null 2>&1; then
	xcape -t 300 -e 'Super_L=XF86Launch5' &
fi

# --- Edge snapping (item 6) ------------------------------------------
# Drag-to-edge snapping; keyboard shortcuts are openbox's own job (0210
# hook). Comes from the same package as the panel.
if command -v kavis-snap >/dev/null 2>&1; then
	kavis-snap &
fi

# Volume/brightness/lock/media OSD (next-tasks 6a) — separate from the panel
if command -v kavis-osd >/dev/null 2>&1; then
	kavis-osd &
fi

# Touchpad gestures (next-tasks 6g): starts if there IS a touchpad,
# never starts otherwise. libinput-gestures/touchegg are not in trixie,
# hence our own thin reader (/usr/lib/kavis/kavis-gestures).
# Settings > Touchpad on/off is a Group F note.
if [ -x /usr/lib/kavis/kavis-gestures ] \
	&& grep -qi touchpad /proc/bus/input/devices 2>/dev/null; then
	/usr/lib/kavis/kavis-gestures &
fi

# Polkit session agent (item 39 "open as administrator" + item 64
# repair): this agent draws the pkexec password dialog; without it NO
# desktop operation that needs privileges works.
if command -v lxpolkit >/dev/null 2>&1; then
	lxpolkit &
fi

# --- Desktop icons (item 6) ------------------------------------------
# nemo-desktop draws only the icon layer (the file manager itself is
# configured in Group E). GDK_GL=disable: the llvmpipe trap (item 61) —
# nemo is not our binary so it cannot use the shared startup; the
# environment variable is given from here.
if command -v nemo-desktop >/dev/null 2>&1; then
	GDK_GL=disable nemo-desktop &
fi
# C5: root window cursor once more AFTER nemo-desktop has opened — the
# desktop layer takes over the root cursor; if it was set early and the
# theme came late, the I-beam/cross stayed stuck. XCURSOR_THEME is in
# Xsession.d 55kavis-cursor.
(sleep 2; xsetroot -cursor_name left_ptr) &

# --- XDG autostart (H2) -----------------------------------------------
# The list managed by Task Manager > Startup; the single mechanism.
# v0.4-test2 lesson: when these entries (at-spi, xapp-sn-watcher, a second
# picom attempt) started at the SAME TIME as the panel, mapping the panel
# in QEMU without KVM exceeded 12 s and missed the CI frame. The panel
# comes first (waited for at most 10 s), then the others at low priority.
if [ -x /usr/lib/kavis/kavis-session-autostart ]; then
	(
		i=0
		while [ "$i" -lt 20 ]; do
			pgrep -x kavis-panel >/dev/null 2>&1 \
				&& xdotool search --class kavis-panel >/dev/null 2>&1 && break
			sleep 0.5; i=$((i + 1))
		done
		sleep 1
		exec nice -n 10 /usr/lib/kavis/kavis-session-autostart
	) &
fi

# Screensaver/DPMS stay off in live mode (when trying from USB, the
# screen going dark after 10 minutes is confusing).
xset s off -dpms &
