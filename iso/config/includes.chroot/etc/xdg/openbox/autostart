# Kavis — Openbox oturum başlangıcı

# --- Duvar kağıdı ----------------------------------------------------
# kavis-theme paketinden geliyor. Paket yoksa (çıplak ISO) düz renge
# düşüyoruz ki ekran yine de "açıldı" desin.
# xsettings: tema/ikon/ölçek tek kaynaktan, canlı (madde 38).
# Ayarlar bu dosyayı yazıp SIGHUP verir; ilk açılışta varsayılan üret.
XS_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/xsettingsd/xsettingsd.conf"
if command -v xsettingsd >/dev/null 2>&1; then
	if [ ! -f "$XS_CONF" ]; then
		mkdir -p "$(dirname "$XS_CONF")"
		printf 'Net/ThemeName "Kavis"\nNet/IconThemeName "Kavis"\nGtk/FontName "DejaVu Sans 10"\n' > "$XS_CONF"
	fi
	xsettingsd -c "$XS_CONF" &
fi

if command -v xwallpaper >/dev/null 2>&1 &&
	[ -f /usr/share/backgrounds/kavis/kavis.png ]; then
	# Ayarlar > Görünüm'ün seçtiği duvar kâğıdı kavis.conf'ta;
	# yoksa varsayılan (kabuk için hafif grep — keyfile ayrıştırma yok).
	DUVAR=$(grep -m1 '^wallpaper=' "${XDG_CONFIG_HOME:-$HOME/.config}/kavis/kavis.conf" 2>/dev/null | cut -d= -f2-)
	[ -f "$DUVAR" ] || DUVAR=/usr/share/backgrounds/kavis/kavis.png
	xwallpaper --zoom "$DUVAR" &
else
	xsetroot -solid "#0D141B" &
fi

# --- İmleç -----------------------------------------------------------
# Kök penceredeki imleç ayrıca ayarlanmazsa masaüstünün boş alanında X'in
# kalın çarpı imleci kalıyor, tema imleci yalnızca pencerelerde görünüyor.
xsetroot -cursor_name left_ptr &

# --- Kompozitör ------------------------------------------------------
# Gölge ve yuvarlatılmış köşeler için. Panelden ÖNCE başlıyor: panel
# açılışta bileşiklemenin var olup olmadığına bakıp güç menüsünü ona
# göre çiziyor. xrender arka ucu, 3B gerektirmiyor.
if command -v picom >/dev/null 2>&1; then
	# Ayarlar > Görünüm köşe/animasyon değiştirince kullanıcı kopyası
	# yazar (picom canlı yeniden yükleme bilmiyor) — varsa onu kullan.
	PICOM_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/kavis/picom.conf"
	[ -f "$PICOM_CONF" ] || PICOM_CONF=/etc/xdg/picom-kavis.conf
	picom --backend xrender --config "$PICOM_CONF" &
	# Panel bileşiklemeyi görebilsin diye kısa bir pay.
	sleep 1
fi

# --- Görev çubuğu ve başlat menüsü (4. aşama) ------------------------
# NEDEN GÜNLÜĞE YAZIYORUZ: panel ilk denemede canlı ortamda çöktü ve
# çıktısı hiçbir yere gitmediği için sebebi görünmedi — duman testi
# yalnızca "çalışmıyor" diyebildi. Artık hata metni burada duruyor ve
# boot-check onu seri konsola döküyor.
#
# NEDEN YENİDEN DENİYORUZ: panel Wnck üzerinden pencere yöneticisine
# bağlanıyor; openbox otomatik başlangıcı çalıştırdığında bazen henüz
# tam hazır olmuyor. Üç deneme, aralarında birer saniye.
KAVIS_PANEL_LOG="${XDG_RUNTIME_DIR:-/tmp}/kavis-panel.log"
export KAVIS_PANEL_LOG

if command -v kavis-panel >/dev/null 2>&1; then
	(
		deneme=1
		while [ "$deneme" -le 3 ]; do
			echo "--- kavis-panel denemesi $deneme ---" >>"$KAVIS_PANEL_LOG"
			kavis-panel >>"$KAVIS_PANEL_LOG" 2>&1 && exit 0
			echo "--- panel cikti (kod $?), yeniden deneniyor ---" \
				>>"$KAVIS_PANEL_LOG"
			deneme=$((deneme + 1))
			sleep 1
		done
	) &
fi

# --- Win tuşu (C4) ---------------------------------------------------
# Tek başına Super_L dokunuşu → XF86Launch5 (rc.xml: başlat menüsü). Chord'lar
# (Win+E...) etkilenmez; -t 300: 300 ms'den uzun basış dokunuş sayılmaz.
if command -v xcape >/dev/null 2>&1; then
	xcape -t 300 -e 'Super_L=XF86Launch5' &
fi

# --- Kenara yapıştırma (madde 6) -------------------------------------
# Sürükle-kenara-yapıştır; klavye kısayolları openbox'ın kendi işi
# (0210 hook'u). Panelle aynı paketten gelir.
if command -v kavis-snap >/dev/null 2>&1; then
	kavis-snap &
fi

# Ses/parlaklık/kilit/medya OSD'si (sonraki-isler 6a) — panelden ayrı
if command -v kavis-osd >/dev/null 2>&1; then
	kavis-osd &
fi

# Touchpad hareketleri (sonraki-isler 6g): touchpad VARSA başlar,
# yoksa hiç başlamaz. libinput-gestures/touchegg trixie'de olmadığı
# için kendi ince okuyucumuz (/usr/lib/kavis/kavis-gestures).
# Ayarlar > Touchpad aç/kapa Grup F notu.
if [ -x /usr/lib/kavis/kavis-gestures ] \
	&& grep -qi touchpad /proc/bus/input/devices 2>/dev/null; then
	/usr/lib/kavis/kavis-gestures &
fi

# Polkit oturum aracısı (madde 39 "yönetici olarak aç" + madde 64
# onarım): pkexec parola diyaloğunu bu aracı çizer, yoksa yetki
# isteyen HİÇBİR masaüstü işlemi çalışmaz.
if command -v lxpolkit >/dev/null 2>&1; then
	lxpolkit &
fi

# --- Masaüstü simgeleri (madde 6) ------------------------------------
# nemo-desktop yalnız simge katmanını çizer (dosya yöneticisinin kendisi
# Grup E'de yapılandırılacak). GDK_GL=disable: llvmpipe tuzağı (madde
# 61) — nemo bizim ikili olmadığı için ortak başlangıcı kullanamıyor,
# ortam değişkeni buradan veriliyor.
if command -v nemo-desktop >/dev/null 2>&1; then
	GDK_GL=disable nemo-desktop &
fi
# C5: kök pencere imleci nemo-desktop AÇILDIKTAN sonra bir kez daha —
# masaüstü katmanı kök imlecini devralır; erken ayarlanmışsa ve tema
# geç geldiyse I-beam/çarpı takılı kalıyordu. XCURSOR_THEME Xsession.d
# 55kavis-imlec'te.
(sleep 2; xsetroot -cursor_name left_ptr) &

# --- XDG autostart (H2) -----------------------------------------------
# Görev Yöneticisi > Başlangıç'ın yönettiği liste; tek mekanizma.
if [ -x /usr/lib/kavis/kavis-session-autostart ]; then
	/usr/lib/kavis/kavis-session-autostart &
fi

# Ekran koruyucu/DPMS canlı modda kapalı kalsın (USB'den denerken
# 10 dakika sonra ekranın kararması kafa karıştırıyor).
xset s off -dpms &
