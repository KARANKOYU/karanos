# Karan OS — Openbox oturum başlangıcı
#
# GEÇİCİ: 4. aşamada karanos-panel gelince duvar kağıdını ve oturum
# başlangıcını panel yönetecek, bu dosya küçülecek.

# --- Duvar kağıdı ----------------------------------------------------
# karanos-theme paketinden geliyor. Paket yoksa (çıplak ISO) düz renge
# düşüyoruz ki ekran yine de "açıldı" desin.
if command -v xwallpaper >/dev/null 2>&1 &&
	[ -f /usr/share/backgrounds/karanos/karan.png ]; then
	xwallpaper --zoom /usr/share/backgrounds/karanos/karan.png &
else
	xsetroot -solid "#0D141B" &
fi

# --- İmleç -----------------------------------------------------------
# Kök penceredeki imleç ayrıca ayarlanmazsa masaüstünün boş alanında X'in
# kalın çarpı imleci kalıyor, tema imleci yalnızca pencerelerde görünüyor.
xsetroot -cursor_name left_ptr &

# --- Tema önizlemesi (yalnızca canlı ortamda) ------------------------
# Panel ve masaüstü henüz yok; temanın gerçekten uygulandığını CI'ın
# ekran görüntüsünde görebilmek için küçük bir pencere açıyoruz.
# /run/live/medium yalnızca ISO'dan açılınca var — kurulu sistemde
# çalışmaz. 4. aşamada tamamen kaldırılacak.
if [ -d /run/live/medium ] && [ -x /usr/lib/karanos/theme-preview ]; then
	/usr/lib/karanos/theme-preview &
fi

# Ekran koruyucu/DPMS canlı modda kapalı kalsın (USB'den denerken
# 10 dakika sonra ekranın kararması kafa karıştırıyor).
xset s off -dpms &
