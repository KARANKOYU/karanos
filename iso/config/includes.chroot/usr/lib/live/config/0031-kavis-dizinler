#!/bin/sh
# Kavis — canlı kullanıcının evini /users/karan yapar (madde 0)
#
# NEDEN: görev listesi madde 0 dizin yapısını /users/karan altında
# istiyor ve TÜM bileşenler bu yolları kullanacak. live-config'in
# 0030-user-setup bileşeni kullanıcıyı /home/karan ile kurar; bu bileşen
# hemen ardından (0031) çalışıp evi taşır ve standart klasörleri kurar.
# Kalıcı kurulumda /users ayrı bir btrfs subvolume olacak (madde 16/27);
# canlı oturumda sıradan bir dizin — bileşenler için fark yok.
#
# test10 USERS-FAIL dersi: 0230 hook'u (test8 E3) /home'u /users'a bağ
# yaptığından beri user-setup'ın yazdığı /home/karan FİZİKSEL olarak
# /users/karan'ın kendisi. usermod -m'yi kendi üstüne "taşımaya"
# zorlamak hata verip set -e ile betiği mkdir'lardan ÖNCE öldürüyordu.
# Artık gerçek yol karşılaştırılır, klasörler bağdan ve usermod'dan
# BAĞIMSIZ kurulur ve sonda test -d ile doğrulanır.
#
# Kullanıcı sistemi ERTELENDİ (madde 0): tek kullanıcı karan, şifresiz
# otomatik giriş. Kilit ekranı ve kullanıcı ekleme bilerek YOK.
#
# XDG klasör adları İngilizce küçük harf (madde 0'daki liste birebir);
# /etc/xdg/user-dirs.conf enabled=False olduğu için xdg-user-dirs-update
# bunları oturum açılışında yerel dile çevirmeye kalkmaz.

set -e

Kavis_dizinler() {
	# Yalnız canlı oturumda ve bir kez
	grep -q 'boot=live' /proc/cmdline || return 0
	[ -e /var/lib/live/config/kavis-dizinler ] && return 0

	KULLANICI=karan
	YENI_EV=/users/$KULLANICI

	if ! getent passwd "$KULLANICI" >/dev/null 2>&1; then
		echo "kavis-dizinler: '$KULLANICI' yok (user-setup calismadi mi?)" >&2
		return 0
	fi

	eski_ev=$(getent passwd "$KULLANICI" | cut -d: -f6)
	eski_gercek=$(readlink -f "$eski_ev" 2>/dev/null || echo "$eski_ev")
	if [ "$eski_ev" = "$YENI_EV" ]; then
		: # kayıt zaten doğru
	elif [ "$eski_gercek" = "$YENI_EV" ]; then
		# /home bağı üzerinden aynı dizin: taşınacak bir şey yok,
		# yalnız passwd kaydı /users/karan'a çevrilir (-m YOK).
		usermod -d "$YENI_EV" "$KULLANICI" \
			|| echo "kavis-dizinler: passwd kaydi duzeltilemedi" >&2
	else
		mkdir -p /users
		# -m ev içeriğini taşır; canlı oturumda ev bu noktada neredeyse
		# boş (iskelet dosyaları), maliyeti yok. Başarısızlık betiği
		# ÖLDÜRMEZ — klasörler aşağıda her durumda kurulur.
		usermod -d "$YENI_EV" -m "$KULLANICI" \
			|| echo "kavis-dizinler: ev tasinamadi ($eski_ev)" >&2
	fi

	# Klasörler doğrudan /users/karan altına, bağdan bağımsız.
	for d in desktop downloads documents pictures videos music; do
		mkdir -p "$YENI_EV/$d"
	done

	# Bileşenler klasörleri XDG üzerinden bulur; elle yol kurcalamak yok.
	mkdir -p "$YENI_EV/.config"
	cat > "$YENI_EV/.config/user-dirs.dirs" <<XDG
# Kavis madde 0: standart klasörler. Bu dosyayı xdg-user-dirs-update
# yeniden yazmaz (/etc/xdg/user-dirs.conf enabled=False).
XDG_DESKTOP_DIR="\$HOME/desktop"
XDG_DOWNLOAD_DIR="\$HOME/downloads"
XDG_DOCUMENTS_DIR="\$HOME/documents"
XDG_PICTURES_DIR="\$HOME/pictures"
XDG_VIDEOS_DIR="\$HOME/videos"
XDG_MUSIC_DIR="\$HOME/music"
XDG_TEMPLATES_DIR="\$HOME/Templates"
XDG_PUBLICSHARE_DIR="\$HOME"
XDG

	chown -R "$KULLANICI:$KULLANICI" "$YENI_EV"

	mkdir -p /var/lib/live/config
	touch /var/lib/live/config/kavis-dizinler

	# Doğrulama: eksik klasör canlı günlükte anında görünsün —
	# boot-check'in USERS-FAIL'ini beklemeye gerek kalmasın.
	for d in desktop downloads documents pictures videos music; do
		if ! test -d "$YENI_EV/$d"; then
			echo "kavis-dizinler: HATA — $YENI_EV/$d olusmadi" >&2
			return 1
		fi
	done
	echo "kavis-dizinler: ev $YENI_EV, klasörler hazır (doğrulandı)"
}

Kavis_dizinler
