#!/bin/sh
# Kavis oturumu — XDG autostart başlatıcısı (v0.4-test1 H2).
#
# Görev Yöneticisi > Başlangıç ile AYNI kural: /etc/xdg/autostart ve
# ~/.config/autostart, aynı ad kullanıcıda ise o kazanır; Hidden=true
# atlanır; OnlyShowIn/NotShowIn XDG_CURRENT_DESKTOP (Kavis) ile
# karşılaştırılır; TryExec yoksa atlanır; Exec'teki %-kodları düşer.
# Başka autostart mekanizması YOK (openbox-xdg-autostart python3-xdg
# ister, kurulu değil) — liste burada ne diyorsa o başlar.
set -u
LOG="${XDG_RUNTIME_DIR:-/tmp}/kavis-session.log"
: > "$LOG"
desktop="${XDG_CURRENT_DESKTOP:-Kavis}"
userdir="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"

value() { # value <dosya> <anahtar>
	sed -n "s/^$2=//p" "$1" | head -1
}

for f in /etc/xdg/autostart/*.desktop "$userdir"/*.desktop; do
	[ -f "$f" ] || continue
	base=$(basename "$f")
	# sistem girdisi, kullanıcıda aynı ad varsa onu kullan
	case "$f" in
		/etc/xdg/autostart/*) [ -f "$userdir/$base" ] && continue ;;
	esac
	[ "$(value "$f" Hidden)" = "true" ] && { echo "atla (Hidden): $base" >>"$LOG"; continue; }
	only=$(value "$f" OnlyShowIn)
	if [ -n "$only" ] && ! printf '%s' "$only" | grep -q "\(^\|;\)$desktop\(;\|$\)"; then
		echo "atla (OnlyShowIn=$only): $base" >>"$LOG"; continue
	fi
	notin=$(value "$f" NotShowIn)
	if [ -n "$notin" ] && printf '%s' "$notin" | grep -q "\(^\|;\)$desktop\(;\|$\)"; then
		echo "atla (NotShowIn): $base" >>"$LOG"; continue
	fi
	tryexec=$(value "$f" TryExec)
	if [ -n "$tryexec" ] && ! command -v "$tryexec" >/dev/null 2>&1; then
		echo "atla (TryExec yok): $base" >>"$LOG"; continue
	fi
	exec_line=$(value "$f" Exec | sed 's/ %[a-zA-Z]//g')
	[ -n "$exec_line" ] || continue
	echo "baslat: $base -> $exec_line" >>"$LOG"
	sh -c "$exec_line" >>"$LOG" 2>&1 &
done
