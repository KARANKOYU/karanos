#!/bin/sh
# Kavis — touchpad hareketleri (sonraki-isler 6g)
#
# libinput-gestures/touchegg trixie arşivinde YOK; bu betik aynı
# yaklaşımı (libinput debug-events akışını okuma) sıfırdan, awk ile
# uygular. GESTURE_SWIPE_UPDATE satırlarındaki dx/dy toplanır, END'de
# baskın eksen + parmak sayısı /etc/kavis/gestures.conf eşlemesine
# (kullanıcı: ~/.config/kavis/gestures.conf) çevrilip xdotool'a basılır.
# Sıkıştırma (pinch) bilerek bağlanmaz — uygulamaya bırakılır.
#
# `libinput debug-events` hata ayıklama aracı sayılır ama kararlı tek
# metin arayüzü bu (referans araçlar da bunu okur); kullanıcı `input`
# grubunda olduğundan root gerekmez.

set -u

CONF=/etc/kavis/gestures.conf
USER_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/kavis/gestures.conf"
[ -r "$USER_CONF" ] && CONF="$USER_CONF"
[ -r "$CONF" ] || exit 0
command -v libinput >/dev/null 2>&1 || exit 0
command -v xdotool >/dev/null 2>&1 || exit 0

stdbuf -oL libinput debug-events 2>/dev/null | awk -v conf="$CONF" '
BEGIN {
	while ((getline line < conf) > 0) {
		if (line ~ /^[a-z]+[0-9]=/) {
			eq = index(line, "=")
			map[substr(line, 1, eq - 1)] = substr(line, eq + 1)
		}
	}
	close(conf)
}
/GESTURE_SWIPE_BEGIN/ { dx = 0; dy = 0; fingers = $NF }
/GESTURE_SWIPE_UPDATE/ {
	# "... 3  0.25/ 4.03 (unaccelerated)" — bölü işaretli çift dx/dy
	for (i = 1; i <= NF; i++) {
		if ($i ~ /\/$/) { dx += $i + 0; dy += $(i + 1) + 0; break }
		if ($i ~ /\//) {
			split($i, parts, "/"); dx += parts[1] + 0
			if (parts[2] != "") dy += parts[2] + 0
			else dy += $(i + 1) + 0
			break
		}
	}
}
/GESTURE_SWIPE_END/ {
	yon = ""
	adx = (dx < 0) ? -dx : dx; ady = (dy < 0) ? -dy : dy
	if (adx > ady && adx > 15) yon = (dx > 0) ? "right" : "left"
	else if (ady > 15)         yon = (dy > 0) ? "down" : "up"
	if (yon != "") {
		key = map[yon fingers]
		if (key != "") system("xdotool key " key " &")
	}
}
'
