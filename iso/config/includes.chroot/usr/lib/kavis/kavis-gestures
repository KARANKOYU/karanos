#!/bin/sh
# Kavis — touchpad gestures (next-tasks 6g)
#
# libinput-gestures/touchegg are NOT in the trixie archive; this script
# implements the same approach (reading the libinput debug-events
# stream) from scratch with awk. dx/dy from the GESTURE_SWIPE_UPDATE
# lines are summed; at END the dominant axis + finger count is mapped
# through /etc/kavis/gestures.conf (user: ~/.config/kavis/gestures.conf)
# and pressed with xdotool. Pinch is deliberately not bound — left to the
# application.
#
# `libinput debug-events` counts as a debugging tool, but it is the only
# stable text interface (the reference tools read it too); since the user
# is in the `input` group, root is not needed.

set -u

CONF=/etc/kavis/gestures.conf
USER_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/kavis/gestures.conf"
[ -r "$USER_CONF" ] && CONF="$USER_CONF"
[ -r "$CONF" ] || exit 0
command -v libinput >/dev/null 2>&1 || exit 0
command -v xdotool >/dev/null 2>&1 || exit 0

stdbuf -oL libinput debug-events 2>/dev/null | awk -v conf="$CONF" '
BEGIN {
	while ((getline line < conf) > 0) {
		if (line ~ /^[a-z]+[0-9]=/) {
			eq = index(line, "=")
			map[substr(line, 1, eq - 1)] = substr(line, eq + 1)
		}
	}
	close(conf)
}
/GESTURE_SWIPE_BEGIN/ { dx = 0; dy = 0; fingers = $NF }
/GESTURE_SWIPE_UPDATE/ {
	# "... 3  0.25/ 4.03 (unaccelerated)" — slash-separated dx/dy pair
	for (i = 1; i <= NF; i++) {
		if ($i ~ /\/$/) { dx += $i + 0; dy += $(i + 1) + 0; break }
		if ($i ~ /\//) {
			split($i, parts, "/"); dx += parts[1] + 0
			if (parts[2] != "") dy += parts[2] + 0
			else dy += $(i + 1) + 0
			break
		}
	}
}
/GESTURE_SWIPE_END/ {
	dir = ""
	adx = (dx < 0) ? -dx : dx; ady = (dy < 0) ? -dy : dy
	if (adx > ady && adx > 15) dir = (dx > 0) ? "right" : "left"
	else if (ady > 15)         dir = (dy > 0) ? "down" : "up"
	if (dir != "") {
		key = map[dir fingers]
		if (key != "") system("xdotool key " key " &")
	}
}
'
