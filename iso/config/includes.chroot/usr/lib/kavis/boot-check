#!/bin/sh
# Kavis — boot smoke test (runs only in the live session)
#
# Purpose: to know that the boot really reaches the graphical interface
# without downloading the ISO and booting it by hand on every change.
# This script writes the state to the serial console as one-line markers;
# CI looks for those lines.

set -u

# Lines go to the serial console (CI) and to /run/kavis/boot-check.log
# (so selftest and the user can read them — the journal is closed to the
# live user).
mkdir -p /run/kavis 2>/dev/null && chmod 755 /run/kavis 2>/dev/null
log() {
	echo "KAVIS-CHECK: $*"
	echo "KAVIS-CHECK: $*" >> /run/kavis/boot-check.log 2>/dev/null
	chmod 644 /run/kavis/boot-check.log 2>/dev/null
}

# Errors counted as fatal accumulate here. RESULT=FAIL is given at the end.
# WHY: in stages 1 and 2 this script wrote RESULT=OK even though the
# graphical session never opened, because the absence of the window
# manager counted only as a "warning". CI went green wrongly twice. Now
# the desktop really being up is the condition for passing the test.
failed=""
fatal() {
	log "$1"
	failed="${failed} ${2}"
}

# USS (MB): /proc/PID/smaps_rollup Private_Clean + Private_Dirty — at
# least this much RAM is freed when the process dies; no shared library
# pages.
uss_mb() {
	awk '/^Private_(Clean|Dirty):/ { s += $2 } END { printf "%d", s / 1024 }' \
		"/proc/$1/smaps_rollup" 2>/dev/null || echo 0
}

# 0) Was the live user created
# live-config creates this user with user-setup. If the package is
# missing the user is never created and the session cannot open — this
# check shows that case directly.
if getent passwd karan >/dev/null 2>&1; then
	log "USER-OK karan ($(getent passwd karan | cut -d: -f6,7))"
else
	fatal "USER-FAIL live user 'karan' missing — is user-setup installed?" "user"
fi

# 1) Did the X server come up
x_up=0
i=0
while [ "$i" -lt 120 ]; do
	if pgrep -x Xorg >/dev/null 2>&1 || pgrep -x X >/dev/null 2>&1; then
		x_up=1
		break
	fi
	i=$((i + 1))
	sleep 1
done

if [ "$x_up" -ne 1 ]; then
	log "X-FAIL Xorg did not start within 120 seconds"
	log "RESULT=FAIL"
	exit 1
fi
log "X-OK Xorg running (after ${i} seconds)"

# 2) Window manager
# Without a window manager there is no such thing as a desktop: X shows
# an empty root window, the screenshot comes out pitch black. In that
# case, instead of guessing, we dump from here why the session did not
# open — otherwise every attempt burns a 40-minute CI run.
wm_up=0
i=0
while [ "$i" -lt 60 ]; do
	if pgrep -x openbox >/dev/null 2>&1; then
		wm_up=1
		break
	fi
	i=$((i + 1))
	sleep 1
done

if [ "$wm_up" -eq 1 ]; then
	log "WM-OK openbox running (after ${i} seconds)"
else
	fatal "WM-FAIL openbox not running — session did not open" "session"
	echo "--- KAVIS-DIAG: why the session did not open ---"
	echo "# systemctl is-active lightdm: $(systemctl is-active lightdm 2>&1)"
	echo "# user karan: $(getent passwd karan 2>&1 || echo MISSING)"
	echo "# session files:"
	ls -1 /usr/share/xsessions/ 2>&1 | sed 's/^/#   /'
	echo "# running processes:"
	ps -eo comm= 2>/dev/null | sort -u \
		| grep -iE '^(x|xorg|lightdm|openbox|dbus)' | sed 's/^/#   /'
	for f in /var/log/lightdm/lightdm.log \
		/var/log/lightdm/seat0-greeter.log \
		/var/log/lightdm/x-0.log; do
		echo "# ===== $f ====="
		if [ -r "$f" ]; then
			tail -n 25 "$f" 2>&1 | sed 's/^/#   /'
		else
			echo "#   (unreadable)"
		fi
	done
	echo "# ===== journalctl -u lightdm ====="
	journalctl -u lightdm --no-pager -n 30 2>&1 | sed 's/^/#   /'
	echo "--- KAVIS-DIAG end ---"
fi

# 3) Did the theme package make it into the ISO and are its files in place
# Seeing "something colorful" in the screenshot is not enough; let us
# also know that the pieces are individually in place.
theme_missing=""
for f in /usr/share/themes/Kavis/gtk-3.0/gtk.css \
	/usr/share/themes/Kavis/openbox-3/themerc \
	/etc/gtk-3.0/settings.ini; do
	[ -f "$f" ] || theme_missing="${theme_missing} ${f}"
done
if [ -z "$theme_missing" ]; then
	log "THEME-OK gtk+openbox theme in place"
else
	fatal "THEME-FAIL missing:${theme_missing}" "theme"
fi

# C3: the default pointer is Breeze Light; Kavis-Cursors is the
# alternative. Both must be on the ISO — a missing default means the
# session falls back to X's core cursor, which is the thick black X.
if [ -f /usr/share/icons/Breeze_Light/cursors/left_ptr ] \
	&& [ -f /usr/share/icons/Kavis-Cursors/cursors/left_ptr ]; then
	log "CURSOR-OK Breeze_Light $(ls /usr/share/icons/Breeze_Light/cursors 2>/dev/null | wc -l) names, Kavis-Cursors $(ls /usr/share/icons/Kavis-Cursors/cursors 2>/dev/null | wc -l)"
else
	fatal "CURSOR-FAIL cursor theme missing" "cursor"
fi

if [ -f /usr/share/backgrounds/kavis/kavis.png ]; then
	log "WALLPAPER-OK"
else
	fatal "WALLPAPER-FAIL wallpaper missing" "wallpaper"
fi

# Is the taskbar (stage 4) running
# Without the panel the desktop is not Windows-like; the screenshot shows
# only the wallpaper too.
# The panel loads GTK + Wnck; in emulated QEMU that takes a few seconds.
# Let us not repeat the mistake I made with the window manager here:
# looking immediately gives a false negative, so we wait while looking.
panel_up=0
i=0
while [ "$i" -lt 45 ]; do
	if pgrep -f "kavis-panel" >/dev/null 2>&1; then
		panel_up=1
		break
	fi
	i=$((i + 1))
	sleep 1
done

if [ "$panel_up" -eq 1 ]; then
	log "PANEL-OK kavis-panel running (after ${i} seconds)"
	# Proof of the Vala port + the real RAM cost (item 3 "RAM is measured
	# again when done"). The exe path shows the binary is running, VmRSS
	# the cost without an interpreter. A short wait so GTK finishes
	# loading — an early measurement comes out small.
	sleep 3
	panel_pid=$(pgrep -x kavis-panel | head -1 || true)
	if [ -n "$panel_pid" ] && [ -r "/proc/$panel_pid/status" ]; then
		panel_exe=$(readlink "/proc/$panel_pid/exe" 2>/dev/null || echo "?")
		panel_rss_kb=$(awk '/^VmRSS:/ { print $2 }' "/proc/$panel_pid/status")
		log "PANEL-EXE=$panel_exe"
		log "PANEL-RSS=$((panel_rss_kb / 1024))MB"
		# J (v0.4-test1): USS = only the pages belonging to this process
		# (shared gtk/rsvg libraries excluded) — the real cost measure.
		# Same 20 MB budget as Settings, and for the same reason: a GTK3
		# process starts around 12-14 MB of private pages.
		panel_uss=$(uss_mb "$panel_pid")
		log "PANEL-USS=${panel_uss}MB"
		if [ "$panel_uss" -gt 20 ]; then
			log "PANEL-USS-WARN ${panel_uss}MB > 20MB"
		fi
	fi
	# v0.4-test2 A: "process exists" ≠ "window on screen". The CI frame is
	# taken once the panel and the desktop layer are VISIBLE; if not
	# mapped within 60 s it is a real error (PANEL-NOT-MAPPED). The outer
	# script waits +2 s after seeing the DESKTOP-READY line and takes the
	# frame.
	mapped=0
	j=0
	while [ "$j" -lt 60 ]; do
		if runuser -u karan -- env DISPLAY=:0 xdotool search --onlyvisible --class kavis-panel >/dev/null 2>&1 \
			&& runuser -u karan -- env DISPLAY=:0 xdotool search --onlyvisible --class nemo-desktop >/dev/null 2>&1; then
			mapped=1
			break
		fi
		j=$((j + 1))
		sleep 1
	done
	if [ "$mapped" -eq 1 ]; then
		log "DESKTOP-READY panel and desktop windows visible (after ${j} seconds)"
	else
		fatal "PANEL-NOT-MAPPED panel/desktop window not mapped within 60 s" "panel-window"
	fi
else
	fatal "PANEL-FAIL kavis-panel not running" "panel"
	echo "--- KAVIS-DIAG: why the panel is not running ---"
	echo "# kavis-panel path: $(command -v kavis-panel 2>&1 || echo MISSING)"
	echo "# package installed: $(dpkg-query -W -f='${Status}' kavis-panel 2>&1)"
	# The Openbox autostart writes the panel's output here. The user's
	# runtime directory is not root's, so look at both.
	for f in /run/user/1000/kavis-panel.log /tmp/kavis-panel.log \
		/home/karan/.xsession-errors; do
		echo "# ===== $f ====="
		if [ -r "$f" ]; then
			tail -n 30 "$f" 2>&1 | sed 's/^/#   /'
		else
			echo "#   (unreadable)"
		fi
	done
	echo "# binary and its dependencies:"
	ldd /usr/bin/kavis-panel 2>&1 | grep -i "not found" | sed 's/^/#   /' \
		|| echo "#   (all libraries found)"
	echo "--- KAVIS-DIAG end ---"
fi

# Boot screen (stage 3): is the theme selected, are the resources in place
# We cannot tell from here whether the splash really showed (this script
# is not running yet at that time); we verify that the pieces are in
# place. The image itself is checked from the "acilis" screen frame in CI.
if [ -f /usr/share/plymouth/themes/kavis/kavis.script ] &&
	[ -f /usr/share/plymouth/themes/kavis/logo.png ] &&
	[ -f /usr/share/plymouth/themes/kavis/product-name.png ] &&
	[ -f /usr/share/plymouth/themes/kavis/boot-hints.png ] &&
	[ -f /usr/share/plymouth/themes/kavis/made-by-karan.png ]; then
	selected=$(plymouth-set-default-theme 2>/dev/null || echo "?")
	if [ "$selected" = "kavis" ]; then
		log "SPLASH-OK theme kavis"
	else
		fatal "SPLASH-FAIL default theme '$selected'" "splash"
	fi
else
	fatal "SPLASH-FAIL plymouth theme incomplete" "splash"
fi

# -s: the file exists AND is not empty — a zero-byte WAV (broken
# conversion) is caught only here on a silent boot (boot-sound task,
# Group D).
if [ -s /usr/share/kavis/boot/boot-sound.wav ]; then
	log "BOOTSOUND-OK $(stat -c %s /usr/share/kavis/boot/boot-sound.wav) bytes"
else
	fatal "BOOTSOUND-FAIL boot music missing or empty" "boot-sound"
fi

# Did the sound service run — if it did not play, the mechanism holding
# the splash never kicked in either.
sound_state=$(systemctl is-active kavis-boot-sound.service 2>/dev/null || echo none)
log "BOOTSOUND-SERVICE=${sound_state}"

# --- Boot order verification ----------------------------------------
# WHY IT IS NEEDED: in QEMU the audio backend is "none" and the timing
# differs from real hardware, so the flow defect did not show there. In
# the VirtualBox test this happened: the splash came (silent), went out,
# the console showed, the music started ONLY THEN, the splash came a
# second time and the music spilled into the desktop. Expected order:
#
#   plymouth-start  ≤  sound service start  ≤  sound service end
#                                            ≤  plymouth-quit
#
# Timestamps are read from systemd's own monotonic counters
# (microseconds); more reliable than parsing journalctl text.
ts() {
	value=$(systemctl show -p "$2" --value "$1" 2>/dev/null || echo 0)
	case "$value" in
	'' | *[!0-9]*) echo 0 ;;
	*) echo "$value" ;;
	esac
}

ply_start=$(ts plymouth-start.service InactiveExitTimestampMonotonic)
snd_start=$(ts kavis-boot-sound.service InactiveExitTimestampMonotonic)
snd_end=$(ts kavis-boot-sound.service ActiveEnterTimestampMonotonic)
# The splash's closing moment is NOT read from plymouth-quit.service:
# lightdm carries `Conflicts=plymouth-quit.service`, cancels that unit
# and closes the splash itself — quit always showed 0.0s (found in Task
# 2). plymouth-quit-wait runs `plymouth --wait`; the command returns the
# moment plymouthd really exits, so the instant the unit becomes "active"
# is the instant the splash releases the screen. Measured correctly no
# matter who does the closing.
ply_quit=$(ts plymouth-quit-wait.service ActiveEnterTimestampMonotonic)

sec() { echo "$(($1 / 1000000)).$(( ($1 % 1000000) / 100000 ))"; }
log "SPLASH-TIMING start=$(sec "$ply_start")s snd_start=$(sec "$snd_start")s snd_end=$(sec "$snd_end")s quit=$(sec "$ply_quit")s"

# Handoff check (third form, with the v0.3-test2/test3 lessons):
# The gap the user sees is NOT "quit to the X PROCESS" — in the retain
# flow X starts BEFORE Plymouth ends; that span is overlap, not an error.
# The visual gap is between the splash being released (quit) and the
# desktop's FIRST FRAME. The closest measurable moment for the first
# frame: the start of the session's first drawing process (openbox).
# Process start times are read from /proc/<pid>/stat field 22 (starttime,
# ticks) — on the monotonic axis, comparable with systemd's timestamps.
# Second layer of evidence: lightdm.log. If lightdm did the handoff it
# writes "retaining splash", if not (should the minimum-vt problem
# return) "not replacing it" / "no displays replace" — the most reliable
# indicator.

# Print a process's start time in µs on the CLOCK_MONOTONIC axis
# (0 if the process or the value cannot be read). Args: process names
# to try in order with pgrep -x.
proc_start() {
	pb_pid=""
	for pb_name in "$@"; do
		pb_pid=$(pgrep -x "$pb_name" 2>/dev/null | head -1)
		[ -n "$pb_pid" ] && break
	done
	if [ -z "$pb_pid" ] || [ ! -r "/proc/$pb_pid/stat" ]; then
		echo 0
		return
	fi
	pb_ticks=$(awk '{sub(/.*\) /, ""); print $20}' "/proc/$pb_pid/stat")
	pb_hz=$(getconf CLK_TCK 2>/dev/null || echo 100)
	case "$pb_ticks" in
	'' | *[!0-9]*) echo 0 ;;
	*) echo $((pb_ticks * 1000000 / pb_hz)) ;;
	esac
}

x_start=$(proc_start Xorg X)
desk_start=$(proc_start openbox)

retain="unknown"
if [ -r /var/log/lightdm/lightdm.log ]; then
	if grep -qi "retaining splash" /var/log/lightdm/lightdm.log; then
		retain="ok"
	elif grep -qiE "no displays replace|not replacing it" \
		/var/log/lightdm/lightdm.log; then
		retain="none"
	fi
fi
case "$retain" in
ok)
	log "SPLASH-RETAIN-OK lightdm took over the splash (X started at $(sec "$x_start")s, quit=$(sec "$ply_quit")s)"
	;;
none)
	fatal "SPLASH-RETAIN-FAIL lightdm closed the splash without taking it over — is the minimum-vt setting active?" "splash-handoff"
	;;
*)
	log "SPLASH-RETAIN=unknown (no plymouth record found in lightdm.log)"
	;;
esac

if [ "$ply_quit" -ne 0 ] && [ "$desk_start" -ne 0 ]; then
	if [ "$desk_start" -le "$ply_quit" ]; then
		log "SPLASH-HANDOFF=0.0s (splash stayed until the desktop began drawing)"
	else
		gap=$((desk_start - ply_quit))
		log "SPLASH-HANDOFF=$(sec "$gap")s (quit -> desktop's first process)"
		# Threshold 3 s (including the margin for QEMU without KVM; 1-2 s
		# expected on real hardware). If retain is proven, the splash's
		# last frame stays on screen in this window (X is started with
		# -background none) — no black/console, a warning is enough. If
		# there is no retain proof the gap is really visible: the test
		# fails.
		if [ "$gap" -gt 3000000 ]; then
			if [ "$retain" = "ok" ]; then
				log "SPLASH-HANDOFF-WARN $(sec "$gap")s is long but the retained frame covers the screen"
			else
				fatal "SPLASH-HANDOFF-FAIL $(sec "$gap")s between quit and the desktop — gap is visible" "splash-handoff"
			fi
		fi
	fi
else
	log "SPLASH-HANDOFF-NONE (quit=$(sec "$ply_quit")s desktop=$(sec "$desk_start")s could not be measured)"
fi

# How late does the music start relative to the splash? Section 5 says
# "at the same time"; since we must wait for the audio device to be
# ready it cannot be zero, but it must stay small. In the VirtualBox test
# the music started in the middle of the visual — that is the delay we
# measure.
if [ "$ply_start" -ne 0 ] && [ "$snd_start" -ge "$ply_start" ]; then
	delay=$((snd_start - ply_start))
	log "SOUND-DELAY=$(sec "$delay")s (after the splash started)"
	if [ "$delay" -gt 3000000 ]; then
		log "SOUND-DELAY-WARN music started more than 3 seconds after the splash"
	fi
fi

# The sound service's own measurement: how many seconds it waited for the
# device to be ready. To tell whether this is the source of the delay or
# the service was started late.
journalctl -b --no-pager -o cat -u kavis-boot-sound.service 2>/dev/null |
	grep -E "sound device|music|plymouth:" | sed 's/^/KAVIS-CHECK: BOOTSOUND-LOG: /' || true

# Which renderer did Plymouth run with? If DRM is not found and it falls
# back to text mode the splash does not show. Risky on VirtualBox because
# of the vmwgfx error.
ply_renderer=$(journalctl -b --no-pager 2>/dev/null |
	grep -iE "plymouth.*(renderer|drm|frame-buffer|framebuffer)" | tail -3 || true)
if [ -n "$ply_renderer" ]; then
	echo "$ply_renderer" | sed 's/^/KAVIS-CHECK: SPLASH-RENDERER: /'
fi
# Item 71: kavisfetch output to the serial log; "Kavis" (the os-release
# name) and the logo line (K block) must show.
if command -v kavisfetch >/dev/null 2>&1; then
	fetch_out=$(runuser -u karan -- env DISPLAY=:0 kavisfetch --pipe 2>&1 | head -40 || true)
	printf '%s\n' "$fetch_out" | sed 's/^/KAVIS-CHECK: FETCH: /'
	. /etc/os-release
	if printf '%s' "$fetch_out" | grep -q "$NAME" \
		&& printf '%s' "$fetch_out" | grep -q '██'; then
		log "FETCH-OK kavisfetch ran, name and logo present"
	else
		log "FETCH-FAIL name or logo missing from kavisfetch output"
	fi
else
	log "FETCH-FAIL kavisfetch not installed"
fi

# C1 (v0.4-test1): is the edge snapping daemon up in the session — if
# snapping does not work in the VM this is the first suspect.
if pgrep -x kavis-snap >/dev/null 2>&1; then
	log "SNAP-RUNNING-OK"
else
	log "SNAP-RUNNING-FAIL kavis-snap process missing"
fi
log "DRM-DEVICES=$(ls -1 /dev/dri 2>/dev/null | tr '\n' ' ')"

order_errors=""
if [ "$ply_start" -eq 0 ]; then
	order_errors="${order_errors} plymouth-start-never-ran"
fi
if [ "$snd_start" -eq 0 ]; then
	order_errors="${order_errors} sound-service-never-ran"
elif [ "$snd_start" -lt "$ply_start" ]; then
	order_errors="${order_errors} sound-started-before-splash"
fi
# If plymouth-quit ran before the sound service finished, either the
# splash cut the music or the music outlasted the splash — both contrary
# to section 5.
if [ "$ply_quit" -ne 0 ] && [ "$snd_end" -ne 0 ] && [ "$ply_quit" -lt "$snd_end" ]; then
	order_errors="${order_errors} quit-ran-before-music-ended"
fi
# If the closing moment could not be measured at all (plymouth-quit-wait
# did not run) the handoff is unverified too; do not pass quit=0.0s
# silently.
if [ "$ply_quit" -eq 0 ]; then
	order_errors="${order_errors} splash-quit-not-measured"
fi

# How many times was the splash shown? More than once means the console
# was dropped to in between (the symptom seen on real hardware).
splash_count=$(journalctl -b --no-pager -u plymouth-start.service 2>/dev/null |
	grep -c "Started plymouth-start" || true)
[ -n "$splash_count" ] || splash_count=0
log "SPLASH-COUNT=${splash_count}"
if [ "$splash_count" -gt 1 ]; then
	order_errors="${order_errors} splash-started-more-than-once"
fi

if [ -z "$order_errors" ]; then
	log "SPLASH-ORDER-OK"
else
	fatal "SPLASH-ORDER-FAIL${order_errors}" "splash-order"
	echo "--- KAVIS-DIAG: boot order ---"
	journalctl -b --no-pager -o short-monotonic \
		-u plymouth-start.service -u kavis-boot-sound.service \
		-u plymouth-quit.service -u plymouth-quit-wait.service \
		-u lightdm.service 2>&1 |
		tail -n 40 | sed 's/^/#   /'
	echo "--- KAVIS-DIAG end ---"
fi

# Could the Plymouth script be parsed?
# A syntax error in the theme script leaves the splash silently empty;
# since the boot continues, no error shows anywhere. Plymouth logs parse
# errors; we look for them here.
ply_err=$(journalctl -b --no-pager 2>/dev/null |
	grep -iE 'plymouth.*(parse|syntax|error).*(script|theme)|kavis\.script' |
	head -3 || true)
if [ -n "$ply_err" ]; then
	fatal "SPLASH-SCRIPT-FAIL error in the plymouth theme script" "splash-script"
	echo "$ply_err" | sed 's/^/#   /'
else
	log "SPLASH-SCRIPT-OK no parse errors"
fi

# os-release was taken over with dpkg-divert; did it really take over.
# The product name is not embedded in code (single source principle): if
# the Debian identity is still there the takeover failed.
if [ -f /etc/os-release ] && ! grep -q '^ID=debian$' /etc/os-release; then
	log "OSRELEASE-OK $(. /etc/os-release && echo "$PRETTY_NAME")"
else
	fatal "OSRELEASE-FAIL $(grep '^PRETTY_NAME=' /etc/os-release 2>/dev/null)" "os-release"
fi

# 4) Was firmware loaded (critical for Wi-Fi/graphics card — prompt 16)
if [ -d /lib/firmware ] && [ -n "$(ls -A /lib/firmware 2>/dev/null)" ]; then
	log "FIRMWARE-OK $(find /lib/firmware -type f 2>/dev/null | wc -l) files"
else
	log "FIRMWARE-WARN /lib/firmware empty"
fi

# 5) Booted with EFI or BIOS
if [ -d /sys/firmware/efi ]; then
	log "BOOT-MODE=UEFI"
	# efivars file: first 4 bytes are attributes, the 5th byte is the SecureBoot value (0/1)
	sb_state="unreadable"
	for sb in /sys/firmware/efi/efivars/SecureBoot-*; do
		[ -r "$sb" ] || continue
		sb_val=$(od -An -t u1 -j 4 -N 1 "$sb" 2>/dev/null | tr -d ' \n')
		case "$sb_val" in
		1) sb_state="on" ;;
		0) sb_state="off" ;;
		esac
		break
	done
	log "SECURE-BOOT=${sb_state}"
else
	log "BOOT-MODE=BIOS"
fi

# 7) Compositor (item 2): if picom is not running, leftover images stay
# when menus/windows close and the power menu's corners are drawn black.
if pgrep -x picom >/dev/null 2>&1; then
	log "PICOM-OK"
else
	fatal "PICOM-FAIL picom not running" "picom"
fi

# 8) /users/karan directory layout (item 0)
home=$(getent passwd karan 2>/dev/null | cut -d: -f6)
if [ "$home" = "/users/karan" ]; then
	missing_dirs=""
	for d in desktop downloads documents pictures videos music; do
		[ -d "/users/karan/$d" ] || missing_dirs="$missing_dirs $d"
	done
	if [ -z "$missing_dirs" ]; then
		log "USERS-OK home=/users/karan, 6 folders ready"
	else
		fatal "USERS-FAIL missing folders:$missing_dirs" "users"
	fi
else
	fatal "USERS-FAIL home '$home' (expected /users/karan)" "users"
fi

# 8b) Settings application (item 9): does the window really open.
# Started as karan in the panel session; after 3 s it is searched by
# class name (xdotool is on the ISO — clipboard paste already uses it).
if command -v kavis-settings >/dev/null 2>&1; then
	runuser -u karan -- env DISPLAY=:0 kavis-settings >/dev/null 2>&1 &
	settings_shell_pid=$!
	sleep 3
	if runuser -u karan -- env DISPLAY=:0 \
			xdotool search --class kavis-settings >/dev/null 2>&1; then
		settings_pid=$(pgrep -x kavis-settings | head -1 || true)
		if [ -n "$settings_pid" ]; then
			settings_rss_kb=$(awk '/^VmRSS:/ { print $2 }' \
				"/proc/$settings_pid/status")
			settings_uss=$(uss_mb "$settings_pid")
			log "SETTINGS-OK window opened, RSS=$((settings_rss_kb / 1024))MB USS=${settings_uss}MB"
			# Budget 20 MB, above is a WARNING (RSS counts shared
			# libraries, meaningless for the target). The old 10 MB
			# target was below the floor of a GTK3 process: measured on
			# 4 Sep an empty window already costs 12-14 MB of private
			# pages (icon cache, CSS provider, Pango and GTK's own
			# per-process state), so Settings at 15 MB and the panel at
			# 16 MB were already close to the minimum a GTK3 app can
			# reach. 20 MB leaves room for a real regression to show.
			if [ "$settings_uss" -gt 20 ]; then
				log "SETTINGS-USS-WARN ${settings_uss}MB > 20MB"
			fi
		else
			log "SETTINGS-OK window opened"
		fi
	else
		fatal "SETTINGS-FAIL kavis-settings window did not open" "settings"
	fi
	pkill -x kavis-settings 2>/dev/null || true
	wait "$settings_shell_pid" 2>/dev/null || true
else
	fatal "SETTINGS-FAIL kavis-settings not installed" "settings"
fi

# 9) Security hardening (item 8): were the sysctl values really applied
sysctl_bad=""
check_sysctl() {
	value=$(cat "/proc/sys/$1" 2>/dev/null || echo "?")
	if [ "$value" != "$2" ]; then
		sysctl_bad="$sysctl_bad $1=$value"
	fi
}
check_sysctl kernel/unprivileged_userns_clone 0
check_sysctl kernel/kptr_restrict 2
check_sysctl kernel/dmesg_restrict 1
check_sysctl kernel/yama/ptrace_scope 1
if [ -z "$sysctl_bad" ]; then
	log "SYSCTL-OK 4 hardening values applied"
else
	fatal "SYSCTL-FAIL unexpected:$sysctl_bad" "sysctl"
fi

# 10) earlyoom (item 8) — is the service up
if systemctl is-active --quiet earlyoom.service 2>/dev/null; then
	log "EARLYOOM-OK"
else
	fatal "EARLYOOM-FAIL service not running" "earlyoom"
fi

# 10b) gsettings overrides (H1/H5 and the rest of zz-kavis): a key that
# does not exist in an installed schema is IGNORED at runtime without a
# word, so a typo would silently drop a default. Compiling the schema
# directory in dry-run mode reports exactly those cases.
schema_out=$(glib-compile-schemas --dry-run /usr/share/glib-2.0/schemas 2>&1 || true)
if printf '%s' "$schema_out" | grep -q "override"; then
	printf '%s\n' "$schema_out" | grep "override" | head -10 | while IFS= read -r line; do
		log "SCHEMA-OVERRIDE ${line}"
	done
	fatal "SCHEMA-FAIL gsettings override key rejected" "schema"
else
	log "SCHEMA-OK gsettings overrides accepted"
fi

# 11) Robustness checks (item 72, kararlar.md 9a)
# 11a) Service health: no systemd unit may be in the failed state
failed_units=$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}' | tr '\n' ' ')
if [ -z "${failed_units% }" ]; then
	log "SERVICES-OK"
else
	fatal "SERVICES-FAIL failed units: ${failed_units% }" "services"
fi

# 11b) Journal: the number of lines with priority <= err in this boot
# must be below the threshold. Threshold 20 (kararlar.md 9a): the value
# measured on the test2 ISO in QEMU was 0 (3 Sep calibration); the first
# 20 lines for diagnosis.
journal_errs=$(journalctl -b -p err --no-pager -q 2>/dev/null | wc -l)
log "JOURNAL-ERRORS=${journal_errs}"
journalctl -b -p err --no-pager -q -o short 2>/dev/null | head -20 | while IFS= read -r line; do
	log "JOURNAL-ERR ${line}"
done
if [ "$journal_errs" -le 20 ]; then
	log "JOURNAL-OK ${journal_errs} <= 20"
else
	fatal "JOURNAL-FAIL ${journal_errs} err lines (threshold 20)" "journal"
fi

# 11c) Coredump: neither a systemd-coredump record nor a file
core_files=$(find /var/lib/systemd/coredump -type f 2>/dev/null | wc -l)
core_records=0
if command -v coredumpctl >/dev/null 2>&1; then
	core_records=$(coredumpctl list --no-legend 2>/dev/null | wc -l)
fi
if [ "$core_files" -eq 0 ] && [ "$core_records" -eq 0 ]; then
	log "COREDUMP-OK"
else
	coredumpctl list --no-legend 2>/dev/null | head -5 | while IFS= read -r line; do
		log "COREDUMP ${line}"
	done
	fatal "COREDUMP-FAIL files=${core_files} records=${core_records}" "coredump"
fi

# 11d) dpkg -V: no Debian package file modified by Kavis. Conffiles
# (2nd column 'c') are allowed — their count is logged. The doc/man/locale
# files deliberately deleted by the 9995-cleanup hook come out as
# "missing" (3 Sep calibration: all under /usr/share/doc, man/<lang>,
# doc-base) — those are counted, not an error. The rest (modified, or
# missing elsewhere) is an error. All files are md5-summed (minutes in
# CI with KVM, ~10 min on TCG); if it does not finish in 300 s, WARN (not
# red), at low priority.
dpkg_out=$(timeout 300 nice -n 19 ionice -c 3 dpkg -V 2>/dev/null)
dpkg_rc=$?
if [ "$dpkg_rc" -eq 124 ]; then
	log "DPKG-VERIFY-WARN did not finish in 300 s"
else
	conffile_count=$(printf '%s\n' "$dpkg_out" | awk 'NF && $2 == "c"' | wc -l)
	expected_missing=$(printf '%s\n' "$dpkg_out" | awk 'NF && $1 == "missing" && ($NF ~ "^/usr/share/(doc|doc-base|man|locale)/")' | wc -l)
	changed=$(printf '%s\n' "$dpkg_out" | awk 'NF && $2 != "c" && !($1 == "missing" && ($NF ~ "^/usr/share/(doc|doc-base|man|locale)/"))')
	printf '%s\n' "$dpkg_out" | awk 'NF && $2 == "c" {print $NF}' | head -30 | while IFS= read -r line; do
		log "DPKG-CONFFILE ${line}"
	done
	if [ -z "$changed" ]; then
		log "DPKG-VERIFY-OK conffile=${conffile_count} cleanup-missing=${expected_missing}"
	else
		printf '%s\n' "$changed" | head -30 | while IFS= read -r line; do
			log "DPKG-VERIFY-DIFF ${line}"
		done
		fatal "DPKG-VERIFY-FAIL $(printf '%s\n' "$changed" | wc -l) modified package files (conffile=${conffile_count})" "dpkg-verify"
	fi
fi

# 11e) Boot time: total + the 5 slowest units (comparison in docs)
log "BOOT-TIME $(systemd-analyze time 2>/dev/null | head -1 | tr -s ' ')"
systemd-analyze blame --no-pager 2>/dev/null | head -5 | while IFS= read -r line; do
	log "BOOT-BLAME $(printf '%s' "$line" | tr -s ' ')"
done

# 6) Memory usage — measurement for the 1 GB target in prompt 20
mem_used_mb=$(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{printf "%d", (t-a)/1024}' /proc/meminfo)
log "MEM-USED=${mem_used_mb}MB"

# 12) Selftest (item 72): if the desktop is ready the scenarios run in
# the real session; run.log lines land in the serial log with the
# SELFTEST prefix. AFTER the idle RAM measurement (it opens and closes
# applications). 15 min limit (slow on TCG); exceeding the limit or an
# error is SELFTEST-FAIL = red.
if [ "$panel_up" -eq 1 ] && command -v kavis-selftest >/dev/null 2>&1; then
	selftest_rc=0
	runuser -u karan -- env DISPLAY=:0 HOME=/users/karan \
		XDG_RUNTIME_DIR=/run/user/1000 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus \
		timeout 900 kavis-selftest --all 2>/dev/null | while IFS= read -r line; do
		log "SELFTEST ${line}"
	done
	selftest_rc=$(runuser -u karan -- sh -c 'd=$(ls -1d /users/karan/.local/share/kavis/selftest/*/ 2>/dev/null | tail -1); grep -c "SELFTEST-FAIL" "${d}run.log" 2>/dev/null' || true)
	if [ "${selftest_rc:-0}" = "0" ]; then
		log "SELFTEST-OK"
	else
		# The report leaves the VM through the serial log: the smoke
		# test has no shared folder, and a failing step is exactly when
		# the screenshots are worth having. Thumbnails are dropped and
		# the archive is capped, because base64 over an emulated serial
		# port is slow — a report that does not fit is truncated on
		# purpose rather than stalling the run.
		selftest_dir=$(runuser -u karan -- sh -c 'ls -1d /users/karan/.local/share/kavis/selftest/*/ 2>/dev/null | tail -1')
		if [ -n "$selftest_dir" ]; then
			tar czf /tmp/selftest.tar.gz -C "$selftest_dir" \
				--exclude='*-thumb.png' . 2>/dev/null || true
			size=$(stat -c %s /tmp/selftest.tar.gz 2>/dev/null || echo 0)
			if [ "$size" -gt 0 ] && [ "$size" -le 524288 ]; then
				log "SELFTEST-REPORT-BEGIN ${size} bytes"
				base64 -w 120 /tmp/selftest.tar.gz | while IFS= read -r chunk; do
					log "SELFTEST-REPORT ${chunk}"
				done
				log "SELFTEST-REPORT-END"
			else
				log "SELFTEST-REPORT-SKIP ${size} bytes (limit 524288)"
			fi
		fi
		fatal "SELFTEST-FAIL scenario error (run.log)" "selftest"
	fi
else
	log "SELFTEST-SKIP no panel or kavis-selftest not installed"
fi

if [ -n "$failed" ]; then
	log "FAILED-CHECKS=${failed# }"
	log "RESULT=FAIL"
	exit 1
fi

log "RESULT=OK"
exit 0
