#!/bin/sh
# Kavis — açılış duman testi (yalnızca canlı oturumda çalışır)
#
# Amaç: her değişiklikte ISO'yu indirip elle açmadan, açılışın gerçekten
# grafik arayüze kadar geldiğini bilmek. Bu script durumu seri konsola tek
# satırlık işaretler hâlinde yazar; CI bu satırları arar.

set -u

log() { echo "KAVIS-CHECK: $*"; }

# Ölümcül sayılan hatalar burada birikir. En sonda RESULT=FAIL veriyoruz.
# NEDEN: 1. ve 2. aşamada grafik oturum hiç açılmadığı hâlde bu script
# RESULT=OK yazıyordu, çünkü pencere yöneticisinin yokluğu yalnızca
# "uyarı" sayılıyordu. CI iki kez yanlış yeşil yandı. Artık masaüstünün
# gerçekten ayakta olması testin geçme şartı.
olumcul=""
fatal() {
	log "$1"
	olumcul="${olumcul} ${2}"
}

# USS (MB): /proc/PID/smaps_rollup Private_Clean + Private_Dirty — süreç
# ölünce en az bu kadar RAM boşalır; paylaşılan kütüphane sayfaları yok.
uss_mb() {
	awk '/^Private_(Clean|Dirty):/ { s += $2 } END { printf "%d", s / 1024 }' \
		"/proc/$1/smaps_rollup" 2>/dev/null || echo 0
}

# 0) Canlı kullanıcı oluşturuldu mu
# live-config bu kullanıcıyı user-setup ile yaratıyor. Paket eksikse
# kullanıcı hiç oluşmuyor ve oturum açılamıyor — bu kontrol o durumu
# doğrudan gösterir.
if getent passwd karan >/dev/null 2>&1; then
	log "USER-OK karan ($(getent passwd karan | cut -d: -f6,7))"
else
	fatal "USER-FAIL canli kullanici 'karan' yok — user-setup kurulu mu?" "kullanici"
fi

# 1) X sunucusu ayağa kalktı mı
x_up=0
i=0
while [ "$i" -lt 120 ]; do
	if pgrep -x Xorg >/dev/null 2>&1 || pgrep -x X >/dev/null 2>&1; then
		x_up=1
		break
	fi
	i=$((i + 1))
	sleep 1
done

if [ "$x_up" -ne 1 ]; then
	log "X-FAIL Xorg 120 saniyede baslamadi"
	log "RESULT=FAIL"
	exit 1
fi
log "X-OK Xorg calisiyor (${i} saniyede)"

# 2) Pencere yöneticisi
# Pencere yöneticisi yoksa masaüstü diye bir şey yok demektir: X boş bir
# kök pencere gösterir, ekran görüntüsü simsiyah çıkar. Bu durumda
# tahmin yürütmek yerine oturumun neden açılmadığını buradan döküyoruz —
# aksi hâlde her denemede 40 dakikalık CI koşusu harcanıyor.
wm_up=0
i=0
while [ "$i" -lt 60 ]; do
	if pgrep -x openbox >/dev/null 2>&1; then
		wm_up=1
		break
	fi
	i=$((i + 1))
	sleep 1
done

if [ "$wm_up" -eq 1 ]; then
	log "WM-OK openbox calisiyor (${i} saniyede)"
else
	fatal "WM-FAIL openbox calismiyor — oturum acilmamis" "oturum"
	echo "--- KAVIS-TANI: oturum neden acilmadi ---"
	echo "# systemctl is-active lightdm: $(systemctl is-active lightdm 2>&1)"
	echo "# kullanici karan: $(getent passwd karan 2>&1 || echo YOK)"
	echo "# oturum dosyalari:"
	ls -1 /usr/share/xsessions/ 2>&1 | sed 's/^/#   /'
	echo "# calisan surecler:"
	ps -eo comm= 2>/dev/null | sort -u \
		| grep -iE '^(x|xorg|lightdm|openbox|dbus)' | sed 's/^/#   /'
	for f in /var/log/lightdm/lightdm.log \
		/var/log/lightdm/seat0-greeter.log \
		/var/log/lightdm/x-0.log; do
		echo "# ===== $f ====="
		if [ -r "$f" ]; then
			tail -n 25 "$f" 2>&1 | sed 's/^/#   /'
		else
			echo "#   (okunamadi)"
		fi
	done
	echo "# ===== journalctl -u lightdm ====="
	journalctl -u lightdm --no-pager -n 30 2>&1 | sed 's/^/#   /'
	echo "--- KAVIS-TANI sonu ---"
fi

# 3) Tema paketi ISO'ya girdi mi ve dosyaları yerinde mi
# Ekran görüntüsünde "renkli bir şey" görmek yetmiyor; parçaların
# tek tek yerinde olduğunu da bilelim.
theme_eksik=""
for f in /usr/share/themes/Kavis/gtk-3.0/gtk.css \
	/usr/share/themes/Kavis/openbox-3/themerc \
	/etc/gtk-3.0/settings.ini; do
	[ -f "$f" ] || theme_eksik="${theme_eksik} ${f}"
done
if [ -z "$theme_eksik" ]; then
	log "THEME-OK gtk+openbox teması yerinde"
else
	fatal "THEME-FAIL eksik:${theme_eksik}" "tema"
fi

if [ -f /usr/share/icons/Kavis-Cursors/cursors/left_ptr ]; then
	log "CURSOR-OK $(ls /usr/share/icons/Kavis-Cursors/cursors 2>/dev/null | wc -l) imleç adı"
else
	fatal "CURSOR-FAIL imleç teması yok" "imlec"
fi

if [ -f /usr/share/backgrounds/kavis/kavis.png ]; then
	log "WALLPAPER-OK"
else
	fatal "WALLPAPER-FAIL duvar kagidi yok" "duvarkagidi"
fi

# Görev çubuğu (4. aşama) çalışıyor mu
# Panel yoksa masaüstü Windows benzeri olmuyor; ekran görüntüsünde de
# yalnızca duvar kağıdı görünür.
# Panel GTK + Wnck yüklüyor; öykünmeli QEMU'da bu birkaç saniye
# sürüyor. Pencere yöneticisinde yaptığım hatanın aynısını burada da
# yapmayalım: anında bakmak yanlış negatif veriyor, bekleyerek bakıyoruz.
panel_up=0
i=0
while [ "$i" -lt 45 ]; do
	if pgrep -f "kavis-panel" >/dev/null 2>&1; then
		panel_up=1
		break
	fi
	i=$((i + 1))
	sleep 1
done

if [ "$panel_up" -eq 1 ]; then
	log "PANEL-OK kavis-panel calisiyor (${i} saniyede)"
	# Vala taşımasının kanıtı + gerçek RAM maliyeti (madde 3 "bitince
	# RAM tekrar ölçülür"). exe yolu ikilinin çalıştığını, VmRSS
	# yorumlayıcısız maliyeti gösterir. GTK'nın yüklemesi bitsin diye
	# kısa bir bekleme — erken ölçüm olduğundan küçük çıkıyor.
	sleep 3
	panel_pid=$(pgrep -x kavis-panel | head -1 || true)
	if [ -n "$panel_pid" ] && [ -r "/proc/$panel_pid/status" ]; then
		panel_exe=$(readlink "/proc/$panel_pid/exe" 2>/dev/null || echo "?")
		panel_rss_kb=$(awk '/^VmRSS:/ { print $2 }' "/proc/$panel_pid/status")
		log "PANEL-EXE=$panel_exe"
		log "PANEL-RSS=$((panel_rss_kb / 1024))MB"
		# J (v0.4-test1): USS = yalnız bu sürece ait sayfalar (paylaşılan
		# gtk/rsvg kütüphaneleri hariç) — gerçek maliyet ölçüsü.
		log "PANEL-USS=$(uss_mb "$panel_pid")MB"
	fi
	# v0.4-test2 A: "süreç var" ≠ "pencere ekranda". CI karesi panel ve
	# masaüstü katmanı GÖRÜNÜR olunca alınır; 60 sn içinde haritalanmazsa
	# gerçek hata (PANEL-NOT-MAPPED). Dış betik DESKTOP-READY satırını
	# görünce +2 sn bekleyip kareyi alır.
	mapped=0
	j=0
	while [ "$j" -lt 60 ]; do
		if runuser -u karan -- env DISPLAY=:0 xdotool search --onlyvisible --class kavis-panel >/dev/null 2>&1 \
			&& runuser -u karan -- env DISPLAY=:0 xdotool search --onlyvisible --class nemo-desktop >/dev/null 2>&1; then
			mapped=1
			break
		fi
		j=$((j + 1))
		sleep 1
	done
	if [ "$mapped" -eq 1 ]; then
		log "DESKTOP-READY panel ve masaustu pencereleri gorunur (${j} saniyede)"
	else
		fatal "PANEL-NOT-MAPPED panel/masaustu penceresi 60 sn icinde haritalanmadi" "panel-pencere"
	fi
else
	fatal "PANEL-FAIL kavis-panel calismiyor" "panel"
	echo "--- KAVIS-TANI: panel neden calismiyor ---"
	echo "# kavis-panel yolu: $(command -v kavis-panel 2>&1 || echo YOK)"
	echo "# paket kurulu mu: $(dpkg-query -W -f='${Status}' kavis-panel 2>&1)"
	# Openbox otomatik başlangıcı panelin çıktısını buraya yazıyor.
	# Kullanıcının çalışma dizini root'un değil, o yüzden ikisine de bak.
	for f in /run/user/1000/kavis-panel.log /tmp/kavis-panel.log \
		/home/karan/.xsession-errors; do
		echo "# ===== $f ====="
		if [ -r "$f" ]; then
			tail -n 30 "$f" 2>&1 | sed 's/^/#   /'
		else
			echo "#   (okunamadi)"
		fi
	done
	echo "# ikili ve bagimliliklari:"
	ldd /usr/bin/kavis-panel 2>&1 | grep -i "not found" | sed 's/^/#   /' \
		|| echo "#   (tum kutuphaneler bulundu)"
	echo "--- KAVIS-TANI sonu ---"
fi

# Açılış ekranı (3. aşama): tema seçili mi, kaynaklar yerinde mi
# Splash'in gerçekten göründüğünü buradan anlayamayız (o sırada bu script
# henüz çalışmıyor); parçaların yerinde olduğunu doğruluyoruz. Görüntünün
# kendisi CI'daki "acilis" ekran karesinden bakılır.
if [ -f /usr/share/plymouth/themes/kavis/kavis.script ] &&
	[ -f /usr/share/plymouth/themes/kavis/logo.png ] &&
	[ -f /usr/share/plymouth/themes/kavis/urun-adi.png ] &&
	[ -f /usr/share/plymouth/themes/kavis/acilis-ipuclari.png ] &&
	[ -f /usr/share/plymouth/themes/kavis/made-by-karan.png ]; then
	secili=$(plymouth-set-default-theme 2>/dev/null || echo "?")
	if [ "$secili" = "kavis" ]; then
		log "SPLASH-OK tema kavis"
	else
		fatal "SPLASH-FAIL varsayilan tema '$secili'" "splash"
	fi
else
	fatal "SPLASH-FAIL plymouth temasi eksik" "splash"
fi

# -s: dosya var VE boş değil — sıfır baytlık WAV (bozuk dönüşüm)
# sessiz açılışta ancak burada yakalanır (boot-sound işi, Grup D).
if [ -s /usr/share/kavis/boot/boot-sound.wav ]; then
	log "BOOTSOUND-OK $(stat -c %s /usr/share/kavis/boot/boot-sound.wav) bayt"
else
	fatal "BOOTSOUND-FAIL acilis muzigi yok ya da bos" "acilis-muzigi"
fi

# Ses servisi çalıştı mı — çalmadıysa splash'i tutan mekanizma da
# devreye girmemiş demektir.
ses_durum=$(systemctl is-active kavis-boot-sound.service 2>/dev/null || echo yok)
log "BOOTSOUND-SERVICE=${ses_durum}"

# --- Açılış sırası doğrulaması --------------------------------------
# NEDEN GEREKLİ: QEMU'da ses arka ucu "none" ve zamanlama gerçek
# donanımdan farklı, bu yüzden akış bozukluğu orada görünmüyordu.
# VirtualBox testinde şu yaşandı: splash geldi (sessiz), söndü, konsol
# göründü, müzik ANCAK O ZAMAN başladı, splash ikinci kez geldi ve müzik
# masaüstüne taştı. Beklenen sıra:
#
#   plymouth-start  ≤  ses servisi başlangıcı  ≤  ses servisi bitişi
#                                              ≤  plymouth-quit
#
# Zaman damgalarını systemd'nin kendi monotonik sayaçlarından okuyoruz
# (mikrosaniye); journalctl metnini ayrıştırmaktan daha güvenilir.
zaman() {
	deger=$(systemctl show -p "$2" --value "$1" 2>/dev/null || echo 0)
	case "$deger" in
	'' | *[!0-9]*) echo 0 ;;
	*) echo "$deger" ;;
	esac
}

ply_basla=$(zaman plymouth-start.service InactiveExitTimestampMonotonic)
ses_basla=$(zaman kavis-boot-sound.service InactiveExitTimestampMonotonic)
ses_bit=$(zaman kavis-boot-sound.service ActiveEnterTimestampMonotonic)
# Splash'in kapanış anı plymouth-quit.service'ten OKUNMAZ: lightdm
# `Conflicts=plymouth-quit.service` taşıyor, o birimi iptal edip splash'i
# kendisi kapatıyor — quit hep 0.0s görünüyordu (İş 2'de bulundu).
# plymouth-quit-wait `plymouth --wait` çalıştırıyor; komut plymouthd
# gerçekten çıktığı anda döner, yani birimin "active" olduğu an splash'in
# ekranı bıraktığı andır. Kapanışı kim yaparsa yapsın doğru ölçülür.
ply_bitir=$(zaman plymouth-quit-wait.service ActiveEnterTimestampMonotonic)

sn() { echo "$(($1 / 1000000)).$(( ($1 % 1000000) / 100000 ))"; }
log "SPLASH-TIMING start=$(sn "$ply_basla")s ses_basla=$(sn "$ses_basla")s ses_bit=$(sn "$ses_bit")s quit=$(sn "$ply_bitir")s"

# Devir teslim denetimi (v0.3-test2/test3 dersleriyle üçüncü biçim):
# Kullanıcının gördüğü boşluk "quit ile X PROSESİ arası" DEĞİL — retain
# akışında X, Plymouth'tan ÖNCE başlar; o süre örtüşmedir, hata değil.
# Görsel boşluk, splash'in bırakılması (quit) ile masaüstünün İLK KARESİ
# arasıdır. İlk kare için ölçülebilir en yakın an: oturumun ilk çizen
# sürecinin (openbox) başlangıcı. Proses başlangıçları /proc/<pid>/stat
# 22. alandan (starttime, tik) okunur — monotonik eksende, systemd
# damgalarıyla kıyaslanabilir.
# İkinci kanıt katmanı: lightdm.log. lightdm devri yaptıysa "retaining
# splash", yapmadıysa (minimum-vt sorunu geri gelirse) "not replacing
# it" / "no displays replace" yazar — en güvenilir gösterge bu.

# Print a process's start time in µs on the CLOCK_MONOTONIC axis
# (0 if the process or the value cannot be read). Args: process names
# to try in order with pgrep -x.
proc_basla() {
	pb_pid=""
	for pb_ad in "$@"; do
		pb_pid=$(pgrep -x "$pb_ad" 2>/dev/null | head -1)
		[ -n "$pb_pid" ] && break
	done
	if [ -z "$pb_pid" ] || [ ! -r "/proc/$pb_pid/stat" ]; then
		echo 0
		return
	fi
	pb_tik=$(awk '{sub(/.*\) /, ""); print $20}' "/proc/$pb_pid/stat")
	pb_hz=$(getconf CLK_TCK 2>/dev/null || echo 100)
	case "$pb_tik" in
	'' | *[!0-9]*) echo 0 ;;
	*) echo $((pb_tik * 1000000 / pb_hz)) ;;
	esac
}

x_basla=$(proc_basla Xorg X)
masa_basla=$(proc_basla openbox)

retain="belirsiz"
if [ -r /var/log/lightdm/lightdm.log ]; then
	if grep -qi "retaining splash" /var/log/lightdm/lightdm.log; then
		retain="ok"
	elif grep -qiE "no displays replace|not replacing it" \
		/var/log/lightdm/lightdm.log; then
		retain="yok"
	fi
fi
case "$retain" in
ok)
	log "SPLASH-RETAIN-OK lightdm splash'i devraldi (X=$(sn "$x_basla")s'de basladi, quit=$(sn "$ply_bitir")s)"
	;;
yok)
	fatal "SPLASH-RETAIN-FAIL lightdm splash'i devralmadan kapatmis — minimum-vt ayari etkin mi?" "splash-devir"
	;;
*)
	log "SPLASH-RETAIN=belirsiz (lightdm.log'da plymouth kaydi bulunamadi)"
	;;
esac

if [ "$ply_bitir" -ne 0 ] && [ "$masa_basla" -ne 0 ]; then
	if [ "$masa_basla" -le "$ply_bitir" ]; then
		log "SPLASH-HANDOFF=0.0s (splash, masaustu cizilmeye baslayana kadar kaldi)"
	else
		devir=$((masa_basla - ply_bitir))
		log "SPLASH-HANDOFF=$(sn "$devir")s (quit -> masaustunun ilk sureci)"
		# Eşik 3 sn (KVM'siz QEMU payı dahil; gerçek donanımda 1-2 sn
		# beklenir). Retain kanıtlıysa bu pencerede ekranda splash'in
		# son karesi durur (X -background none ile başlatılıyor) —
		# siyah/konsol yok, uyarı yeter. Retain kanıtı yoksa boşluk
		# gerçekten görünür demektir: test düşer.
		if [ "$devir" -gt 3000000 ]; then
			if [ "$retain" = "ok" ]; then
				log "SPLASH-HANDOFF-WARN $(sn "$devir")s uzun ama retain karesi ekrani ortuyor"
			else
				fatal "SPLASH-HANDOFF-FAIL quit ile masaustu arasi $(sn "$devir")s — bosluk gorunur" "splash-devir"
			fi
		fi
	fi
else
	log "SPLASH-HANDOFF-YOK (quit=$(sn "$ply_bitir")s masaustu=$(sn "$masa_basla")s olculemedi)"
fi

# Müzik splash'e göre ne kadar geç başlıyor? Bölüm 5 "aynı anda" diyor;
# ses aygıtının hazır olmasını beklemek zorunda olduğumuz için sıfır
# olamıyor ama küçük kalmalı. VirtualBox testinde müzik görselin
# ortasında başlıyordu — ölçtüğümüz gecikme bu.
if [ "$ply_basla" -ne 0 ] && [ "$ses_basla" -ge "$ply_basla" ]; then
	gecikme=$((ses_basla - ply_basla))
	log "SOUND-DELAY=$(sn "$gecikme")s (splash basladiktan sonra)"
	if [ "$gecikme" -gt 3000000 ]; then
		log "SOUND-DELAY-WARN muzik splash'ten 3 saniyeden gec basladi"
	fi
fi

# Ses servisinin kendi ölçümü: aygıtın hazır olmasını kaç saniye
# bekledi. Gecikmenin kaynağı bu mu, yoksa servis mi geç başlatıldı —
# ayırt etmek için.
journalctl -b --no-pager -o cat -u kavis-boot-sound.service 2>/dev/null |
	grep -E "ses aygiti|muzik|plymouth:" | sed 's/^/KAVIS-CHECK: BOOTSOUND-LOG: /' || true

# Plymouth hangi çizici (renderer) ile çalıştı? DRM bulunamayıp metin
# kipine düşerse splash görünmüyor. VirtualBox'ta vmwgfx hatası
# yüzünden bu riskli.
ply_renderer=$(journalctl -b --no-pager 2>/dev/null |
	grep -iE "plymouth.*(renderer|drm|frame-buffer|framebuffer)" | tail -3 || true)
if [ -n "$ply_renderer" ]; then
	echo "$ply_renderer" | sed 's/^/KAVIS-CHECK: SPLASH-RENDERER: /'
fi
# Madde 71: kavisfetch çıktısı seri günlüğe; "Kavis" (os-release adı)
# ve logo satırı (K bloğu) görünmeli.
if command -v kavisfetch >/dev/null 2>&1; then
	fetch_out=$(runuser -u karan -- env DISPLAY=:0 kavisfetch --pipe 2>&1 | head -40 || true)
	printf '%s\n' "$fetch_out" | sed 's/^/KAVIS-CHECK: FETCH: /'
	. /etc/os-release
	if printf '%s' "$fetch_out" | grep -q "$NAME" \
		&& printf '%s' "$fetch_out" | grep -q '██'; then
		log "FETCH-OK kavisfetch calisti, ad ve logo var"
	else
		log "FETCH-FAIL kavisfetch ciktisinda ad ya da logo yok"
	fi
else
	log "FETCH-FAIL kavisfetch kurulu degil"
fi

# C1 (v0.4-test1): kenara yapıştırma daemon'u oturumda ayakta mı —
# VM'de snap çalışmıyorsa ilk şüpheli bu.
if pgrep -x kavis-snap >/dev/null 2>&1; then
	log "SNAP-RUNNING-OK"
else
	log "SNAP-RUNNING-FAIL kavis-snap sureci yok"
fi
log "DRM-DEVICES=$(ls -1 /dev/dri 2>/dev/null | tr '\n' ' ')"

sira_hatasi=""
if [ "$ply_basla" -eq 0 ]; then
	sira_hatasi="${sira_hatasi} plymouth-start-hic-calismadi"
fi
if [ "$ses_basla" -eq 0 ]; then
	sira_hatasi="${sira_hatasi} ses-servisi-hic-calismadi"
elif [ "$ses_basla" -lt "$ply_basla" ]; then
	sira_hatasi="${sira_hatasi} ses-splash-ten-once-basladi"
fi
# plymouth-quit ses servisi bitmeden koştuysa splash müziği kesmiş ya da
# müzik splash'i aşmış demektir — ikisi de bölüm 5'e aykırı.
if [ "$ply_bitir" -ne 0 ] && [ "$ses_bit" -ne 0 ] && [ "$ply_bitir" -lt "$ses_bit" ]; then
	sira_hatasi="${sira_hatasi} quit-muzik-bitmeden-calisti"
fi
# Kapanış anı hiç ölçülemediyse (plymouth-quit-wait çalışmamış) devir
# teslim de doğrulanamamış demektir; quit=0.0s'yi sessizce geçme.
if [ "$ply_bitir" -eq 0 ]; then
	sira_hatasi="${sira_hatasi} splash-kapanisi-olculemedi"
fi

# Splash kaç kez gösterildi? Birden fazlaysa arada konsola düşülmüş
# demektir (gerçek donanımda görülen belirti).
splash_adet=$(journalctl -b --no-pager -u plymouth-start.service 2>/dev/null |
	grep -c "Started plymouth-start" || true)
[ -n "$splash_adet" ] || splash_adet=0
log "SPLASH-COUNT=${splash_adet}"
if [ "$splash_adet" -gt 1 ]; then
	sira_hatasi="${sira_hatasi} splash-birden-fazla-baslatildi"
fi

if [ -z "$sira_hatasi" ]; then
	log "SPLASH-ORDER-OK"
else
	fatal "SPLASH-ORDER-FAIL${sira_hatasi}" "splash-sirasi"
	echo "--- KAVIS-TANI: acilis sirasi ---"
	journalctl -b --no-pager -o short-monotonic \
		-u plymouth-start.service -u kavis-boot-sound.service \
		-u plymouth-quit.service -u plymouth-quit-wait.service \
		-u lightdm.service 2>&1 |
		tail -n 40 | sed 's/^/#   /'
	echo "--- KAVIS-TANI sonu ---"
fi

# Plymouth script'i ayrıştırılabildi mi?
# Tema script'inde bir sözdizimi hatası olursa splash sessizce boş kalır;
# açılış devam ettiği için hiçbir yerde hata görünmez. Plymouth ayrıştırma
# hatalarını günlüğe yazıyor, burada onu arıyoruz.
ply_hata=$(journalctl -b --no-pager 2>/dev/null |
	grep -iE 'plymouth.*(parse|syntax|error).*(script|theme)|kavis\.script' |
	head -3 || true)
if [ -n "$ply_hata" ]; then
	fatal "SPLASH-SCRIPT-FAIL plymouth tema script'inde hata" "splash-script"
	echo "$ply_hata" | sed 's/^/#   /'
else
	log "SPLASH-SCRIPT-OK ayristirma hatasi yok"
fi

# os-release dpkg-divert ile devralınmıştı; gerçekten devraldı mı.
# Ürün adı koda gömülmüyor (tek kaynak ilkesi): Debian kimliği hâlâ
# duruyorsa devralma başarısız demektir.
if [ -f /etc/os-release ] && ! grep -q '^ID=debian$' /etc/os-release; then
	log "OSRELEASE-OK $(. /etc/os-release && echo "$PRETTY_NAME")"
else
	fatal "OSRELEASE-FAIL $(grep '^PRETTY_NAME=' /etc/os-release 2>/dev/null)" "os-release"
fi

# 4) Firmware yüklendi mi (Wi-Fi/ekran kartı için kritik — prompt 16)
if [ -d /lib/firmware ] && [ -n "$(ls -A /lib/firmware 2>/dev/null)" ]; then
	log "FIRMWARE-OK $(find /lib/firmware -type f 2>/dev/null | wc -l) dosya"
else
	log "FIRMWARE-WARN /lib/firmware bos"
fi

# 5) EFI ile mi açıldı, BIOS ile mi
if [ -d /sys/firmware/efi ]; then
	log "BOOT-MODE=UEFI"
	# efivars dosyasi: ilk 4 bayt oznitelik, 5. bayt SecureBoot degeri (0/1)
	sb_state="okunamadi"
	for sb in /sys/firmware/efi/efivars/SecureBoot-*; do
		[ -r "$sb" ] || continue
		sb_val=$(od -An -t u1 -j 4 -N 1 "$sb" 2>/dev/null | tr -d ' \n')
		case "$sb_val" in
		1) sb_state="on" ;;
		0) sb_state="off" ;;
		esac
		break
	done
	log "SECURE-BOOT=${sb_state}"
else
	log "BOOT-MODE=BIOS"
fi

# 7) Kompozitör (madde 2): picom çalışmıyorsa menü/pencere kapanınca
# artık görüntü kalıyor ve güç menüsünün köşeleri siyah çiziliyor.
if pgrep -x picom >/dev/null 2>&1; then
	log "PICOM-OK"
else
	fatal "PICOM-FAIL picom calismiyor" "picom"
fi

# 8) /users/karan dizin yapısı (madde 0)
ev=$(getent passwd karan 2>/dev/null | cut -d: -f6)
if [ "$ev" = "/users/karan" ]; then
	eksik_dizin=""
	for d in desktop downloads documents pictures videos music; do
		[ -d "/users/karan/$d" ] || eksik_dizin="$eksik_dizin $d"
	done
	if [ -z "$eksik_dizin" ]; then
		log "USERS-OK ev=/users/karan, 6 klasor hazir"
	else
		fatal "USERS-FAIL eksik klasor:$eksik_dizin" "users"
	fi
else
	fatal "USERS-FAIL ev '$ev' (beklenen /users/karan)" "users"
fi

# 8b) Ayarlar uygulaması (madde 9): pencere gerçekten açılıyor mu.
# Panel oturumunda karan olarak başlatılır; 3 sn sonra sınıf adıyla
# aranır (xdotool ISO'da — pano yapıştırma zaten kullanıyor).
if command -v kavis-settings >/dev/null 2>&1; then
	runuser -u karan -- env DISPLAY=:0 kavis-settings >/dev/null 2>&1 &
	settings_shell_pid=$!
	sleep 3
	if runuser -u karan -- env DISPLAY=:0 \
			xdotool search --class kavis-settings >/dev/null 2>&1; then
		settings_pid=$(pgrep -x kavis-settings | head -1 || true)
		if [ -n "$settings_pid" ]; then
			settings_rss_kb=$(awk '/^VmRSS:/ { print $2 }' \
				"/proc/$settings_pid/status")
			settings_uss=$(uss_mb "$settings_pid")
			log "SETTINGS-OK pencere acildi, RSS=$((settings_rss_kb / 1024))MB USS=${settings_uss}MB"
			# J: hedef USS <= 10 MB, üstü UYARI (RSS paylaşılan
			# kütüphaneleri sayar, hedef için anlamsızdı).
			if [ "$settings_uss" -gt 10 ]; then
				log "SETTINGS-USS-WARN ${settings_uss}MB > 10MB"
			fi
		else
			log "SETTINGS-OK pencere acildi"
		fi
	else
		fatal "SETTINGS-FAIL kavis-settings penceresi acilmadi" "settings"
	fi
	pkill -x kavis-settings 2>/dev/null || true
	wait "$settings_shell_pid" 2>/dev/null || true
else
	fatal "SETTINGS-FAIL kavis-settings kurulu degil" "settings"
fi

# 9) Güvenlik sertleştirme (madde 8): sysctl değerleri gerçekten uygulanmış mı
sysctl_hata=""
dogrula_sysctl() {
	deger=$(cat "/proc/sys/$1" 2>/dev/null || echo "?")
	if [ "$deger" != "$2" ]; then
		sysctl_hata="$sysctl_hata $1=$deger"
	fi
}
dogrula_sysctl kernel/unprivileged_userns_clone 0
dogrula_sysctl kernel/kptr_restrict 2
dogrula_sysctl kernel/dmesg_restrict 1
dogrula_sysctl kernel/yama/ptrace_scope 1
if [ -z "$sysctl_hata" ]; then
	log "SYSCTL-OK 4 sertlestirme degeri uygulanmis"
else
	fatal "SYSCTL-FAIL beklenmeyen:$sysctl_hata" "sysctl"
fi

# 10) earlyoom (madde 8) — servis ayakta mı
if systemctl is-active --quiet earlyoom.service 2>/dev/null; then
	log "EARLYOOM-OK"
else
	fatal "EARLYOOM-FAIL servis calismiyor" "earlyoom"
fi

# 11) Sağlamlık denetimleri (madde 72, kararlar.md 9a)
# 11a) Servis sağlığı: hiçbir systemd birimi failed durumunda olmasın
basarisiz=$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}' | tr '\n' ' ')
if [ -z "${basarisiz% }" ]; then
	log "SERVICES-OK"
else
	fatal "SERVICES-FAIL basarisiz birim: ${basarisiz% }" "servisler"
fi

# 11b) Journal: bu açılışta öncelik <= err olan satır sayısı eşiğin
# altında olmalı. Eşik 60 (kararlar.md 9a) — ilk koşuların
# JOURNAL-ERRORS değerine göre daraltılır; ilk 20 satır teşhis için.
journal_hata=$(journalctl -b -p err --no-pager -q 2>/dev/null | wc -l)
log "JOURNAL-ERRORS=${journal_hata}"
journalctl -b -p err --no-pager -q -o short 2>/dev/null | head -20 | while IFS= read -r satir; do
	log "JOURNAL-ERR ${satir}"
done
if [ "$journal_hata" -le 60 ]; then
	log "JOURNAL-OK ${journal_hata} <= 60"
else
	fatal "JOURNAL-FAIL ${journal_hata} err satiri (esik 60)" "journal"
fi

# 11c) Coredump: ne systemd-coredump kaydı ne de dosyası
cekirdek_dosya=$(find /var/lib/systemd/coredump -type f 2>/dev/null | wc -l)
cekirdek_kayit=0
if command -v coredumpctl >/dev/null 2>&1; then
	cekirdek_kayit=$(coredumpctl list --no-legend 2>/dev/null | wc -l)
fi
if [ "$cekirdek_dosya" -eq 0 ] && [ "$cekirdek_kayit" -eq 0 ]; then
	log "COREDUMP-OK"
else
	coredumpctl list --no-legend 2>/dev/null | head -5 | while IFS= read -r satir; do
		log "COREDUMP ${satir}"
	done
	fatal "COREDUMP-FAIL dosya=${cekirdek_dosya} kayit=${cekirdek_kayit}" "coredump"
fi

# 11d) dpkg -V: Kavis'in değiştirdiği Debian paket dosyası olmasın.
# Conffile'lar (2. sütun 'c') serbest — sayısı loglanır; gerisi hata.
# Tüm dosyaların md5'i alınır, 300 sn'de bitmezse WARN (kırmızı değil).
dpkg_cikti=$(timeout 300 dpkg -V 2>/dev/null)
dpkg_rc=$?
if [ "$dpkg_rc" -eq 124 ]; then
	log "DPKG-VERIFY-WARN 300 sn'de bitmedi"
else
	conffile_sayi=$(printf '%s\n' "$dpkg_cikti" | awk 'NF && $2 == "c"' | wc -l)
	degisen=$(printf '%s\n' "$dpkg_cikti" | awk 'NF && $2 != "c"')
	printf '%s\n' "$dpkg_cikti" | awk 'NF && $2 == "c" {print $NF}' | head -30 | while IFS= read -r satir; do
		log "DPKG-CONFFILE ${satir}"
	done
	if [ -z "$degisen" ]; then
		log "DPKG-VERIFY-OK conffile=${conffile_sayi}"
	else
		printf '%s\n' "$degisen" | head -30 | while IFS= read -r satir; do
			log "DPKG-VERIFY-DIFF ${satir}"
		done
		fatal "DPKG-VERIFY-FAIL $(printf '%s\n' "$degisen" | wc -l) degismis paket dosyasi (conffile=${conffile_sayi})" "dpkg-verify"
	fi
fi

# 11e) Açılış süresi: toplam + en yavaş 5 birim (karşılaştırma docs'ta)
log "BOOT-TIME $(systemd-analyze time 2>/dev/null | head -1 | tr -s ' ')"
systemd-analyze blame --no-pager 2>/dev/null | head -5 | while IFS= read -r satir; do
	log "BOOT-BLAME $(printf '%s' "$satir" | tr -s ' ')"
done

# 6) Bellek kullanımı — prompt 20'deki 1 GB hedefi için ölçüm
mem_used_mb=$(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{printf "%d", (t-a)/1024}' /proc/meminfo)
log "MEM-USED=${mem_used_mb}MB"

if [ -n "$olumcul" ]; then
	log "FAILED-CHECKS=${olumcul# }"
	log "RESULT=FAIL"
	exit 1
fi

log "RESULT=OK"
exit 0
