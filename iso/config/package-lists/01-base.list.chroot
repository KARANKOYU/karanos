# Kavis — sistem temeli
#
# DİKKAT: --apt-recommends false açık. Tavsiye edilen (Recommends) paketler
# kendiliğinden gelmez. Bir şey eksik kalıyorsa buraya açıkça yazılacak.

# --- çekirdek ve canlı sistem ---
# Çekirdek paketi mimariye göre: live-build'in #if ARCHITECTURES koşulu
# `lb config --architecture` değerine bakar (çok-mimarili hazırlık kuralı).
#if ARCHITECTURES amd64
linux-image-amd64
#endif
#if ARCHITECTURES arm64
linux-image-arm64
#endif
live-boot
live-config
live-config-systemd
live-tools

# user-setup OLMAZSA CANLI OTURUM AÇILMAZ.
# live-config canlı kullanıcıyı (karan) /usr/lib/user-setup/user-setup-apply
# ile oluşturuyor ve bu dosya user-setup paketinden geliyor. live-config onu
# yalnızca Recommends ile istiyor; Recommends kapalı olduğu için paket
# gelmiyor, kullanıcı hiç oluşmuyor, lightdm var olmayan kullanıcıya
# otomatik giriş yapmaya çalışıp boş bir X ekranında kalıyordu — QEMU
# görüntüsü simsiyah çıkıyordu. 1. ve 2. aşamada fark edilmedi çünkü
# duman testi bunu yalnızca uyarı sayıyordu.
user-setup

# --- init ve oturum altyapısı ---
systemd-sysv
systemd-timesyncd
libpam-systemd
dbus
dbus-user-session
polkitd
pkexec
sudo

# --- önyükleyici (ISO'nun imzalı EFI dosyalarını buradan alır) ---
grub-common
shim-signed
mtools
#if ARCHITECTURES amd64
# BIOS açılışı yalnız x86'da var (grub-pc-bin).
grub-pc-bin
grub-efi-amd64-bin
grub-efi-amd64-signed
#endif
#if ARCHITECTURES arm64
# Denenmedi: arm64 ISO'su ilk kez üretilirken doğrulanacak.
grub-efi-arm64-bin
grub-efi-arm64-signed
#endif

# --- RAM testi (madde 30 F3 + madde 50) ---
# memtest86+ x86'ya özgü (MİMARİ kuralı): arm64'te paket de menü
# girdisi de yok. GRUB girdilerini 9601 hook'u yazar; lb'nin kendi
# --memtest entegrasyonu kullanılmıyor (auto/config'de none).
#if ARCHITECTURES amd64
memtest86+
#endif

# --- yerelleştirme ---
locales
console-setup
keyboard-configuration
tzdata

# --- ağ ---
network-manager
wpasupplicant
wireless-regdb
iw
iproute2
ca-certificates

# --- dosya sistemleri (btrfs kök + FAT32 EFI + NTFS okuma/yazma) ---
btrfs-progs
dosfstools
e2fsprogs
ntfs-3g
util-linux
parted
gdisk

# --- donanım bilgisi (Ayarlar > Sistem ve kurulum ön kontrolü kullanacak) ---
pciutils
usbutils
dmidecode

# --- güvenlik ve dayanıklılık (madde 8) ---
# RAM tükenmeden en obur süreci öldürür; ayarları /etc/default/earlyoom.
# Debian paketi servisi kurulumda kendiliğinden etkinleştirir.
earlyoom

# --- temel komut satırı ---
procps
bash-completion
less
nano
curl
wget
file
