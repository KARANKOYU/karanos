# Kavis — system base
#
# NOTE: --apt-recommends false is on. Recommended packages do not come by
# themselves. If something is missing, write it here explicitly.

# --- kernel and live system ---
# The kernel package by architecture: live-build's #if ARCHITECTURES
# condition looks at the `lb config --architecture` value (multi-arch
# readiness rule).
#if ARCHITECTURES amd64
linux-image-amd64
#endif
#if ARCHITECTURES arm64
linux-image-arm64
#endif
live-boot
live-config
live-config-systemd
live-tools

# WITHOUT user-setup THE LIVE SESSION DOES NOT OPEN.
# live-config creates the live user (karan) with
# /usr/lib/user-setup/user-setup-apply, and that file comes from the
# user-setup package. live-config wants it only through Recommends; with
# Recommends off the package did not come, the user was never created,
# lightdm tried to autologin a non-existent user and sat on an empty X
# screen — the QEMU frame came out pitch black. Not noticed in stages 1
# and 2 because the smoke test counted this only as a warning.
user-setup

# --- init and session infrastructure ---
systemd-sysv
systemd-timesyncd
libpam-systemd
dbus
dbus-user-session
polkitd
pkexec
sudo

# --- bootloader (the ISO takes its signed EFI files from here) ---
grub-common
shim-signed
mtools
#if ARCHITECTURES amd64
# BIOS boot exists only on x86 (grub-pc-bin).
grub-pc-bin
grub-efi-amd64-bin
grub-efi-amd64-signed
#endif
#if ARCHITECTURES arm64
# Untested: to be verified when the arm64 ISO is first produced.
grub-efi-arm64-bin
grub-efi-arm64-signed
#endif

# --- RAM test (item 30 F3 + item 50) ---
# memtest86+ is x86-specific (ARCHITECTURE rule): on arm64 there is
# neither the package nor the menu entry. The 9601 hook writes the GRUB
# entries; lb's own --memtest integration is not used (none in
# auto/config).
#if ARCHITECTURES amd64
memtest86+
#endif

# --- localization ---
locales
console-setup
keyboard-configuration
tzdata

# --- network ---
network-manager
wpasupplicant
# systemd-resolved: the local resolver behind Settings > Network > DNS
# privacy (item 52). Without it "encrypted DNS" has nowhere to go —
# NetworkManager would keep writing the network's servers straight into
# resolv.conf. The drop-in that chooses a resolver is written by
# /usr/lib/kavis/set-dns.
systemd-resolved
wireless-regdb
iw
iproute2
ca-certificates

# --- file systems (btrfs root + FAT32 EFI + NTFS read/write) ---
btrfs-progs
dosfstools
e2fsprogs
ntfs-3g
util-linux
parted
gdisk

# --- hardware information (Settings > System and the install pre-check will use these) ---
pciutils
usbutils
dmidecode

# --- security and resilience (item 8) ---
# Kills the hungriest process before RAM runs out; settings in
# /etc/default/earlyoom. The Debian package enables the service by
# itself on installation.
earlyoom

# --- basic command line ---
procps
bash-completion
less
nano
curl
wget
file
