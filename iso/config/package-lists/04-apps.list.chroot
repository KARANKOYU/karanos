# Grup E — temel uygulamalar (madde 39+).
# DİKKAT: --apt-recommends false (CLAUDE.md tuzağı) — Recommends'ten
# gelmesi beklenen her şey burada AÇIKÇA yazılır.

# --- Dosya yöneticisi eki (madde 39; nemo 02-x11'de) ---
# nemo-fileroller: sağ tık sıkıştır/çıkart (file-roller'ı çeker).
# gvfs-backends/-fuse: SMB/SFTP/FTP/DAV paylaşımları + fuse köprüsü;
# Recommends kapalıyken gelmiyor, ağ paylaşımı sessizce kaybolurdu.
nemo-fileroller
gvfs-backends
gvfs-fuse

# --- Arşiv formatları (madde 39: "arşiv TAM" + en hızlı yöntem) ---
# p7zip-full: 7z/cab/iso; unrar (non-free, firmware zaten non-free
# açtı): rar açma; zstd + pigz: çok çekirdekli hızlı sıkıştırma.
p7zip-full
unrar
zstd
pigz

# --- Toplu yeniden adlandırma (madde 39) ---
# Çoklu seçim + F2 → nemo bulk-rename-tool anahtarındaki aracı çağırır
# (zz-kavis.gschema.override). Mint'in bulky'si trixie'de YOK.
gprename

# --- Sağ tık "yolu kopyala" (madde 39) ---
# Pano yazımı için xclip; kavis action'ı kullanır.
xclip

# --- Editörler (madde 40) ---
# mousepad: hızlı, sade metin editörü (not defteri karşılığı).
# kate: kod/JSON editörü — renklendirme, katlama, parantez eşleme
# hazır; ayarları /etc/xdg/katerc. KF6/Qt6 yığını çeker; ISO boyutu
# CI'da izlenir (grup-e-taramasi.md).
mousepad
kate

# --- Disk ve USB araçları (madde 42) ---
# gnome-disk-utility: biçimlendirme (NTFS/FAT/exFAT/ext4/btrfs, kısa
# açıklamalı), SMART (udisks'in yerleşik atasmart'ı), "Restore Disk
# Image" = ISO'yu USB'ye yazma (Rufus karşılığı).
# gparted: bölümleme (madde metni "GParted kurulu").
# baobab: disk alanı haritası (WinDirStat karşılığı).
# exfatprogs: exFAT biçimlendirme/onarım desteği.
gnome-disk-utility
gparted
baobab
exfatprogs

# --- Yazıcı ve tarayıcı (madde 43) ---
# Birinci yol SÜRÜCÜSÜZ (grup-e-taramasi): modern yazıcılar IPP
# Everywhere konuşur — cups-browsed + avahi ağdakini kendiliğinden
# gösterir, ipp-usb USB yazıcıyı aynı protokole köprüler; çoğu
# kullanıcı sürücü ekranı hiç görmez. Sihirbaz system-config-printer
# (otomatik bulma + sürücü + test sayfası; kendi sihirbazımızı yazmak
# kur-ayarla kuralına aykırı). Eski aygıtlar için gutenprint yedeği.
# CUPS web arayüzü (631) varsayılan hâliyle yalnız localhost.
# Tarayıcı: sane-airscan (sürücüsüz eSCL/WSD) + simple-scan arayüzü.
cups
cups-browsed
cups-filters
avahi-daemon
ipp-usb
system-config-printer
printer-driver-gutenprint
sane-airscan
simple-scan

# --- Terminal kolaylıkları (madde 44) ---
# command-not-found + apt-file: bilinmeyen komutta paket önerisi
# (veritabanı 0240 hook'unda derlemede kurulur). gettext-base:
# terminal-tips.sh'ın çevirileri (gettext komutu).
command-not-found
apt-file
gettext-base

# --- Web tarayıcısı (4C: varsayılan sabitli Firefox) ---
# firefox-esr: bakımı Debian'da — güvenlik yamaları apt'tan gelir,
# sürüm sıçramaları yaşanmaz. l10n-tr: ürünün ilk dili Türkçe.
firefox-esr
firefox-esr-l10n-tr

# --- USB güvenli kullanım (madde 63) ---
# psmisc: fuser — çıkarılamayan USB'yi hangi uygulamanın tuttuğunu
# söylemek için.
psmisc
