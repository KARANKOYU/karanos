#!/usr/bin/make -f
# Kavis görev çubuğu — Vala kaynağından tek ikili.
#
# NEDEN VALA (madde 3): panelin Python hâli 117 MB RAM yiyordu
# (yorumlayıcı + PyGObject + tüm GI önbellekleri). Vala aynı GTK/Wnck
# C API'sine derleniyor: aynı görünüm ve davranış, RAM yalnızca GTK'nın
# kendi maliyeti. Saf C'ye göre üçte bir kod — "iş 3 katına çıkıyorsa"
# eşiğinin altında kalmanın yolu.

export DH_VERBOSE = 1

DEST := debian/kavis-panel

# WNCK_I_KNOW_THIS_IS_UNSTABLE: libwnck başlıkları bu tanım olmadan
# derlemeyi reddediyor (API kararlılığı feragatnamesi).
VALA_PAKETLER := --pkg gtk+-3.0 --pkg libwnck-3.0 --pkg gdk-x11-3.0 \
                 --pkg x11 --pkg gio-unix-2.0 --pkg posix
# GETTEXT_PACKAGE: valac'ın _() / N_() bağları glib/gi18n-lib.h
# üzerinden bu tanımı ister (çeviri alanı "kavis" — Grup D işi c).
VALA_CFLAGS := -X -DWNCK_I_KNOW_THIS_IS_UNSTABLE -X -O2 -X -w \
               -X -DGETTEXT_PACKAGE='"kavis"'

KAYNAKLAR := src/main.vala $(wildcard src/logic/*.vala) $(wildcard src/ui/*.vala)
PO_DOSYALAR := $(wildcard po/*.po)

%:
	dh $@

override_dh_auto_build:
	valac $(VALA_PAKETLER) $(VALA_CFLAGS) -o kavis-panel $(KAYNAKLAR)
	valac $(VALA_PAKETLER) $(VALA_CFLAGS) -o kavis-snap \
		src/snap.vala src/logic/appinit.vala
	valac $(VALA_PAKETLER) $(VALA_CFLAGS) -o kavis-osd \
		src/kavis_osd.vala src/logic/appinit.vala \
		src/logic/volume.vala src/logic/quick.vala

override_dh_auto_install:
	install -d $(DEST)/usr/bin
	install -m755 kavis-panel $(DEST)/usr/bin/kavis-panel
	install -m755 kavis-snap $(DEST)/usr/bin/kavis-snap
	install -m755 kavis-osd $(DEST)/usr/bin/kavis-osd
	install -d $(DEST)/usr/share/applications
	install -m644 src/kavis-panel.desktop \
		$(DEST)/usr/share/applications/kavis-panel.desktop
	# Çeviriler: po/ kanonik kaynağı depo kökünde, build-packages.sh
	# kopyalar. Meson'a BİLEREK geçilmedi (en hafif çözüm kuralı):
	# msgfmt adımı yeterli. kavis.mo'yu bu paket taşır; kavis-tools
	# aynı alanı kullanır (Depends: kavis-panel).
	set -e; for po in $(PO_DOSYALAR); do \
		dil=$$(basename $$po .po); \
		install -d $(DEST)/usr/share/locale/$$dil/LC_MESSAGES; \
		msgfmt --check -o \
			$(DEST)/usr/share/locale/$$dil/LC_MESSAGES/kavis.mo \
			$$po; \
	done
	# Çeviri yüzdeleri (dil seçici altyapısı): her derlemede taze.
	# NOT: hedef "kavis-common paketi" istendi ama kavis-common bir
	# paket değil, kaynak dizini — .mo'ların sahibi bu paket, JSON da
	# burada (karar durum.md ONAY BEKLEYEN'de).
	install -d $(DEST)/usr/share/kavis
	../../tools/i18n-stats.sh po \
		$(DEST)/usr/share/kavis/i18n-stats.json

override_dh_auto_clean:
	rm -f kavis-panel kavis-snap kavis-osd
	dh_auto_clean
