#!/usr/bin/make -f
# Kavis taskbar — a single binary from Vala sources.
#
# WHY VALA (madde 3): the Python version of the panel ate 117 MB of
# RAM (interpreter + PyGObject + all the GI caches). Vala compiles to
# the same GTK/Wnck C API: same look and behavior, RAM is only GTK's
# own cost. A third of the code of plain C — the way to stay under the
# "if the work triples" threshold.

export DH_VERBOSE = 1

DEST := debian/kavis-panel

# WNCK_I_KNOW_THIS_IS_UNSTABLE: the libwnck headers refuse to compile
# without this define (API stability disclaimer).
VALA_PACKAGES := --pkg gtk+-3.0 --pkg libwnck-3.0 --pkg gdk-x11-3.0 \
                 --pkg x11 --pkg gio-unix-2.0 --pkg posix
# GETTEXT_PACKAGE: valac's _() / N_() bindings require this define
# through glib/gi18n-lib.h (translation domain "kavis" — Grup D task c).
VALA_CFLAGS := -X -DWNCK_I_KNOW_THIS_IS_UNSTABLE -X -O2 -X -w \
               -X -DGETTEXT_PACKAGE='"kavis"'

SOURCES := src/main.vala $(wildcard src/logic/*.vala) $(wildcard src/ui/*.vala)
PO_FILES := $(wildcard po/*.po)

%:
	dh $@

override_dh_auto_build:
	valac $(VALA_PACKAGES) $(VALA_CFLAGS) -o kavis-panel $(SOURCES)
	# theme.vala + config.vala (B2): palette from kavis.conf, live.
	valac $(VALA_PACKAGES) $(VALA_CFLAGS) -o kavis-snap \
		src/snap.vala src/logic/appinit.vala \
		src/logic/config.vala src/logic/theme.vala
	valac $(VALA_PACKAGES) $(VALA_CFLAGS) -o kavis-osd \
		src/kavis_osd.vala src/logic/appinit.vala \
		src/logic/config.vala src/logic/brightness.vala \
		src/logic/volume.vala src/logic/quick.vala \
		src/logic/theme.vala

override_dh_auto_install:
	install -d $(DEST)/usr/bin
	install -m755 kavis-panel $(DEST)/usr/bin/kavis-panel
	install -m755 kavis-snap $(DEST)/usr/bin/kavis-snap
	install -m755 kavis-osd $(DEST)/usr/bin/kavis-osd
	install -d $(DEST)/usr/share/applications
	install -m644 src/kavis-panel.desktop \
		$(DEST)/usr/share/applications/kavis-panel.desktop
	# Translations: the canonical po/ lives at the repo root,
	# build-packages.sh copies it. Meson was DELIBERATELY not adopted
	# (lightest solution rule): the msgfmt step is enough. This package
	# ships kavis.mo; kavis-tools uses the same domain (Depends:
	# kavis-panel).
	set -e; for po in $(PO_FILES); do \
		lang=$$(basename $$po .po); \
		install -d $(DEST)/usr/share/locale/$$lang/LC_MESSAGES; \
		msgfmt --check -o \
			$(DEST)/usr/share/locale/$$lang/LC_MESSAGES/kavis.mo \
			$$po; \
	done
	# Translation percentages (language picker infrastructure): fresh
	# on every build. NOTE: the "kavis-common package" was requested as
	# the target, but kavis-common is a source directory, not a package
	# — this package owns the .mo files, so the JSON lives here too
	# (decision in durum.md under the "ONAY BEKLEYEN" heading).
	install -d $(DEST)/usr/share/kavis
	../../tools/i18n-stats.sh po \
		$(DEST)/usr/share/kavis/i18n-stats.json

override_dh_auto_clean:
	rm -f kavis-panel kavis-snap kavis-osd
	dh_auto_clean
