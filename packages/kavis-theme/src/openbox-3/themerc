# Kavis — Openbox window theme
#
# Sonraki-isler section 3 (2 Sep): W11 look — the teal gradient is
# GONE, teal only as accent (active window border). Title ~32px,
# active #17222C / inactive #121C26, icon on the left (titleLayout
# NLIMC — 0200 hook), title left-aligned. Thin-line — ☐ ✕ icons from
# the xbm files. Close hover in W11 red (#C42B1C).
#
# OPENBOX LIMITS (NOT switched to CSD — the user's decision):
#   ✓ per-button hover/pressed color (INCLUDING the red close, 3.6+)
#   ✗ no transition animation — colors change instantly (a 120-150 ms
#     fade only works with a CSD/compositor trick)
#   ✗ button width is not adjustable (~46px is impossible; square,
#     tied to the title height) and a 1-2px gap remains between buttons
#   ✗ the hover bg covers only the button box — not a full-height fill

# --- edges -----------------------------------------------------------
border.width: 1
padding.width: 8
# The title height matches Tilix's CSD bar and the Kavis apps'
# GtkHeaderBar (gtk.css min-height 46px). Padding depends on the title
# font, so the two are set together: A1 moved openbox from Debian's
# "sans 8 bold" to "Inter 10" (the 0200 hook writes the rc.xml font
# blocks), which is ~4px taller, so the padding drops from 16 to 14 and
# the frame stays 46. Measured on Xvfb with _NET_FRAME_EXTENTS: 16 gave
# 50, 14 gives 46, 13 gives 44.
padding.height: 14
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0

# C1 (test8): the cyan frame is gone — active/inactive share the same neutral border.
window.active.border.color: #233A45
window.inactive.border.color: #233A45

# --- active window ---------------------------------------------------
window.active.title.bg: flat solid
window.active.title.bg.color: #17222C
window.active.title.separator.color: #233A45
# Without label.bg Openbox paints the label box black and a black
# stripe appears in the middle of the title bar.
window.active.label.bg: parentrelative
window.active.label.text.color: #E6EDF3
window.label.text.justify: left

window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #E6EDF3
# hover: title ground + 10% white (openbox knows no rgba — the blend
# is precomputed: #17222C ⊕ 10% white = #2E3842)
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #2E3842
window.active.button.hover.image.color: #E6EDF3
# pressed: 14% → #374149
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #374149
window.active.button.pressed.image.color: #E6EDF3
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #6E8A92
window.active.button.toggled.bg: parentrelative
window.active.button.toggled.image.color: #E6EDF3
window.active.button.toggled.hover.bg: flat solid
window.active.button.toggled.hover.bg.color: #2E3842
window.active.button.toggled.hover.image.color: #E6EDF3

# Close: hover in W11 red, white icon; pressed one shade darker.
window.active.button.close.hover.bg: flat solid
window.active.button.close.hover.bg.color: #C42B1C
window.active.button.close.hover.image.color: #FFFFFF
window.active.button.close.pressed.bg: flat solid
window.active.button.close.pressed.bg.color: #A02316
window.active.button.close.pressed.image.color: #FFFFFF

# --- inactive window -------------------------------------------------
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #121C26
window.inactive.title.separator.color: #233A45
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #8B9BA8

# Faint when inactive, comes alive on hover.
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #8B9BA8
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #2A333C
window.inactive.button.hover.image.color: #E6EDF3
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #333D47
window.inactive.button.pressed.image.color: #E6EDF3
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #3C4E5A
window.inactive.button.toggled.bg: parentrelative
window.inactive.button.toggled.image.color: #8B9BA8
window.inactive.button.close.hover.bg: flat solid
window.inactive.button.close.hover.bg.color: #C42B1C
window.inactive.button.close.hover.image.color: #FFFFFF
window.inactive.button.close.pressed.bg: flat solid
window.inactive.button.close.pressed.bg.color: #A02316
window.inactive.button.close.pressed.image.color: #FFFFFF

# --- menu ------------------------------------------------------------
menu.border.width: 1
menu.border.color: #233A45
menu.title.bg: flat solid
menu.title.bg.color: #121C26
menu.title.text.color: #2DD4BF
menu.items.bg: flat solid
menu.items.bg.color: #121C26
menu.items.text.color: #E6EDF3
menu.items.disabled.text.color: #55677A
menu.items.active.bg: gradient horizontal
menu.items.active.bg.color: #2DD4BF
menu.items.active.bg.colorTo: #4F92F7
menu.items.active.text.color: #0D141B
menu.separator.color: #233A45
menu.separator.width: 1
menu.overlap.x: 0

# --- other -----------------------------------------------------------
osd.border.width: 1
osd.border.color: #233A45
osd.bg: flat solid
osd.bg.color: #17222C
osd.label.text.color: #E6EDF3
osd.hilight.bg: gradient horizontal
osd.hilight.bg.color: #2DD4BF
osd.hilight.bg.colorTo: #4F92F7
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #233A45

# Like Windows: icon and title on the left, buttons on the right
# (N=icon, L=title, I=iconify, M=maximize, C=close)
window.title.layout: NLIMC
window.label.text.justify: left
