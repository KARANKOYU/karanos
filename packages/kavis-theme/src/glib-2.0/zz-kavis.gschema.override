# Kavis — nemo defaults (madde 39 + test8 F notes).
# No code patch: the behavior is given entirely through a gsettings
# override. The zz- prefix: read last in alphabetical order so it
# overrides the distribution defaults.

[org.nemo.preferences]
# Details view by default, like Explorer (note F).
default-folder-viewer='list-view'
# Windows shows sizes in base-2 (1 KB = 1024 B).
size-prefixes='base-2'
# Rename with two separate slow clicks — Explorer behavior.
quick-renames-with-pause-in-between=true
# F2 on a multi-selection: bulk rename tool (madde 39; Mint's bulky is
# not in trixie, gprename is — see docs/referans/nemo.md).
bulk-rename-tool=b'gprename'
# 4B: the date column in locale format — nemo 6.0's default too; since
# speaking the same language as the panel clock is a product
# requirement, it is pinned explicitly so a later version cannot change it.
date-format='locale'
# H1 (v0.4-test2 feedback): the window said "Home" while the path bar
# said "karan" — two names for one place. The title now carries the
# full path in parentheses and tooltips spell it out as well. The path
# bar button itself keeps the short home name; nemo builds it from the
# bookmark and has no setting for it, and patching nemo was rejected
# (see docs/bilinen-sorunlar.md).
show-full-path-titles=true
tooltips-show-path=true

# E (v0.4-test1): the "Network" section in the sidebar. nemo has NO
# setting to hide the section (nemo-places-sidebar.c add_heading is
# unconditional) — it can only be kept collapsed; removing it entirely
# needs a source patch (PENDING APPROVAL).
[org.nemo.window-state]
network-expanded=false

[org.nemo.list-view]
# Columns and their order: Name / Modified / Type / Size (test8 F).
default-visible-columns=['name','date_modified','type','size']
default-column-order=['name','date_modified','type','size']

# Nemo reads the "open in terminal" command from this schema
# (cinnamon-desktop-data is a nemo dependency, the schema is on the
# ISO). The default gnome-terminal is not installed; the terminal on
# the ISO is tilix (madde 40).
[org.cinnamon.desktop.default-applications.terminal]
exec='tilix'

# Tilix default profile (fixed UUID, tilix source
# GSETTINGS_DEFAULT_UUID): Kavis color identity. Ctrl+Shift+C/V is
# already the tilix default. Font setting from the UI.
# 2E: the "Configuration Issue Detected" window must never appear —
# the vte-2.91.sh source goes into /etc/bash.bashrc via the 0240 hook,
# and the warning is disabled too (both: belt and suspenders).
[com.gexperts.Tilix.Settings]
warn-vte-config-issue=false

[com.gexperts.Tilix.Profile:/com/gexperts/Tilix/profiles/2b7c4080-0ddd-46c5-8f23-563fd3ba789d/]
use-theme-colors=false
background-color='#0D141B'
foreground-color='#E6EDF3'
palette=['#121C26','#EF4444','#22C55E','#F59E0B','#4F92F7','#C678DD','#2DD4BF','#E6EDF3','#233A45','#F87171','#4ADE80','#FBBF24','#7EB1F9','#D19BE8','#5EEAD4','#FFFFFF']

# Mousepad (madde 40 text editor): dark coloring + line numbers.
# 'oblivion' is GtkSourceView's ready-made dark scheme.
[org.xfce.mousepad.preferences.view]
color-scheme='oblivion'
show-line-numbers=true
