# Kavis — nemo varsayılanları (madde 39 + test8 F notları).
# Kod yaması yok: davranış tamamen gsettings override'ıyla veriliyor.
# zz- öneki: alfabetik sırada en son okunup dağıtım varsayılanlarını
# ezmesi için.

[org.nemo.preferences]
# Gezgin gibi ayrıntı görünümü varsayılan (F notu).
default-folder-viewer='list-view'
# Windows boyutları base-2 (1 KB = 1024 B) gösterir.
size-prefixes='base-2'
# İki ayrı yavaş tıkla yeniden adlandırma — Gezgin davranışı.
quick-renames-with-pause-in-between=true
# F2 çoklu seçimde toplu yeniden adlandırma aracı (madde 39; Mint'in
# bulky'si trixie'de yok, gprename var — bkz. docs/referans/nemo.md).
bulk-rename-tool=b'gprename'
# 4B: tarih sütunu locale biçiminde — nemo 6.0'ın varsayılanı da bu;
# panel saatiyle aynı dili konuşması ürün gereği olduğundan üst sürüm
# değiştirmesin diye açıkça sabitleniyor.
date-format='locale'

[org.nemo.list-view]
# Sütunlar ve sırası: Name / Modified / Type / Size (test8 F).
default-visible-columns=['name','date_modified','type','size']
default-column-order=['name','date_modified','type','size']

# Nemo "terminalde aç" komutunu bu şemadan okuyor (cinnamon-desktop-data
# nemo'nun bağımlılığı, şema ISO'da var). Varsayılan gnome-terminal
# kurulu değil; ISO'daki terminal tilix (madde 40).
[org.cinnamon.desktop.default-applications.terminal]
exec='tilix'

# Tilix varsayılan profili (sabit UUID, tilix kaynağı
# GSETTINGS_DEFAULT_UUID): Kavis renk kimliği. Ctrl+Shift+C/V zaten
# tilix varsayılanı. Yazı tipi ayarı arayüzden.
# 2E: "Configuration Issue Detected" penceresi hiç çıkmasın —
# vte-2.91.sh kaynağı 0240 hook'uyla /etc/bash.bashrc'e giriyor,
# uyarı da kapatılıyor (ikisi birden: kemer + pantolon askısı).
[com.gexperts.Tilix.Settings]
warn-vte-config-issue=false

[com.gexperts.Tilix.Profile:/com/gexperts/Tilix/profiles/2b7c4080-0ddd-46c5-8f23-563fd3ba789d/]
use-theme-colors=false
background-color='#0D141B'
foreground-color='#E6EDF3'
palette=['#121C26','#EF4444','#22C55E','#F59E0B','#4F92F7','#C678DD','#2DD4BF','#E6EDF3','#233A45','#F87171','#4ADE80','#FBBF24','#7EB1F9','#D19BE8','#5EEAD4','#FFFFFF']

# Mousepad (madde 40 metin editörü): koyu renklendirme + satır no.
# 'oblivion' GtkSourceView'un hazır koyu şeması.
[org.xfce.mousepad.preferences.view]
color-scheme='oblivion'
show-line-numbers=true
