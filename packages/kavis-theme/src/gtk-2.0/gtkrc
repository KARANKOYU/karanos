# Kavis — GTK2 compatibility
#
# A few applications still use GTK2 (some old tools, wine
# configurators). We do not write a full GTK2 theme; the goal is that
# these windows do not look completely detached from the rest of the
# system.
#
# GTK2 has a single color scheme, no light/dark split. Since the default
# theme is dark, the values here follow the dark palette.

gtk-color-scheme = "fg_color:#E6EDF3\nbg_color:#17222C\nbase_color:#0D141B\ntext_color:#E6EDF3\nselected_bg_color:#2DD4BF\nselected_fg_color:#0D141B\ntooltip_bg_color:#121C26\ntooltip_fg_color:#E6EDF3"

style "kavis-default" {
	xthickness = 1
	ythickness = 1

	fg[NORMAL]        = @fg_color
	fg[PRELIGHT]      = @fg_color
	fg[SELECTED]      = @selected_fg_color
	fg[ACTIVE]        = @fg_color
	fg[INSENSITIVE]   = shade(0.65, @fg_color)

	bg[NORMAL]        = @bg_color
	bg[PRELIGHT]      = shade(1.15, @bg_color)
	bg[SELECTED]      = @selected_bg_color
	bg[ACTIVE]        = shade(0.9, @bg_color)
	bg[INSENSITIVE]   = shade(0.95, @bg_color)

	base[NORMAL]      = @base_color
	base[PRELIGHT]    = @selected_bg_color
	base[SELECTED]    = @selected_bg_color
	base[ACTIVE]      = @selected_bg_color
	base[INSENSITIVE] = @bg_color

	text[NORMAL]      = @text_color
	text[PRELIGHT]    = @text_color
	text[SELECTED]    = @selected_fg_color
	text[ACTIVE]      = @selected_fg_color
	text[INSENSITIVE] = shade(0.65, @fg_color)
}

class "GtkWidget" style "kavis-default"

gtk-button-images = 0
gtk-menu-images   = 0
