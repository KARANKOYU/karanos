#!/bin/sh
# X'in varsayılan imleç temasını Debian'da update-alternatives seçiyor
# (/usr/share/icons/default/index.theme). Dosyayı doğrudan yazmak yerine
# alternatifler sistemine kaydoluyoruz ki kullanıcı isterse
# `update-alternatives --config x-cursor-theme` ile değiştirebilsin.
set -e

case "$1" in
configure)
	update-alternatives --install /usr/share/icons/default/index.theme \
		x-cursor-theme /usr/share/icons/Kavis-Cursors/cursor.theme 100
	;;
esac

#DEBHELPER#

exit 0
