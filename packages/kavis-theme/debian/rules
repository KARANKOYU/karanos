#!/usr/bin/make -f
# Kavis look-and-feel package
#
# Icons, cursors and wallpapers are not kept in the repo as binary
# files; they are all generated here at build time from the logos and
# the generators under tools/.

export DH_VERBOSE = 1

# There are two logos: koyu-k-logo for the dark theme, acik-k-logo for
# the light theme. Both are installed; the rule for which one is used
# in which context:
#   - boot splash and GRUB: ALWAYS the dark logo
#   - start button / about: by the active theme (see kavis-panel)
# Since the system is single-themed (dark) today, the icon theme is
# generated from the dark logo.
LOGO_DARK  := src/logo/koyu-k-logo.svg
LOGO_LIGHT := src/logo/acik-k-logo.svg
DEST    := debian/kavis-theme
THEME   := $(DEST)/usr/share/themes/Kavis
ICONS   := $(DEST)/usr/share/icons/Kavis
CURSORS := $(DEST)/usr/share/icons/Kavis-Cursors
WALL    := $(DEST)/usr/share/backgrounds/kavis
SHARE   := $(DEST)/usr/share/kavis

# The sizes the icon is actually rendered at. GTK scales the sizes in
# between itself, no need to render them all.
ICON_SIZES := 16 22 24 32 48 64 128 256

# The same image is requested under these names too: the start menu
# looks for "start-here", about windows for "distributor-logo".
ICON_ALIASES := start-here distributor-logo

%:
	dh $@

override_dh_auto_build:
	@for f in $(LOGO_DARK) $(LOGO_LIGHT); do \
		if [ ! -f "$$f" ]; then \
			echo "ERROR: $$f is missing."; \
			echo "The logos live under assets/logo/ at the repo root and are"; \
			echo "copied into the package tree at build time. To build:"; \
			echo "    tools/build-packages.sh kavis-theme"; \
			exit 1; \
		fi; \
	done

override_dh_auto_install:
	# --- GTK3 / GTK2 / Openbox theme ------------------------------------
	install -d $(THEME)/gtk-3.0 $(THEME)/gtk-2.0 $(THEME)/openbox-3
	# Only the dark theme is installed for now (the plan is two themes
	# — 2 Sep decision; the light theme comes with Settings, Grup F).
	# The same file is installed as both gtk.css and gtk-dark.css;
	# gtk-light.css is NOT installed until then (kept in the repo as
	# source).
	install -m644 src/gtk-3.0/gtk-dark.css $(THEME)/gtk-3.0/gtk.css
	install -m644 src/gtk-3.0/gtk-dark.css $(THEME)/gtk-3.0/gtk-dark.css
	# Light theme (madde 38): Settings > Appearance switches to
	# Net/ThemeName=Kavis-Light through xsettingsd. gtk-dark.css is
	# deliberately ABSENT — the dark variant must not leak to a user
	# who chose the light theme.
	install -d $(DEST)/usr/share/themes/Kavis-Light/gtk-3.0
	install -m644 src/gtk-3.0/gtk-light.css \
		$(DEST)/usr/share/themes/Kavis-Light/gtk-3.0/gtk.css
	printf '[Desktop Entry]\nType=X-GNOME-Metatheme\nName=Kavis-Light\n' \
		> $(DEST)/usr/share/themes/Kavis-Light/index.theme
	install -m644 src/gtk-2.0/gtkrc        $(THEME)/gtk-2.0/gtkrc
	install -m644 src/openbox-3/themerc    $(THEME)/openbox-3/themerc
	# Light openbox theme (B2): the same themerc with the colors mapped
	# to the light palette (tasarim-dili.md table); Settings changes the
	# theme name in rc.xml and calls openbox --reconfigure.
	install -d $(DEST)/usr/share/themes/Kavis-Light/openbox-3
	sed -e 's/#17222C/#FFFFFF/g' -e 's/#121C26/#E9EDF1/g' \
	    -e 's/#233A45/#D5DBE1/g' -e 's/#E6EDF3/#1A2430/g' \
	    -e 's/#8B9BA8/#5C6B78/g' -e 's/#2E3842/#E6EAEE/g' \
	    -e 's/#374149/#DCE1E6/g' -e 's/#2A333C/#E6EAEE/g' \
	    -e 's/#333D47/#DCE1E6/g' -e 's/#6E8A92/#A0ACB8/g' \
	    -e 's/#3C4E5A/#C0C8D0/g' -e 's/#55677A/#A0ACB8/g' \
	    -e 's/#0D141B/#0D141B/g' \
	    src/openbox-3/themerc \
	    > $(DEST)/usr/share/themes/Kavis-Light/openbox-3/themerc
	install -m644 src/openbox-3/*.xbm \
	    $(DEST)/usr/share/themes/Kavis-Light/openbox-3/
	# Thin title-button icons (sonraki-isler 3): — ☐ ✕ and restore;
	# openbox finds them by name in the theme directory.
	install -m644 src/openbox-3/*.xbm      $(THEME)/openbox-3/
	install -m644 src/index.theme          $(THEME)/index.theme

	# --- System-wide defaults -------------------------------------------
	install -d $(DEST)/etc/gtk-3.0 $(DEST)/etc/gtk-2.0
	install -m644 src/settings.ini $(DEST)/etc/gtk-3.0/settings.ini
	# Nemo defaults (madde 39): gsettings override — no code patch.
	# glib's dpkg trigger compiles the schemas itself; postinst has a
	# safeguard too.
	install -d $(DEST)/usr/share/glib-2.0/schemas
	install -m644 src/glib-2.0/zz-kavis.gschema.override \
		$(DEST)/usr/share/glib-2.0/schemas/zz-kavis.gschema.override

	# System sounds (sonraki-isler 6b): no blob enters the repo — the
	# script synthesizes them at build (pure stdlib sine, no license).
	# freedesktop sound theme names: GTK apps use them by themselves.
	install -d $(DEST)/usr/share/sounds/kavis/stereo
	python3 ../../tools/gen-system-sounds.py \
		$(DEST)/usr/share/sounds/kavis/stereo
	printf '[Sound Theme]\nName=Kavis\nDirectories=stereo\n\n[stereo]\nOutputProfile=stereo\n' \
		> $(DEST)/usr/share/sounds/kavis/index.theme
	printf 'gtk-theme-name="Kavis"\ngtk-icon-theme-name="Kavis"\ngtk-font-name="DejaVu Sans 10"\n' \
		> $(DEST)/etc/gtk-2.0/gtkrc

	# --- Logos ------------------------------------------------------------
	# Applications (panel, about) read the logo from a fixed path,
	# choosing by theme. The file names are identical to those under
	# assets/.
	install -d $(SHARE)/logo
	install -m644 $(LOGO_DARK) $(SHARE)/logo/koyu-k-logo.svg
	install -m644 $(LOGO_LIGHT) $(SHARE)/logo/acik-k-logo.svg
	# GRUB background: always the dark logo, flat ground (madde 1).
	# 9600-grub-branding.hook.binary copies it into the ISO's GRUB.
	python3 tools/gen-wallpapers.py --grub $(SHARE)/logo/grub-background.png
	# GRUB gfxmenu theme assets (test8 H1): the teal rounded box of the
	# selected entry (9 slices) + class icons; the 9600 hook copies them.
	python3 tools/gen-grub-theme.py $(SHARE)/logo/grub-theme

	# --- Icon theme -------------------------------------------------------
	install -d $(ICONS)/scalable/apps
	install -m644 $(LOGO_DARK) $(ICONS)/scalable/apps/kavis.svg
	set -e; for s in $(ICON_SIZES); do \
		install -d $(ICONS)/$${s}x$${s}/apps; \
		rsvg-convert -w $$s -h $$s -o $(ICONS)/$${s}x$${s}/apps/kavis.png $(LOGO_DARK); \
	done
	set -e; for a in $(ICON_ALIASES); do \
		ln -sf kavis.svg $(ICONS)/scalable/apps/$$a.svg; \
		for s in $(ICON_SIZES); do \
			ln -sf kavis.png $(ICONS)/$${s}x$${s}/apps/$$a.png; \
		done; \
	done
	# Kavis apps with a glyph of their own (feedback G1: the task
	# manager's teal column chart — the stock utilities-system-monitor
	# is a green heartbeat that belongs to no palette of ours). Same
	# structure as the logo: one SVG source, rendered to every size.
	set -e; for f in src/icons/*.svg; do \
		n=$$(basename $$f .svg); \
		install -m644 $$f $(ICONS)/scalable/apps/$$n.svg; \
		for s in $(ICON_SIZES); do \
			rsvg-convert -w $$s -h $$s \
				-o $(ICONS)/$${s}x$${s}/apps/$$n.png $$f; \
		done; \
	done
	{ \
		echo "[Icon Theme]"; \
		echo "Name=Kavis"; \
		echo "Comment=Kavis icons"; \
		echo "Inherits=Papirus-Dark,Adwaita,hicolor"; \
		printf "Directories=scalable/apps"; \
		for s in $(ICON_SIZES); do printf ",%sx%s/apps" $$s $$s; done; \
		echo ""; \
		echo ""; \
		echo "[scalable/apps]"; \
		echo "Size=48"; echo "MinSize=8"; echo "MaxSize=512"; \
		echo "Context=Applications"; echo "Type=Scalable"; \
		for s in $(ICON_SIZES); do \
			echo ""; \
			echo "[$${s}x$${s}/apps]"; \
			echo "Size=$$s"; echo "Context=Applications"; echo "Type=Fixed"; \
		done; \
	} > $(ICONS)/index.theme

	# --- Cursor theme -----------------------------------------------------
	install -d $(CURSORS)/cursors
	python3 tools/gen-cursors.py $(CURSORS)/cursors
	printf '[Icon Theme]\nName=Kavis\nComment=Kavis cursors\nInherits=Adwaita\n' \
		> $(CURSORS)/index.theme
	cp $(CURSORS)/index.theme $(CURSORS)/cursor.theme

	# --- Wallpapers -------------------------------------------------------
	install -d $(WALL)
	python3 tools/gen-wallpapers.py $(WALL)

	# --- Distribution identity --------------------------------------------
	# /etc/os-release is a link to /usr/lib/os-release. We take the file
	# over from base-files with dpkg-divert (see debian/preinst).
	install -d $(DEST)/usr/lib
	install -m644 src/os-release $(DEST)/usr/lib/os-release
