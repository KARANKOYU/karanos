#!/bin/sh
# Undo the os-release diversion. We do this in postrm because our file
# must be deleted first — otherwise base-files' original cannot be
# moved back.
set -e

DIVERTED=/usr/lib/os-release
ORIGINAL=/usr/lib/os-release.debian

case "$1" in
remove | purge | disappear)
	if dpkg-divert --list "$DIVERTED" | grep -q kavis-theme; then
		dpkg-divert --package kavis-theme --remove --rename \
			--divert "$ORIGINAL" "$DIVERTED"
	fi
	;;
esac

#DEBHELPER#

exit 0
