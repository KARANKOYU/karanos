#!/bin/sh
# /etc/os-release is a symlink to /usr/lib/os-release, owned by the
# base-files package. Putting a file on top would make dpkg report a
# file conflict. The right way is dpkg-divert: base-files' file is set
# aside with the .debian suffix, ours takes its place, and the original
# comes back when the package is removed.
set -e

DIVERTED=/usr/lib/os-release
ORIGINAL=/usr/lib/os-release.debian

case "$1" in
install | upgrade)
	if ! dpkg-divert --list "$DIVERTED" | grep -q kavis-theme; then
		dpkg-divert --package kavis-theme --add --rename \
			--divert "$ORIGINAL" "$DIVERTED"
	fi
	;;
esac

#DEBHELPER#

exit 0
