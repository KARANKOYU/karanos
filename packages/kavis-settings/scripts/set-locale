#!/bin/sh
# Kavis — set the system language (Settings > Keyboard and Language, B6).
# Runs as root via pkexec (polkit: org.kavis.settings.set-locale). Single
# job: /etc/default/locale + /etc/locale.gen + locale-gen. The user side
# (kavis.conf, ~/.config/kavis/locale, .xsessionrc) is in Settings itself.
set -eu

locale="${1:-}"
case "$locale" in
	[a-z][a-z]_[A-Z][A-Z].UTF-8|[a-z][a-z][a-z]_[A-Z][A-Z].UTF-8) ;;
	*) echo "set-locale: invalid locale: $locale" >&2; exit 2 ;;
esac

printf 'LANG=%s\n' "$locale" > /etc/default/locale

# locale.gen: uncomment the line if present, else add it; locale-gen only
# builds the listed ones (en_US + tr_TR are ready on the ISO — rebuilding
# is cheap).
if grep -q "^# *$locale UTF-8" /etc/locale.gen 2>/dev/null; then
	sed -i "s/^# *$locale UTF-8/$locale UTF-8/" /etc/locale.gen
elif ! grep -q "^$locale UTF-8" /etc/locale.gen 2>/dev/null; then
	printf '%s UTF-8\n' "$locale" >> /etc/locale.gen
fi
locale-gen >/dev/null 2>&1 || locale-gen "$locale"
echo "set-locale: $locale ready"
