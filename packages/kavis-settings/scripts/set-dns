#!/bin/sh
# Kavis — encrypted DNS (item 52). The root half of Settings > Network.
#
# Writes a systemd-resolved drop-in choosing a resolver and turning on
# DNS over TLS. A drop-in, never an edit of resolved.conf: that file is
# a package conffile and editing it makes every upgrade ask a question.
#
# NAMING, deliberately: this is DNS over TLS, not DNS over HTTPS.
# systemd-resolved does not speak DoH, and adding a DoH proxy would be a
# second resolver process on a system that already has one. Both encrypt
# the query to the resolver; the interface says TLS because that is what
# actually happens.
#
# Providers are the three the feedback named, with their DoT hostnames —
# the hostname matters, it is what the certificate is checked against.
set -eu

# --- Host guard (same rule as set-power) ------------------------------
# Writes /etc/systemd and restarts a system service. It may only run on
# a booted Kavis system: systemd actually running the machine excludes
# the dev container and the live-build chroot, and the build marker
# tells a Kavis system from a Debian one this script was copied onto.
if [ ! -d /run/systemd/system ]; then
	echo "E: $0 needs a booted systemd system — refusing (test in a VM)" >&2
	exit 3
fi
if [ ! -f /usr/share/kavis/build-marker ]; then
	echo "E: $0 runs only on a Kavis system (marker missing)" >&2
	exit 3
fi

DROPIN=/etc/systemd/resolved.conf.d/50-kavis-dns.conf

case "${1:-}" in
off)
	rm -f "$DROPIN"
	;;
cloudflare)
	servers="1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com 2606:4700:4700::1111#cloudflare-dns.com"
	;;
google)
	servers="8.8.8.8#dns.google 8.8.4.4#dns.google 2001:4860:4860::8888#dns.google"
	;;
quad9)
	servers="9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net"
	;;
*)
	echo "usage: set-dns off|cloudflare|google|quad9" >&2
	exit 2
	;;
esac

if [ "${1}" != "off" ]; then
	mkdir -p /etc/systemd/resolved.conf.d
	cat > "$DROPIN" <<CONF
# Written by Kavis Settings > Network > DNS privacy. Edit there.
[Resolve]
DNS=$servers
# opportunistic, not yes: with "yes" a resolver that cannot do TLS
# leaves the machine with no working DNS at all, which looks like the
# network is broken. Opportunistic uses TLS whenever the server offers
# it and still resolves when it does not.
DNSOverTLS=opportunistic
Domains=~.
CONF
fi

systemctl restart systemd-resolved 2>/dev/null || true
echo "set-dns: ${1}"
