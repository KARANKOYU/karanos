#!/usr/bin/make -f
# Kavis Settings — single binary from Vala sources (madde 9).
# appinit.vala comes from the canonical copy (packages/kavis-common —
# placed by build-packages.sh). Translations come from the gettext
# "kavis" domain; kavis-panel ships the .mo files (Depends).

export DH_VERBOSE = 1

DEST := debian/kavis-settings

VALA_PKGS := --pkg gtk+-3.0 --pkg posix
# -lm: sunclock.vala computes sunrise and sunset with trigonometry,
# which lives in libm and gcc does not link it by default.
VALA_CFLAGS := -X -O2 -X -w -X -DGETTEXT_PACKAGE='"kavis"' -X -lm

SOURCES := $(wildcard src/*.vala) $(wildcard src/ui/*.vala) \
             $(wildcard src/logic/*.vala)

%:
	dh $@

override_dh_auto_build:
	valac $(VALA_PKGS) $(VALA_CFLAGS) -o kavis-settings $(SOURCES)

override_dh_auto_install:
	install -d $(DEST)/usr/bin
	install -m755 kavis-settings $(DEST)/usr/bin/kavis-settings
	install -d $(DEST)/usr/share/applications
	install -m644 desktop/kavis-settings.desktop \
		$(DEST)/usr/share/applications/kavis-settings.desktop
	# System language (B6): root helper + polkit permission (active user
	# without password; the pkexec path is pinned via annotate).
	install -d $(DEST)/usr/lib/kavis $(DEST)/usr/share/polkit-1/actions
	install -m755 scripts/set-locale $(DEST)/usr/lib/kavis/set-locale
	# Power (item 51): CPU governor/EPP and the lid action are root-only.
	install -m755 scripts/set-power $(DEST)/usr/lib/kavis/set-power
	# Encrypted DNS (item 52): a systemd-resolved drop-in, root-only.
	install -m755 scripts/set-dns $(DEST)/usr/lib/kavis/set-dns
	install -m644 polkit/org.kavis.settings.policy \
		$(DEST)/usr/share/polkit-1/actions/org.kavis.settings.policy

override_dh_auto_clean:
	rm -f kavis-settings
	dh_auto_clean
