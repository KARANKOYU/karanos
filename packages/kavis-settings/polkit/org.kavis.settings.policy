<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <!-- Kavis Ayarlar: sistem dili (B6). Oturumdaki etkin kullanıcı
       parola girmeden değiştirir — tek kullanıcılı ürün, işlem geri
       alınabilir ve veri kaybettirmez. -->
  <action id="org.kavis.settings.set-locale">
    <description>Change the system language</description>
    <message>Authentication is required to change the system language</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/kavis/set-locale</annotate>
  </action>
</policyconfig>
