<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <!-- Kavis Settings: system language (B6). The active session user
       changes it without a password — single-user product, the action
       is reversible and loses no data. -->
  <action id="org.kavis.settings.set-locale">
    <description>Change the system language</description>
    <message>Authentication is required to change the system language</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/kavis/set-locale</annotate>
  </action>

  <!-- Kavis Settings: power behaviour (item 51). Same reasoning as the
       language action: the active local user of a single-user product
       changes their own machine's CPU governor and lid behaviour
       without a password. Both are reversible and lose no data. -->
  <action id="org.kavis.settings.set-power">
    <description>Change power behaviour</description>
    <message>Authentication is required to change power behaviour</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/kavis/set-power</annotate>
  </action>

  <!-- Kavis Settings: encrypted DNS (item 52). Choosing a resolver is
       reversible and loses no data; the active local user does it
       without a password, like the other two. -->
  <action id="org.kavis.settings.set-dns">
    <description>Change the DNS resolver</description>
    <message>Authentication is required to change the DNS resolver</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/kavis/set-dns</annotate>
  </action>

  <!-- Kavis Settings: hardware report (item 50). A read-only helper —
       SMART health needs the raw device, nothing is written. -->
  <action id="org.kavis.settings.hw-report">
    <description>Read hardware health information</description>
    <message>Authentication is required to read disk health information</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/kavis/hw-report</annotate>
  </action>
</policyconfig>
