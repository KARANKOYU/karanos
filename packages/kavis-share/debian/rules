#!/usr/bin/make -f
# kavis-share — Vala; libsoup3 for HTTP, json-glib for the wire format,
# GIO's own sockets for the multicast announcement (no extra dependency
# for the part that is just a UDP datagram).
export DH_VERBOSE = 1

DEST := debian/kavis-share

VALA_PKGS := --pkg gtk+-3.0 --pkg libsoup-3.0 --pkg json-glib-1.0 \
                 --pkg gio-2.0 --pkg posix
VALA_CFLAGS := -X -O2 -X -w -X -DGETTEXT_PACKAGE='"kavis"'

SOURCES := $(wildcard src/*.vala)

%:
	dh $@

override_dh_auto_build:
	valac $(VALA_PKGS) $(VALA_CFLAGS) -o kavis-share $(SOURCES)

override_dh_auto_install:
	install -d $(DEST)/usr/bin $(DEST)/etc/xdg/autostart
	install -m755 kavis-share $(DEST)/usr/bin/kavis-share
	# Started with the session, not by systemd: it belongs to the
	# person who is logged in, it draws a dialog, and it must stop
	# when they log out.
	install -m644 desktop/kavis-share.desktop \
		$(DEST)/etc/xdg/autostart/kavis-share.desktop

override_dh_auto_clean:
	rm -f kavis-share
