// Kavis — fastfetch yapılandırması (madde 71). `kavisfetch` ve düz
// `fastfetch` (/etc/fastfetch/config.jsonc bağı) aynı dosyayı okur.
// Logo: /etc/kavis/fastfetch/logo-{dark,light}.txt — kavisfetch temaya
// göre seçer; düz fastfetch koyu logoyu alır.
// OS satırı /etc/os-release'ten gelir; DE satırındaki ad derlemede aynı
// dosyadan işlenir (config.jsonc.in → config.jsonc, marka kuralı).
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/etc/kavis/fastfetch/logo-dark.txt",
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;45;212;191", "title": "38;2;45;212;191" }
    },
    "modules": [
        "title",
        "separator",
        { "type": "os", "key": "OS", "format": "{3}" },
        { "type": "host", "key": "Host" },
        { "type": "kernel", "key": "Kernel" },
        { "type": "uptime", "key": "Uptime" },
        { "type": "packages", "key": "Packages" },
        { "type": "shell", "key": "Shell" },
        { "type": "display", "key": "Display" },
        // DE: fastfetch bilinmeyen masaüstünü yazmıyor; ad derlemede
        // os-release NAME'den (@AD@) işlenir — marka kuralı korunur.
        { "type": "custom", "key": "DE", "format": "@AD@ (Openbox)" },
        { "type": "theme", "key": "Theme" },
        { "type": "icons", "key": "Icons" },
        { "type": "font", "key": "Font" },
        { "type": "terminal", "key": "Terminal" },
        { "type": "cpu", "key": "CPU" },
        { "type": "gpu", "key": "GPU" },
        { "type": "memory", "key": "Memory" },
        { "type": "swap", "key": "Swap" },
        { "type": "disk", "key": "Disk", "folders": "/" },
        "break",
        "colors"
    ]
}
