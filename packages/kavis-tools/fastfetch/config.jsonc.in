// Kavis — fastfetch configuration (madde 71). `kavisfetch` and plain
// `fastfetch` (/etc/fastfetch/config.jsonc link) read the same file.
// Logo: /etc/kavis/fastfetch/logo-{dark,light}.txt — kavisfetch picks
// by theme; plain fastfetch gets the dark logo.
// The OS line comes from /etc/os-release; the name on the DE line is
// substituted at build time from the same file (config.jsonc.in →
// config.jsonc, brand rule).
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/etc/kavis/fastfetch/logo-dark.txt",
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;45;212;191", "title": "38;2;45;212;191" }
    },
    "modules": [
        "title",
        "separator",
        { "type": "os", "key": "OS", "format": "{3}" },
        { "type": "host", "key": "Host" },
        { "type": "kernel", "key": "Kernel" },
        { "type": "uptime", "key": "Uptime" },
        { "type": "packages", "key": "Packages" },
        { "type": "shell", "key": "Shell" },
        { "type": "display", "key": "Display" },
        // DE: fastfetch does not print an unknown desktop; the name is
        // substituted at build time from os-release NAME (@NAME@) — the
        // brand rule is preserved.
        { "type": "custom", "key": "DE", "format": "@NAME@ (Openbox)" },
        { "type": "theme", "key": "Theme" },
        { "type": "icons", "key": "Icons" },
        { "type": "font", "key": "Font" },
        { "type": "terminal", "key": "Terminal" },
        { "type": "cpu", "key": "CPU" },
        { "type": "gpu", "key": "GPU" },
        { "type": "memory", "key": "Memory" },
        { "type": "swap", "key": "Swap" },
        { "type": "disk", "key": "Disk", "folders": "/" },
        "break",
        "colors"
    ]
}
