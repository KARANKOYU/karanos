#!/bin/sh
# Kavis — system summary (madde 71): fastfetch with the Kavis configuration.
# Runs only by hand; NOT hooked into terminal startup (it slows it down).
# Logo color follows the theme: teal #2DD4BF on dark, darkened teal
# #0D9488 on light (tasarim-dili.md light palette rule).
conf="${XDG_CONFIG_HOME:-$HOME/.config}/kavis/kavis.conf"
logo=/etc/kavis/fastfetch/logo-dark.txt
color="38;2;45;212;191"
if [ -r "$conf" ] && grep -q '^theme=light' "$conf" 2>/dev/null; then
	logo=/etc/kavis/fastfetch/logo-light.txt
	color="38;2;13;148;136"
fi
exec fastfetch --config /etc/kavis/fastfetch/config.jsonc \
	--logo "$logo" --logo-type file --logo-color-1 "$color" "$@"
