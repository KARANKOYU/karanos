#!/usr/bin/make -f
# Kavis küçük araçları — Vala kaynağından tek ikili (madde 7).
# appinit.vala kanonik kopyadan gelir (packages/kavis-common —
# build-packages.sh koyar). Çeviriler gettext "kavis" alanından;
# .mo dosyalarını kavis-panel taşır (Depends).

export DH_VERBOSE = 1

DEST := debian/kavis-tools

# gstreamer-1.0: hızlı önizlemenin video/ses oynatıcısı (madde 36).
VALA_PAKETLER := --pkg gtk+-3.0 --pkg libwnck-3.0 --pkg gdk-x11-3.0 \
                 --pkg posix --pkg gstreamer-1.0
VALA_CFLAGS := -X -DWNCK_I_KNOW_THIS_IS_UNSTABLE -X -O2 -X -w -X -lm \
               -X -DGETTEXT_PACKAGE='"kavis"'

KAYNAKLAR := $(wildcard src/*.vala)

%:
	dh $@

override_dh_auto_build:
	valac $(VALA_PAKETLER) $(VALA_CFLAGS) -o kavis-tools $(KAYNAKLAR)

override_dh_auto_install:
	install -d $(DEST)/usr/bin
	install -m755 kavis-tools $(DEST)/usr/bin/kavis-tools
	install -d $(DEST)/usr/share/applications
	install -d $(DEST)/usr/share/nemo/actions
	install -m644 desktop/kavis-open-with.nemo_action \
		$(DEST)/usr/share/nemo/actions/kavis-open-with.nemo_action
	# Madde 39 sağ tık maddeleri: yolu kopyala + masaüstüne kısayol.
	install -m644 desktop/kavis-copy-path.nemo_action \
		$(DEST)/usr/share/nemo/actions/kavis-copy-path.nemo_action
	install -m644 desktop/kavis-send-desktop.nemo_action \
		$(DEST)/usr/share/nemo/actions/kavis-send-desktop.nemo_action
	install -m644 desktop/kavis-preview.nemo_action \
		$(DEST)/usr/share/nemo/actions/kavis-preview.nemo_action
	# "Editörde aç" (madde 39/40): kate kurulu değilse menüde çıkmaz
	# (Dependencies satırı) — kavis-tools kate'e bağımlı DEĞİL.
	install -m644 desktop/kavis-open-editor.nemo_action \
		$(DEST)/usr/share/nemo/actions/kavis-open-editor.nemo_action
	install -d $(DEST)/usr/lib/kavis
	install -m755 scripts/nemo-action $(DEST)/usr/lib/kavis/nemo-action
	# Boşluk tuşu önizlemesi (madde 36): nemo org.nemo.Preview'u
	# çağırır, bu servis dosyası bizim önizleyiciyi otomatik başlatır.
	install -d $(DEST)/usr/share/dbus-1/services
	install -m644 desktop/org.nemo.Preview.service \
		$(DEST)/usr/share/dbus-1/services/org.nemo.Preview.service
	install -m644 desktop/kavis-tasks.desktop \
		$(DEST)/usr/share/applications/kavis-tasks.desktop
	install -m644 desktop/kavis-calc.desktop \
		$(DEST)/usr/share/applications/kavis-calc.desktop
	install -m644 desktop/kavis-emoji.desktop \
		$(DEST)/usr/share/applications/kavis-emoji.desktop

override_dh_auto_clean:
	rm -f kavis-tools
	dh_auto_clean
