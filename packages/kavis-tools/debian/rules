#!/usr/bin/make -f
# Kavis small tools — single binary from Vala sources (madde 7).
# appinit.vala comes from the canonical copy (packages/kavis-common —
# placed by build-packages.sh). Translations come from the gettext
# "kavis" domain; kavis-panel ships the .mo files (Depends).

export DH_VERBOSE = 1

DEST := debian/kavis-tools

# gstreamer-1.0: the quick preview's video/audio player (madde 36).
VALA_PKGS := --pkg gtk+-3.0 --pkg libwnck-3.0 --pkg gdk-x11-3.0 \
                 --pkg posix --pkg gstreamer-1.0 --pkg gio-unix-2.0
VALA_CFLAGS := -X -DWNCK_I_KNOW_THIS_IS_UNSTABLE -X -O2 -X -w -X -lm \
               -X -DGETTEXT_PACKAGE='"kavis"'

SOURCES := $(wildcard src/*.vala)

%:
	dh $@

override_dh_auto_build:
	valac $(VALA_PKGS) $(VALA_CFLAGS) -o kavis-tools $(SOURCES)

override_dh_auto_install:
	install -d $(DEST)/usr/bin
	install -m755 kavis-tools $(DEST)/usr/bin/kavis-tools
	install -d $(DEST)/usr/share/applications
	install -d $(DEST)/usr/share/nemo/actions
	install -m644 desktop/kavis-open-with.nemo_action \
		$(DEST)/usr/share/nemo/actions/kavis-open-with.nemo_action
	# Madde 39 right-click items: copy path + shortcut to desktop.
	install -m644 desktop/kavis-copy-path.nemo_action \
		$(DEST)/usr/share/nemo/actions/kavis-copy-path.nemo_action
	install -m644 desktop/kavis-send-desktop.nemo_action \
		$(DEST)/usr/share/nemo/actions/kavis-send-desktop.nemo_action
	install -m644 desktop/kavis-preview.nemo_action \
		$(DEST)/usr/share/nemo/actions/kavis-preview.nemo_action
	# "Open in editor" (madde 39/40): hidden from the menu when kate is
	# not installed (Dependencies line) — kavis-tools does NOT depend on kate.
	install -m644 desktop/kavis-open-editor.nemo_action \
		$(DEST)/usr/share/nemo/actions/kavis-open-editor.nemo_action
	install -d $(DEST)/usr/lib/kavis
	install -m755 scripts/nemo-action $(DEST)/usr/lib/kavis/nemo-action
	# Space-bar preview (madde 36): nemo calls org.nemo.Preview; this
	# service file auto-starts our previewer.
	install -d $(DEST)/usr/share/dbus-1/services
	install -m644 desktop/org.nemo.Preview.service \
		$(DEST)/usr/share/dbus-1/services/org.nemo.Preview.service
	install -m644 desktop/kavis-tasks.desktop \
		$(DEST)/usr/share/applications/kavis-tasks.desktop
	install -m644 desktop/kavis-calc.desktop \
		$(DEST)/usr/share/applications/kavis-calc.desktop
	install -m644 desktop/kavis-emoji.desktop \
		$(DEST)/usr/share/applications/kavis-emoji.desktop
	# Taskbar identity of the power dialog (2C): NoDisplay — not in
	# the menu, only for the WM_CLASS→icon match.
	install -m644 desktop/kavis-power.desktop \
		$(DEST)/usr/share/applications/kavis-power.desktop
	# fastfetch (madde 71): Kavis configuration + K logo; the
	# /etc/fastfetch link lets plain `fastfetch` find the same file.
	install -d $(DEST)/etc/kavis/fastfetch $(DEST)/etc/fastfetch
	NAME=$$(. fastfetch/os-release && printf '%s' "$$NAME"); \
	[ -n "$$NAME" ] || { echo "ERROR: os-release NAME is empty"; exit 1; }; \
	sed "s/@NAME@/$$NAME/" fastfetch/config.jsonc.in > $(DEST)/etc/kavis/fastfetch/config.jsonc
	install -m644 fastfetch/logo-dark.txt $(DEST)/etc/kavis/fastfetch/logo-dark.txt
	install -m644 fastfetch/logo-light.txt $(DEST)/etc/kavis/fastfetch/logo-light.txt
	ln -s /etc/kavis/fastfetch/config.jsonc $(DEST)/etc/fastfetch/config.jsonc
	install -m755 scripts/kavisfetch $(DEST)/usr/bin/kavisfetch
	# Templates for the file manager's "New file" menu (feedback H2/H3).
	# XDG_TEMPLATES_DIR points here (0031-kavis-dirs), so the home
	# directory keeps its six lower-case folders and the templates stay
	# read-only. The three OOXML files are generated: ZIP containers do
	# not belong in git.
	install -d $(DEST)/usr/share/kavis/templates
	install -m644 templates/* $(DEST)/usr/share/kavis/templates/
	chmod 755 $(DEST)/usr/share/kavis/templates/"Shell Script.sh"
	python3 tools/gen-office-templates.py \
		$(DEST)/usr/share/kavis/templates

override_dh_auto_clean:
	rm -f kavis-tools
	dh_auto_clean
