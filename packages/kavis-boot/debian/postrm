#!/bin/sh
# Return Plymouth to Debian's default when the theme is removed; otherwise
# a configuration pointing at a nonexistent theme remains and the splash
# never shows at boot.
set -e

case "$1" in
remove | purge)
	if command -v plymouth-set-default-theme >/dev/null 2>&1; then
		plymouth-set-default-theme --reset >/dev/null 2>&1 || true
	fi
	if command -v update-initramfs >/dev/null 2>&1; then
		update-initramfs -u || true
	fi
	;;
esac

#DEBHELPER#

exit 0
