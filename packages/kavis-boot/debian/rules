#!/usr/bin/make -f
# Kavis açılış ekranı paketi
#
# Dışarıdan gelen kaynaklar (koyu-k-logo.svg, boot-sound.mp3, os-release)
# paket ağacına tools/build-packages.sh tarafından kopyalanıyor; asılları
# assets/ ve packages/kavis-theme/ altında duruyor.

export DH_VERBOSE = 1

LOGO   := src/boot/koyu-k-logo.svg
SES    := src/boot/boot-sound.mp3
OSREL  := src/boot/os-release
DEST   := debian/kavis-boot
TEMA   := $(DEST)/usr/share/plymouth/themes/kavis
VARLIK := $(DEST)/usr/share/kavis/boot

%:
	dh $@

override_dh_auto_build:
	@for f in $(LOGO) $(SES) $(OSREL); do \
		if [ ! -f "$$f" ]; then \
			echo "HATA: $$f yok."; \
			echo "Kaynaklar depo agacinda baska yerde duruyor ve paket"; \
			echo "agacina derleme sirasinda kopyalaniyor. Derlemek icin:"; \
			echo "    tools/build-packages.sh kavis-boot"; \
			exit 1; \
		fi; \
	done

override_dh_auto_install:
	# --- Plymouth teması ---------------------------------------------
	install -d $(TEMA)
	install -m644 src/kavis.plymouth $(TEMA)/kavis.plymouth
	install -m644 src/kavis.script   $(TEMA)/kavis.script

	# Madde 30: splash'te HER ZAMAN koyu logo; fotoğraf yok.
	rsvg-convert -w 512 -h 512 -o $(TEMA)/logo.png $(LOGO)

	# Yazılar: Plymouth bitmap font kullandığı için metinler burada
	# PNG'ye çevriliyor — açılışta yazı tipi bağımlılığı kalmıyor,
	# sonuç her makinede aynı.
	rsvg-convert -w 800 -o $(TEMA)/made-by-karan.png src/made-by-karan.svg
	rsvg-convert -w 900 -o $(TEMA)/acilis-ipuclari.png src/acilis-ipuclari.svg
	# G (v0.4-test1): "Starting…" yanında dönen halka — 8 kare, script
	# 12 px'e ölçekler. Kareler derlemede üretilir (depoya ikili girmez).
	python3 tools/gen-spinner.py debian/spinner
	set -e; for n in 0 1 2 3 4 5 6 7; do \
		rsvg-convert -w 48 -h 48 -o $(TEMA)/spinner-$$n.png debian/spinner/spinner-$$n.svg; \
	done
	rm -rf debian/spinner

	# Ürün adı tek kaynaktan: os-release NAME değeri Türkçe kurallarla
	# büyük harfe çevrilir (i→İ; Python'un upper()'ı bunu bilmez) ve
	# şablona işlenir. Ad hiçbir kaynak dosyada sabit yazılı değil.
	AD=$$(. $(OSREL) && printf '%s' "$$NAME" \
		| python3 -c 'import sys; s=sys.stdin.read(); print(s.translate(str.maketrans("iı","İI")).upper(), end="")'); \
	[ -n "$$AD" ] || { echo "HATA: os-release NAME bos"; exit 1; }; \
	sed "s/@AD@/$$AD/" src/urun-adi.svg.in > debian/urun-adi.svg
	rsvg-convert -w 800 -o $(TEMA)/urun-adi.png debian/urun-adi.svg
	rm -f debian/urun-adi.svg

	# --- Gömülü kaynaklar (yalnızca root yazabilir) ------------------
	install -d $(VARLIK)

	# Müzik WAV olarak gömülüyor. Sebep iki tane:
	#   1. Sonuna 0,4 saniyelik fade-out ekleniyor — bölüm 5 "görsel ve
	#      ses birlikte yumuşakça söner" diyor, mp3 çalarların çoğunda
	#      fade yok.
	#   2. Açılışta mp3 çözücüye gerek kalmıyor; aplay (alsa-utils)
	#      yetiyor, açılış birkaç yüz milisaniye erken başlıyor.
	# Bedeli ~1 MB ISO alanı; 1,5 GB hedefinde sorun değil.
	ffmpeg -nostdin -loglevel error -y -i $(SES) \
		-af "afade=t=out:st=$$(ffprobe -v error -show_entries format=duration \
			-of default=noprint_wrappers=1:nokey=1 $(SES) \
			| awk '{printf "%.3f", ($$1 > 0.4) ? $$1 - 0.4 : 0}'):d=0.4" \
		-ar 44100 -ac 2 -c:a pcm_s16le \
		$(VARLIK)/boot-sound.wav
	chmod 644 $(VARLIK)/boot-sound.wav

	# --- Açılış davranışı ayarları (madde 30) ------------------------
	# dh, /etc altındaki dosyayı kendiliğinden conffile yapar; kullanıcı
	# değişikliği paket güncellemesinde ezilmez.
	install -d $(DEST)/etc/kavis
	install -m644 src/boot.conf $(DEST)/etc/kavis/boot.conf

	# --- Ses servisi --------------------------------------------------
	install -d $(DEST)/usr/lib/kavis
	install -m755 src/boot-sound $(DEST)/usr/lib/kavis/boot-sound
	install -d $(DEST)/lib/systemd/system
	install -m644 src/kavis-boot-sound.service \
		$(DEST)/lib/systemd/system/kavis-boot-sound.service

	# plymouth-quit ve plymouth-quit-wait ses servisini beklesin
	install -d $(DEST)/lib/systemd/system/plymouth-quit.service.d
	install -d $(DEST)/lib/systemd/system/plymouth-quit-wait.service.d
	install -m644 src/plymouth-quit-dropin.conf \
		$(DEST)/lib/systemd/system/plymouth-quit.service.d/kavis.conf
	# quit-wait için AYRI dosya: quit'inki ExecStart'ı değiştiriyor,
	# aynısını buraya koyarsak `plymouth --wait` komutunu ezer.
	install -m644 src/plymouth-quit-wait-dropin.conf \
		$(DEST)/lib/systemd/system/plymouth-quit-wait.service.d/kavis.conf

# Dosyalar zaten sıkıştırılmış biçimlerde (PNG, WAV); tekrar sıkıştırmak
# ISO'da bir şey kazandırmıyor, açılışta çözme maliyeti getiriyor.
override_dh_installsystemd:
	dh_installsystemd --name=kavis-boot-sound --no-start
