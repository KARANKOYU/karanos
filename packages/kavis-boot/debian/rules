#!/usr/bin/make -f
# Kavis açılış ekranı paketi
#
# Elle konulan iki kaynak (boot-image.png, boot-sound.mp3) paket ağacına
# tools/build-packages.sh tarafından kopyalanıyor; aslı assets/boot/
# altında duruyor.

export DH_VERBOSE = 1

GORSEL := src/boot/boot-image.png
SES    := src/boot/boot-sound.mp3
DEST   := debian/kavis-boot
TEMA   := $(DEST)/usr/share/plymouth/themes/kavis
VARLIK := $(DEST)/usr/share/kavis/boot

%:
	dh $@

override_dh_auto_build:
	@for f in $(GORSEL) $(SES); do \
		if [ ! -f "$$f" ]; then \
			echo "HATA: $$f yok."; \
			echo "Kaynaklar assets/boot/ altinda duruyor ve paket agacina"; \
			echo "derleme sirasinda kopyalaniyor. Derlemek icin:"; \
			echo "    tools/build-packages.sh kavis-boot"; \
			exit 1; \
		fi; \
	done

override_dh_auto_install:
	# --- Plymouth teması ---------------------------------------------
	install -d $(TEMA)
	install -m644 src/kavis.plymouth $(TEMA)/kavis.plymouth
	install -m644 src/kavis.script   $(TEMA)/kavis.script
	install -m644 $(GORSEL)            $(TEMA)/logo.png

	# İtalik yazı: Plymouth bitmap font kullandığı için italik
	# gösteremiyor. Yazıyı burada PNG'ye çeviriyoruz — açılışta yazı
	# tipi bağımlılığı kalmıyor, sonuç her makinede aynı.
	rsvg-convert -w 800 -o $(TEMA)/made-by-karan.png src/made-by-karan.svg

	# --- Gömülü kaynaklar (bölüm 5: yalnızca root yazabilir) ---------
	# Görselin aslı tema dizininde duruyor, buradaki bağ ona işaret
	# ediyor. Tersi de olurdu ama tema dizini initramfs'e olduğu gibi
	# kopyalanıyor; dışarı işaret eden bir bağ orada kırık kalırdı.
	# Bu yoldan 432 KB tasarruf ediliyor.
	install -d $(VARLIK)
	ln -sf ../../plymouth/themes/kavis/logo.png $(VARLIK)/boot-image.png

	# Müzik WAV olarak gömülüyor. Sebep iki tane:
	#   1. Sonuna 0,4 saniyelik fade-out ekleniyor — bölüm 5 "görsel ve
	#      ses birlikte yumuşakça söner" diyor, mp3 çalarların çoğunda
	#      fade yok.
	#   2. Açılışta mp3 çözücüye gerek kalmıyor; aplay (alsa-utils)
	#      yetiyor, açılış birkaç yüz milisaniye erken başlıyor.
	# Bedeli ~1 MB ISO alanı; 1,5 GB hedefinde sorun değil.
	ffmpeg -nostdin -loglevel error -y -i $(SES) \
		-af "afade=t=out:st=$$(ffprobe -v error -show_entries format=duration \
			-of default=noprint_wrappers=1:nokey=1 $(SES) \
			| awk '{printf "%.3f", ($$1 > 0.4) ? $$1 - 0.4 : 0}'):d=0.4" \
		-ar 44100 -ac 2 -c:a pcm_s16le \
		$(VARLIK)/boot-sound.wav
	chmod 644 $(VARLIK)/boot-sound.wav

	# --- Ses servisi --------------------------------------------------
	install -d $(DEST)/usr/lib/kavis
	install -m755 src/boot-sound $(DEST)/usr/lib/kavis/boot-sound
	install -d $(DEST)/lib/systemd/system
	install -m644 src/kavis-boot-sound.service \
		$(DEST)/lib/systemd/system/kavis-boot-sound.service

	# plymouth-quit ve plymouth-quit-wait ses servisini beklesin
	install -d $(DEST)/lib/systemd/system/plymouth-quit.service.d
	install -d $(DEST)/lib/systemd/system/plymouth-quit-wait.service.d
	install -m644 src/plymouth-quit-dropin.conf \
		$(DEST)/lib/systemd/system/plymouth-quit.service.d/kavis.conf
	# quit-wait için AYRI dosya: quit'inki ExecStart'ı değiştiriyor,
	# aynısını buraya koyarsak `plymouth --wait` komutunu ezer.
	install -m644 src/plymouth-quit-wait-dropin.conf \
		$(DEST)/lib/systemd/system/plymouth-quit-wait.service.d/kavis.conf

# Dosyalar zaten sıkıştırılmış biçimlerde (PNG, WAV); tekrar sıkıştırmak
# ISO'da bir şey kazandırmıyor, açılışta çözme maliyeti getiriyor.
override_dh_installsystemd:
	dh_installsystemd --name=kavis-boot-sound --no-start
