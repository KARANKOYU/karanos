#!/bin/sh
# Kavis — plays the boot music and holds the splash until the music ends
#
# WHY A SEPARATE SERVICE: Plymouth has no audio support (madde 30).
#
# WHY THIS HOLDS THE SPLASH: the service is Type=oneshot and the unit
# file has `Before=plymouth-quit.service`. Until the music ends the
# service counts as "starting", so plymouth-quit waits and the splash
# stays open. Even if the system is ready before the music, the splash
# waits — that is what madde 30 asks for. THE SINGLE EXCEPTION: the
# space key — when pressed the music stops and the splash starts fading
# at once (listened for with plymouth watch-keystroke).
#
# SETTINGS (/etc/kavis/boot.conf, the Settings app will write it later):
#   PLAY_MUSIC=0    → the music is never played, the splash does not wait
#   WAIT_FOR_MUSIC=0 → the music starts in the background, the splash does not wait
#
# WE WAIT FOR THE AUDIO DEVICE HERE, NOT IN systemd:
# If the unit waited with `After=sound.target`, on real hardware it slid
# far into the boot and could not hold the splash (in the VirtualBox
# test the music spilled into the desktop). The service starts early
# and we wait for the audio device here with a short, bounded loop.
#
# SAFETY NET: if the audio device never appears or playback hangs, the
# total wait does not exceed ${DEVICE_WAIT} + ${MAX_PLAY} seconds. The
# music plays once, never loops.

set -u

SOUND=/usr/share/kavis/boot/boot-sound.wav
SETTINGS=/etc/kavis/boot.conf
# Wait at most this long for the audio device. Polling every 0.2 s:
# polling once a second kept waiting half a second on average after the
# device was ready and the music reached the splash late.
DEVICE_WAIT=8
POLL=0.2
MAX_PLAY=10    # playback lasts at most this long

log() { echo "kavis-boot-sound: $*"; }

# --- read the settings -----------------------------------------------
# Default behavior when the values are missing from the file: play and wait.
PLAY_MUSIC=1
WAIT_FOR_MUSIC=1
if [ -r "$SETTINGS" ]; then
	# shellcheck disable=SC1090
	. "$SETTINGS"
fi

if [ "$PLAY_MUSIC" != "1" ]; then
	log "music disabled in settings (PLAY_MUSIC=$PLAY_MUSIC), skipped"
	exit 0
fi

plymouth_up=0
if command -v plymouth >/dev/null 2>&1 && plymouth --ping >/dev/null 2>&1; then
	plymouth_up=1
fi
log "plymouth: $plymouth_up"

# --- wait for the audio device ---------------------------------------
# /dev/snd/pcmC*D*p = playback device. Checking only for the /dev/snd
# directory is not enough; the playback device may not exist yet even
# when controlC0 does.
device=0
step=0
max_steps=$(( DEVICE_WAIT * 5 ))   # 0.2-second steps
while [ "$step" -lt "$max_steps" ]; do
	for d in /dev/snd/pcmC*D*p; do
		if [ -e "$d" ]; then
			device=1
			break
		fi
	done
	[ "$device" -eq 1 ] && break
	step=$((step + 1))
	sleep "$POLL"
done

# The measurement goes to the log: this line answers how late the music
# starts relative to the splash.
wait_ds=$(( step * 2 ))   # in 0.1-second units
if [ "$device" -eq 1 ]; then
	log "sound device ready in $((wait_ds / 10)).$((wait_ds % 10)) seconds"
else
	log "sound device did not appear in ${DEVICE_WAIT} seconds, music will be skipped"
fi

playable=0
if [ "$device" -eq 1 ] && [ -r "$SOUND" ] && command -v aplay >/dev/null 2>&1; then
	playable=1
fi

# --- if "wait" is off: play in the background, do not hold the splash --
if [ "$WAIT_FOR_MUSIC" != "1" ]; then
	if [ "$playable" -eq 1 ]; then
		timeout "$MAX_PLAY" aplay -q "$SOUND" >/dev/null 2>&1 &
		log "music started in the background (WAIT_FOR_MUSIC=$WAIT_FOR_MUSIC), splash not held"
	fi
	exit 0
fi

# --- play; the space key stops the music (madde 30's single exception) -
skipped=0
if [ "$playable" -eq 1 ]; then
	# Without `timeout` a broken audio device locks the boot forever.
	timeout "$MAX_PLAY" aplay -q "$SOUND" >/dev/null 2>&1 &
	aplay_pid=$!

	key_pid=0
	if [ "$plymouth_up" -eq 1 ]; then
		# watch-keystroke exits when space is pressed; if not pressed it
		# is killed below. Key listening is in Plymouth — no X, it owns
		# the tty.
		plymouth watch-keystroke --keys=" " >/dev/null 2>&1 &
		key_pid=$!
	fi

	# One of two events: the music ended OR space was pressed.
	while kill -0 "$aplay_pid" 2>/dev/null; do
		if [ "$key_pid" -ne 0 ] && ! kill -0 "$key_pid" 2>/dev/null; then
			skipped=1
			kill "$aplay_pid" 2>/dev/null
			break
		fi
		sleep 0.1
	done
	wait "$aplay_pid" 2>/dev/null
	if [ "$key_pid" -ne 0 ]; then
		kill "$key_pid" 2>/dev/null
		wait "$key_pid" 2>/dev/null
	fi

	if [ "$skipped" -eq 1 ]; then
		log "skipped with the space key, music stopped"
	else
		log "music finished"
	fi
else
	log "no sound file, device or aplay — music skipped"
fi

# --- notify the splash -----------------------------------------------
# If the music ended by itself: "start fading" (image and sound fade
# together), wait for the short fade-out. If SKIPPED with space (madde 6
# fix): the splash does not fade early — only the hint line becomes
# "Starting…"; the fade runs with the script's Quit when plymouth-quit
# arrives and the retained frame keeps that text.
if [ "$plymouth_up" -eq 1 ]; then
	if [ "$skipped" -eq 1 ]; then
		plymouth update --status=kavis-skipped >/dev/null 2>&1 || true
	else
		# The fade is gone (test8 H3b) — the wait margin is unnecessary too.
		plymouth update --status=kavis-finishing >/dev/null 2>&1 || true
	fi
fi

log "done"
exit 0
