#!/bin/sh
# Kavis — açılış müziğini çalar ve splash'i müzik bitene kadar tutar
#
# NEDEN AYRI SERVİS: Plymouth'un ses desteği yok (madde 30).
#
# NEDEN SPLASH'İ BU TUTUYOR: servis Type=oneshot ve unit dosyasında
# `Before=plymouth-quit.service`. Müzik bitene kadar servis "başlıyor"
# sayılıyor, dolayısıyla plymouth-quit bekliyor ve splash açık kalıyor.
# Sistem müzikten önce hazır olsa bile splash bekliyor — madde 30'un
# istediği bu. TEK İSTİSNA: boşluk tuşu — basılırsa müzik kesilir ve
# splash hemen sönmeye başlar (plymouth watch-keystroke ile dinleniyor).
#
# AYARLAR (/etc/kavis/boot.conf, ileride Ayarlar uygulaması yazacak):
#   MUZIK_CAL=0    → müzik hiç çalınmaz, splash beklemez
#   MUZIGI_BEKLE=0 → müzik arka planda başlar, splash beklemez
#
# SES AYGITINI BURADA BEKLİYORUZ, systemd'de DEĞİL:
# Unit `After=sound.target` ile beklerse gerçek donanımda açılışın çok
# ilerisine kayıyor ve splash'i tutamıyor (VirtualBox testinde müzik
# masaüstüne kadar taştı). Servis erken başlıyor, ses aygıtının
# gelmesini kısa ve sınırlı bir döngüyle burada bekliyoruz.
#
# GÜVENLİK AĞI: ses aygıtı hiç gelmezse ya da çalma takılırsa toplam
# bekleme ${AYGIT_BEKLEME} + ${AZAMI_CALMA} saniyeyi geçmiyor. Müzik
# bir kez çalar, döngüye alınmaz.

set -u

SES=/usr/share/kavis/boot/boot-sound.wav
AYARLAR=/etc/kavis/boot.conf
# Ses aygıtı için en fazla bu kadar bekle. Yoklama 0,2 saniyede bir:
# saniyede bir yoklamak, aygıt hazır olduktan sonra ortalama yarım
# saniye daha bekletiyordu ve müzik splash'e geç yetişiyordu.
AYGIT_BEKLEME=8
YOKLAMA=0.2
AZAMI_CALMA=10    # çalma en fazla bu kadar sürsün

log() { echo "kavis-boot-sound: $*"; }

# --- ayarları oku ----------------------------------------------------
# Değerler dosyada yoksa varsayılan davranış: çal ve bekle.
MUZIK_CAL=1
MUZIGI_BEKLE=1
if [ -r "$AYARLAR" ]; then
	# shellcheck disable=SC1090
	. "$AYARLAR"
fi

if [ "$MUZIK_CAL" != "1" ]; then
	log "muzik ayardan kapali (MUZIK_CAL=$MUZIK_CAL), atlandi"
	exit 0
fi

plymouth_var=0
if command -v plymouth >/dev/null 2>&1 && plymouth --ping >/dev/null 2>&1; then
	plymouth_var=1
fi
log "plymouth: $plymouth_var"

# --- ses aygıtını bekle ---------------------------------------------
# /dev/snd/pcmC*D*p = çalma (playback) aygıtı. Yalnızca /dev/snd
# dizininin varlığına bakmak yetmiyor; controlC0 varken bile playback
# aygıtı henüz oluşmamış olabiliyor.
aygit=0
adim=0
azami_adim=$(( AYGIT_BEKLEME * 5 ))   # 0,2 saniyelik adımlar
while [ "$adim" -lt "$azami_adim" ]; do
	for d in /dev/snd/pcmC*D*p; do
		if [ -e "$d" ]; then
			aygit=1
			break
		fi
	done
	[ "$aygit" -eq 1 ] && break
	adim=$((adim + 1))
	sleep "$YOKLAMA"
done

# Ölçüyü günlüğe yazıyoruz: müzik splash'e göre ne kadar geç başlıyor
# sorusunun cevabı bu satır.
bekleme_ds=$(( adim * 2 ))   # 0,1 saniye biriminde
if [ "$aygit" -eq 1 ]; then
	log "ses aygiti $((bekleme_ds / 10)).$((bekleme_ds % 10)) saniyede hazir"
else
	log "ses aygiti ${AYGIT_BEKLEME} saniyede gelmedi, muzik atlanacak"
fi

calinabilir=0
if [ "$aygit" -eq 1 ] && [ -r "$SES" ] && command -v aplay >/dev/null 2>&1; then
	calinabilir=1
fi

# --- "bekleme" kapalıysa: arka planda çal, splash'i tutma -------------
if [ "$MUZIGI_BEKLE" != "1" ]; then
	if [ "$calinabilir" -eq 1 ]; then
		timeout "$AZAMI_CALMA" aplay -q "$SES" >/dev/null 2>&1 &
		log "muzik arka planda basladi (MUZIGI_BEKLE=$MUZIGI_BEKLE), splash tutulmuyor"
	fi
	exit 0
fi

# --- çal; boşluk tuşu müziği keser (madde 30 tek istisnası) -----------
atlandi=0
if [ "$calinabilir" -eq 1 ]; then
	# `timeout` olmazsa bozuk bir ses aygıtı açılışı süresiz kilitler.
	timeout "$AZAMI_CALMA" aplay -q "$SES" >/dev/null 2>&1 &
	aplay_pid=$!

	tus_pid=0
	if [ "$plymouth_var" -eq 1 ]; then
		# watch-keystroke boşluğa basılınca çıkar; basılmazsa aşağıda
		# öldürülür. Tuş dinleme Plymouth'ta — X yok, tty yönetimi onda.
		plymouth watch-keystroke --keys=" " >/dev/null 2>&1 &
		tus_pid=$!
	fi

	# İki olaydan biri: müzik bitti YA DA boşluğa basıldı.
	while kill -0 "$aplay_pid" 2>/dev/null; do
		if [ "$tus_pid" -ne 0 ] && ! kill -0 "$tus_pid" 2>/dev/null; then
			atlandi=1
			kill "$aplay_pid" 2>/dev/null
			break
		fi
		sleep 0.1
	done
	wait "$aplay_pid" 2>/dev/null
	if [ "$tus_pid" -ne 0 ]; then
		kill "$tus_pid" 2>/dev/null
		wait "$tus_pid" 2>/dev/null
	fi

	if [ "$atlandi" -eq 1 ]; then
		log "bosluk tusuyla atlandi, muzik kesildi"
	else
		log "muzik bitti"
	fi
else
	log "ses dosyasi, aygit ya da aplay yok — muzik atlandi"
fi

# --- splash'e haber ver ----------------------------------------------
# Müzik kendiliğinden bittiyse: "sönmeye başla" (görsel ile ses birlikte
# söner), kısa fade-out'u bekle. Boşlukla ATLANDIYSA (madde 6
# düzeltmesi): splash erken sönmez — yalnız ipucu satırı "Başlatılıyor…"
# olur; fade, plymouth-quit geldiğinde script'in Cikis'iyle çalışır ve
# retain karesi o yazıyla kalır.
if [ "$plymouth_var" -eq 1 ]; then
	if [ "$atlandi" -eq 1 ]; then
		plymouth update --status=kavis-atlandi >/dev/null 2>&1 || true
	else
		# Fade kalktı (test8 H3b) — bekleme payı da gereksiz.
		plymouth update --status=kavis-sonlaniyor >/dev/null 2>&1 || true
	fi
fi

log "tamam"
exit 0
