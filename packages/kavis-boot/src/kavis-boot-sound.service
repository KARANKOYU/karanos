[Unit]
Description=Kavis boot music and boot splash hold
Documentation=file:///usr/share/doc/kavis-boot/README.md

# WHY NO `sound.target`:
# The first version waited with `After=sound.target`. sound.target is
# reached only after udev has found and configured the sound card; on
# real hardware that was far into the boot. The result in the
# VirtualBox test: the splash came up silent, faded, the console
# appeared, the music started only then and spilled all the way into
# the desktop. So the service started too late to hold the splash.
#
# Now the service starts at the earliest possible point and WAITING for
# the audio device is done by the script itself (with a bounded time).
# This makes the start moment predictable and the ordering that holds
# the splash works.
#
# WHY NO `systemd-udev-trigger` either (4D): After=systemd-udev-trigger
# pushed SOUND-DELAY to 3.7-4.0 seconds — in QEMU without KVM the
# trigger finishes seconds after the splash starts and the service
# waited that long. Since the script already polls the device node
# itself (every 0.2 s, at most 8 s) the ordering bond is unnecessary:
# our only condition is not starting before the splash, and the
# plymouth-start line provides that.
DefaultDependencies=no
After=plymouth-start.service

# THESE TWO LINES are the actual mechanism holding the splash until the
# music ends. The drop-ins on the plymouth-quit side state the same
# ordering; writing it from both directions keeps the ordering even if
# a drop-in somehow does not take effect.
Before=plymouth-quit.service plymouth-quit-wait.service

# No boot splash shown, no music either: booting silently in recovery
# mode or without `splash` is the right behavior.
ConditionKernelCommandLine=splash

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/kavis/boot-sound
# The script bounds itself (waiting for the audio device + playing does
# not exceed ~15 seconds in total); this value is a safety net above
# that. If exceeded the service counts as failed but the boot goes on.
TimeoutStartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sysinit.target
