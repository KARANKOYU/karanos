# Kavis — Plymouth boot splash (script plugin)
#
# The design from madde 30:
#   1. Plain background (#0D141B) — NO wallpaper/photo
#   2. Dark logo in the center (logo.png generated from koyu-k-logo.svg;
#      rule: the boot splash ALWAYS uses the dark logo)
#   3. Product name below the logo (product-name.png — generated at
#      build time from os-release NAME, the name is not embedded in code)
#   4. Below that a small "made by Karan" signature
#   5. Two hint lines at the bottom: "F3 — Advanced menu" and
#      "Press space to skip" (default language EN — 2 Sep 2026 decision)
#   6. Smooth transitions: opens with a glow from 15% to 100%, fades
#      out softly when the music ends (or is skipped with space)
#
# A separate systemd service plays the music (Plymouth has no audio
# support); that service also listens for the space key (plymouth
# watch-keystroke) — NO key handling on the script side, drawing only.
#
# WHY THE TEXTS ARE PNG: Plymouth uses bitmap fonts; the texts are
# converted from SVG to PNG at package build time. No font dependency
# at boot, the result is identical on every machine.
#
# LANGUAGE LIMITS: Plymouth's script language is a small language. Only
# constructs known to be supported are used here on purpose:
#   - no `++`, `frame = frame + 1` is written instead
#   - no bare `return;`, every branch is split with if/else
#   - a Sprite's opacity cannot be read back (no GetOpacity), so the
#     opacities are kept in separate variables
#
# TIMING: Refresh is called ~50 times per second. Instead of reading a
# real clock we count frames — Plymouth has no reliable time source.

# --- settings --------------------------------------------------------
FRAME_RATE        = 50.0;
GLOW_DURATION     = 1.5;   # seconds — 15% to 100%
START_OPACITY     = 0.15;
NAME_OPACITY      = 0.95;
SIGNATURE_OPACITY = 0.75;
HINT_OPACITY      = 0.70;
GLOW_OPACITY      = 0.18;
# NO FADE (test8 H3b): the old fade to 35% gave a ~1 s "stuck" feeling
# on the retained frame. The splash stays at FULL BRIGHTNESS; when X
# arrives picom's fade-in lays the desktop over it — the transition
# becomes "splash → desktop". On shutdown only the hint line changes to
# "Starting…" (the misleading "space key" text must not remain on the
# retained frame).

# Background: plain, single color — the desktop ground #0D141B (madde
# 30: no wallpaper). Top and bottom the same color, not even a gradient.
Window.SetBackgroundTopColor(0.051, 0.078, 0.106);
Window.SetBackgroundBottomColor(0.051, 0.078, 0.106);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# --- images ----------------------------------------------------------
logo_raw      = Image("logo.png");
name_raw      = Image("product-name.png");
signature_raw = Image("made-by-karan.png");
hints_raw     = Image("boot-hints.png");
# The single line that replaces the hints when skipped with space
# (madde 6 fix): visual feedback — the splash does not close early,
# retain continues.
# G/B2: 8-frame spinner (24 px, teal) — when the music ends it appears
# centered BELOW the signature and spins until X arrives; the
# "Starting…" text is gone (the ring is enough), the hint line fades
# out at that moment too.
SPINNER_PX = 24;
spinner_frame = 0;
while (spinner_frame < 8)
  {
    spinner_raw = Image("spinner-" + spinner_frame + ".png");
    spinner[spinner_frame] = spinner_raw.Scale(SPINNER_PX, SPINNER_PX);
    spinner_frame = spinner_frame + 1;
  }
spinner_sprite = Sprite(spinner[0]);
spinner_sprite.SetOpacity(0);
spinner_on = 0;

# The logo covers at most a quarter of the screen; it must not overflow
# on a small screen nor get lost on a big one.
target_h = screen_h / 4;
logo_scale = target_h / logo_raw.GetHeight();
if (logo_raw.GetWidth() * logo_scale > screen_w * 0.5)
  {
    logo_scale = (screen_w * 0.5) / logo_raw.GetWidth();
  }

logo_w = logo_raw.GetWidth() * logo_scale;
logo_h = logo_raw.GetHeight() * logo_scale;
logo = logo_raw.Scale(logo_w, logo_h);

# Glow: a slightly enlarged copy of the same image, behind, low opacity
glow_w = logo_w * 1.10;
glow_h = logo_h * 1.10;
glow = logo_raw.Scale(glow_w, glow_h);

# The product name is a bit wider than the logo — reads like a wordmark
name_w = logo_w * 1.35;
name_scale = name_w / name_raw.GetWidth();
name_h = name_raw.GetHeight() * name_scale;
name = name_raw.Scale(name_w, name_h);

# The signature is small and faint
# H2 (test8): 'made by Karan' 2× — reads comfortably below the KAVİS
# text; ratio 0.55 → 1.1.
signature_w = logo_w * 1.1;
signature_scale = signature_w / signature_raw.GetWidth();
signature_h = signature_raw.GetHeight() * signature_scale;
signature = signature_raw.Scale(signature_w, signature_h);

# Hints follow the screen width; they sit at the bottom edge
hints_w = screen_w * 0.34;
if (hints_w > hints_raw.GetWidth())
  {
    hints_w = hints_raw.GetWidth();
  }
hints_scale = hints_w / hints_raw.GetWidth();
hints_h = hints_raw.GetHeight() * hints_scale;
hints = hints_raw.Scale(hints_w, hints_h);

# "Starting…" is shrunk with the same scale — same text size as the hints.

# --- layout ----------------------------------------------------------
# The logo + name + signature block is centered vertically (the block
# is independent of the hints)
gap1 = logo_h * 0.14;   # between logo and name
gap2 = logo_h * 0.10;   # between name and signature
total_h = logo_h + gap1 + name_h + gap2 + signature_h;
top = (screen_h - total_h) / 2;

logo_x = (screen_w - logo_w) / 2;
logo_y = top;
name_x = (screen_w - name_w) / 2;
name_y = top + logo_h + gap1;
signature_x = (screen_w - signature_w) / 2;
signature_y = name_y + name_h + gap2;

hints_x = (screen_w - hints_w) / 2;
hints_y = screen_h - hints_h - (screen_h * 0.05);

glow_sprite = Sprite(glow);
glow_sprite.SetPosition(logo_x - (glow_w - logo_w) / 2,
                        logo_y - (glow_h - logo_h) / 2, 1);
glow_sprite.SetOpacity(0);

logo_sprite = Sprite(logo);
logo_sprite.SetPosition(logo_x, logo_y, 2);
logo_sprite.SetOpacity(START_OPACITY);

name_sprite = Sprite(name);
name_sprite.SetPosition(name_x, name_y, 2);
name_sprite.SetOpacity(0);

signature_sprite = Sprite(signature);
signature_sprite.SetPosition(signature_x, signature_y, 2);
signature_sprite.SetOpacity(0);

hints_sprite = Sprite(hints);
hints_sprite.SetPosition(hints_x, hints_y, 2);
hints_sprite.SetOpacity(0);

# --- state -----------------------------------------------------------
frame = 0;
hint_changed = 0;
hints_hidden = 0;

# Opacity cannot be read back from a Sprite, so we keep it ourselves.
logo_opacity = START_OPACITY;
name_opacity = 0;
signature_opacity = 0;
hints_opacity = 0;
glow_opacity = 0;

fun Refresh()
  {
    frame = frame + 1;

    t = frame / FRAME_RATE;
    if (t < GLOW_DURATION)
      {
        # Opening: 15% → 100%
        progress = t / GLOW_DURATION;
        logo_opacity = START_OPACITY + (1 - START_OPACITY) * progress;
        name_opacity = NAME_OPACITY * progress;
        signature_opacity = SIGNATURE_OPACITY * progress;
        hints_opacity = HINT_OPACITY * progress;
        glow_opacity = GLOW_OPACITY * progress;
      }
    else
      {
        logo_opacity = 1;
        name_opacity = NAME_OPACITY;
        signature_opacity = SIGNATURE_OPACITY;
        hints_opacity = HINT_OPACITY;
        # Let the glow breathe slightly — no frozen-screen impression.
        # Small amplitude, not distracting.
        glow_opacity = GLOW_OPACITY
                       + 0.07 * Math.Sin((t - GLOW_DURATION) * 1.6);
      }
    logo_sprite.SetOpacity(logo_opacity);
    name_sprite.SetOpacity(name_opacity);
    signature_sprite.SetOpacity(signature_opacity);
    if (hints_hidden == 1) { hints_opacity = 0; }
    hints_sprite.SetOpacity(hints_opacity);
    glow_sprite.SetOpacity(glow_opacity);
    if (spinner_on == 1)
      {
        # one step every 6 frames (≈ a full turn per second at 50 fps)
        spinner_sprite.SetImage(spinner[Math.Int(frame / 6) % 8]);
        spinner_sprite.SetOpacity(HINT_OPACITY);
      }
  }

fun SwitchHint()
  {
    if (hint_changed == 0)
      {
        hint_changed = 1;
        # the hint line fades out (Refresh checks hints_hidden), the
        # spinner appears centered below the signature.
        hints_hidden = 1;
        spinner_sprite.SetPosition((screen_w - SPINNER_PX) / 2,
                                   signature_y + signature_h + gap2,
                                   2);
        spinner_on = 1;
      }
  }

# The sound service sends kavis-finishing when the music ends and
# kavis-skipped when skipped with space; in both cases (and on quit) the
# hint line becomes "Starting…" — NO fade, the splash is retained at
# full brightness.
fun StatusChanged(status)
  {
    if (status == "kavis-finishing")
      {
        SwitchHint();
      }
    if (status == "kavis-skipped")
      {
        SwitchHint();
      }
  }

fun Quit()
  {
    SwitchHint();
  }

Plymouth.SetRefreshFunction(Refresh);
Plymouth.SetUpdateStatusFunction(StatusChanged);
Plymouth.SetQuitFunction(Quit);
