# Kavis — Plymouth açılış ekranı (script eklentisi)
#
# Madde 30'daki tasarım:
#   1. Sade zemin (#0D141B) — duvar kâğıdı/fotoğraf YOK
#   2. Ortada koyu logo (koyu-k-logo.svg'den üretilen logo.png; kural:
#      açılış ekranında HER ZAMAN koyu logo)
#   3. Logonun altında ürün adı (urun-adi.png — os-release NAME'den
#      derlemede üretilir, ad koda gömülü değil)
#   4. Onun altında küçük "made by Karan" imzası
#   5. En altta iki ipucu satırı: "F3 — Gelişmiş menü" ve
#      "Atlamak için boşluk tuşu"
#   6. Geçişler yumuşak: %15'ten %100'e parlama ile açılır, müzik
#      bitince (ya da boşlukla atlanınca) yumuşakça söner
#
# Müziği ayrı bir systemd servisi çalar (Plymouth'un ses desteği yok);
# boşluk tuşunu da o servis dinler (plymouth watch-keystroke) — script
# tarafında tuş işleme YOK, tek görev çizim.
#
# NEDEN YAZILAR PNG: Plymouth bitmap font kullanıyor; yazılar paket
# derlenirken SVG'den PNG'ye çevriliyor. Açılışta yazı tipi bağımlılığı
# kalmıyor, sonuç her makinede birebir aynı.
#
# DİL KISITI: Plymouth'un script dili küçük bir dil. Burada bilerek
# yalnızca kesin desteklenen yapılar kullanılıyor:
#   - `++` yok, `kare = kare + 1` yazılıyor
#   - gövdesiz `return;` yok, her dal if/else ile ayrılıyor
#   - Sprite'ın opaklığı geri okunamıyor (GetOpacity yok), bu yüzden
#     opaklıklar ayrı değişkenlerde tutuluyor
#
# ZAMANLAMA: Refresh saniyede ~50 kez çağrılıyor. Gerçek saat okumak
# yerine kare sayıyoruz — Plymouth'ta güvenilir bir zaman kaynağı yok.

# --- ayarlar ---------------------------------------------------------
KARE_HIZI      = 50.0;
PARLAMA_SURESI = 1.5;   # saniye — %15'ten %100'e
BASLANGIC_OPAK = 0.15;
AD_OPAK        = 0.95;
IMZA_OPAK      = 0.75;
IPUCU_OPAK     = 0.70;
PARLAMA_OPAK   = 0.18;
SONME_SURESI   = 0.5;   # saniye — kapanmadan önceki fade-out
# Fade SIFIRA değil, bu orana kadar iniyor.
#
# NEDEN: plymouth-quit `--retain-splash` ile çıkıyor, yani ekranda kalan
# SON KARE X ayağa kalkana kadar duruyor. Fade sıfıra inince o kare
# bomboş oluyordu ve VirtualBox testinde masaüstünden önce ~3 saniye
# siyah ekran görülüyordu. Görsel soluk da olsa ekranda kalınca o boşluk
# "kararmış açılış ekranı" gibi görünüyor, siyah bir hiçlik gibi değil.
SONME_HEDEF    = 0.35;

# Zemin: sade, tek renk — masaüstü zemini #0D141B (madde 30: duvar
# kâğıdı yok). Üst ve alt aynı renk, degrade bile yok.
Window.SetBackgroundTopColor(0.051, 0.078, 0.106);
Window.SetBackgroundBottomColor(0.051, 0.078, 0.106);

ekran_w = Window.GetWidth();
ekran_h = Window.GetHeight();

# --- görseller -------------------------------------------------------
logo_ham  = Image("logo.png");
ad_ham    = Image("urun-adi.png");
imza_ham  = Image("made-by-karan.png");
ipucu_ham = Image("acilis-ipuclari.png");
# Boşlukla atlanınca ipuçlarının yerine geçen tek satır (madde 6
# düzeltmesi): görsel karşılık — splash erken kapanmaz, retain sürer.
baslat_ham = Image("baslatiliyor.png");

# Logo ekranın en fazla dörtte birini kaplasın; küçük ekranda taşmasın,
# büyük ekranda kaybolmasın.
hedef_h = ekran_h / 4;
olcek = hedef_h / logo_ham.GetHeight();
if (logo_ham.GetWidth() * olcek > ekran_w * 0.5)
  {
    olcek = (ekran_w * 0.5) / logo_ham.GetWidth();
  }

logo_w = logo_ham.GetWidth() * olcek;
logo_h = logo_ham.GetHeight() * olcek;
logo = logo_ham.Scale(logo_w, logo_h);

# Parlama: aynı görselin biraz büyütülmüş kopyası, arkada, düşük opaklık
parlama_w = logo_w * 1.10;
parlama_h = logo_h * 1.10;
parlama = logo_ham.Scale(parlama_w, parlama_h);

# Ürün adı logodan biraz geniş — marka yazısı gibi dursun
ad_w = logo_w * 1.35;
ad_olcek = ad_w / ad_ham.GetWidth();
ad_h = ad_ham.GetHeight() * ad_olcek;
ad = ad_ham.Scale(ad_w, ad_h);

# İmza küçük ve soluk
imza_w = logo_w * 0.55;
imza_olcek = imza_w / imza_ham.GetWidth();
imza_h = imza_ham.GetHeight() * imza_olcek;
imza = imza_ham.Scale(imza_w, imza_h);

# İpuçları ekran genişliğine göre; alt kenara oturur
ipucu_w = ekran_w * 0.34;
if (ipucu_w > ipucu_ham.GetWidth())
  {
    ipucu_w = ipucu_ham.GetWidth();
  }
ipucu_olcek = ipucu_w / ipucu_ham.GetWidth();
ipucu_h = ipucu_ham.GetHeight() * ipucu_olcek;
ipucu = ipucu_ham.Scale(ipucu_w, ipucu_h);

# "Başlatılıyor…" aynı ölçekle küçültülür — yazı boyu ipuçlarıyla aynı.
baslat_w = baslat_ham.GetWidth() * ipucu_olcek;
baslat_h = baslat_ham.GetHeight() * ipucu_olcek;
baslat = baslat_ham.Scale(baslat_w, baslat_h);

# --- yerleşim --------------------------------------------------------
# Logo + ad + imza bloğu dikeyde ortalanır (blok, ipuçlarından bağımsız)
bosluk1 = logo_h * 0.14;   # logo ile ad arası
bosluk2 = logo_h * 0.10;   # ad ile imza arası
toplam_h = logo_h + bosluk1 + ad_h + bosluk2 + imza_h;
ust = (ekran_h - toplam_h) / 2;

logo_x = (ekran_w - logo_w) / 2;
logo_y = ust;
ad_x = (ekran_w - ad_w) / 2;
ad_y = ust + logo_h + bosluk1;
imza_x = (ekran_w - imza_w) / 2;
imza_y = ad_y + ad_h + bosluk2;

ipucu_x = (ekran_w - ipucu_w) / 2;
ipucu_y = ekran_h - ipucu_h - (ekran_h * 0.05);

parlama_sprite = Sprite(parlama);
parlama_sprite.SetPosition(logo_x - (parlama_w - logo_w) / 2,
                           logo_y - (parlama_h - logo_h) / 2, 1);
parlama_sprite.SetOpacity(0);

logo_sprite = Sprite(logo);
logo_sprite.SetPosition(logo_x, logo_y, 2);
logo_sprite.SetOpacity(BASLANGIC_OPAK);

ad_sprite = Sprite(ad);
ad_sprite.SetPosition(ad_x, ad_y, 2);
ad_sprite.SetOpacity(0);

imza_sprite = Sprite(imza);
imza_sprite.SetPosition(imza_x, imza_y, 2);
imza_sprite.SetOpacity(0);

ipucu_sprite = Sprite(ipucu);
ipucu_sprite.SetPosition(ipucu_x, ipucu_y, 2);
ipucu_sprite.SetOpacity(0);

# --- durum -----------------------------------------------------------
kare = 0;
sonuyor = 0;
sonme_karesi = 0;
atlandi = 0;

# Sprite'tan opaklık geri okunamadığı için kendimiz tutuyoruz.
logo_opak = BASLANGIC_OPAK;
ad_opak = 0;
imza_opak = 0;
ipucu_opak = 0;
parlama_opak = 0;

fun Refresh()
  {
    kare = kare + 1;

    if (sonuyor == 1)
      {
        # Kapanış: her şey birlikte söner; ipuçları tamamen kaybolur
        # (kapanan ekranda "boşluk tuşu" yazısı yanıltıcı olur). Boşlukla
        # atlanmışsa satır artık "Başlatılıyor…" — o yanıltmaz, retain
        # karesinde okunur kalsın diye ötekilerle aynı orana iner.
        gecen = (kare - sonme_karesi) / KARE_HIZI;
        k = 1 - (gecen / SONME_SURESI);
        if (k < SONME_HEDEF)
          {
            k = SONME_HEDEF;
          }
        ki = 1 - (gecen / SONME_SURESI);
        if (ki < 0)
          {
            ki = 0;
          }
        if (atlandi == 1)
          {
            ki = k;
          }
        logo_sprite.SetOpacity(logo_opak * k);
        ad_sprite.SetOpacity(ad_opak * k);
        imza_sprite.SetOpacity(imza_opak * k);
        parlama_sprite.SetOpacity(parlama_opak * k);
        ipucu_sprite.SetOpacity(ipucu_opak * ki);
      }
    else
      {
        t = kare / KARE_HIZI;
        if (t < PARLAMA_SURESI)
          {
            # Açılış: %15 → %100
            ilerleme = t / PARLAMA_SURESI;
            logo_opak = BASLANGIC_OPAK + (1 - BASLANGIC_OPAK) * ilerleme;
            ad_opak = AD_OPAK * ilerleme;
            imza_opak = IMZA_OPAK * ilerleme;
            ipucu_opak = IPUCU_OPAK * ilerleme;
            parlama_opak = PARLAMA_OPAK * ilerleme;
          }
        else
          {
            logo_opak = 1;
            ad_opak = AD_OPAK;
            imza_opak = IMZA_OPAK;
            ipucu_opak = IPUCU_OPAK;
            # Parlama hafifçe nefes alsın — donmuş ekran izlenimi
            # vermesin. Genlik küçük, dikkat dağıtmıyor.
            parlama_opak = PARLAMA_OPAK
                           + 0.07 * Math.Sin((t - PARLAMA_SURESI) * 1.6);
          }
        logo_sprite.SetOpacity(logo_opak);
        ad_sprite.SetOpacity(ad_opak);
        imza_sprite.SetOpacity(imza_opak);
        ipucu_sprite.SetOpacity(ipucu_opak);
        parlama_sprite.SetOpacity(parlama_opak);
      }
  }

fun SonmeyiBaslat()
  {
    if (sonuyor == 0)
      {
        sonuyor = 1;
        sonme_karesi = kare;
      }
  }

# Ses servisi müzik bitince `--status=kavis-sonlaniyor` (fade-out),
# boşlukla atlanınca `--status=kavis-atlandi` gönderiyor. Atlamada
# splash ERKEN KAPANMAZ (madde 6 düzeltmesi): yalnız ipucu satırları
# "Başlatılıyor…" ile değişir; fade, plymouth-quit geldiğinde Cikis()
# üzerinden yine çalışır ve retain karesi bu yazıyla kalır.
fun DurumDegisti(durum)
  {
    if (durum == "kavis-sonlaniyor")
      {
        SonmeyiBaslat();
      }
    if (durum == "kavis-atlandi")
      {
        if (atlandi == 0)
          {
            atlandi = 1;
            ipucu_sprite.SetImage(baslat);
            ipucu_sprite.SetPosition((ekran_w - baslat_w) / 2,
                                     ekran_h - baslat_h - (ekran_h * 0.05),
                                     2);
          }
      }
  }

fun Cikis()
  {
    SonmeyiBaslat();
  }

Plymouth.SetRefreshFunction(Refresh);
Plymouth.SetUpdateStatusFunction(DurumDegisti);
Plymouth.SetQuitFunction(Cikis);
