<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ürün adı — açılış ekranında logonun altındaki "KAVİS" yazısı (madde 30).

  @AD@ yer tutucusu derleme sırasında os-release NAME değerinin Türkçe
  büyük harfli hâliyle değiştirilir (debian/rules). Ad koda gömülmüyor:
  isim değişirse bu dosya elle güncellenmez.

  NEDEN SVG: Plymouth bitmap font kullanıyor; yazı derlemede PNG'ye
  çevriliyor, açılışta yazı tipi bağımlılığı kalmıyor.

  Renk #E6EDF3 = koyu paletin ana metin rengi; harf aralığı geniş —
  logo altında bir "marka yazısı" gibi dursun diye.
-->
<svg xmlns="http://www.w3.org/2000/svg" width="800" height="160" viewBox="0 0 800 160">
  <text x="400" y="110"
        text-anchor="middle"
        font-family="DejaVu Sans"
        font-weight="bold"
        font-size="96"
        letter-spacing="28"
        fill="#E6EDF3">@AD@</text>
</svg>
