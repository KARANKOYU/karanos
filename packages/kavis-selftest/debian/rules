#!/usr/bin/make -f
# kavis-selftest — Vala, GTK3 + libwnck; scenarios come from tests/ui
# (build-packages.sh prepare_sources copies them under scenarios/).
export DH_VERBOSE = 1
DEST := debian/kavis-selftest
VALA_PKGS := --pkg gtk+-3.0 --pkg libwnck-3.0 --pkg gdk-x11-3.0 \
                 --pkg x11 --pkg posix
# -lXtst: XRecord, used by --record. src/xrecord.c is handed to the C
# compiler by valac — XRecord has no vapi and a hand-written binding for
# a two-connection callback API would be the fragile choice.
VALA_CFLAGS := -X -DWNCK_I_KNOW_THIS_IS_UNSTABLE -X -O2 -X -w -X -lm \
                 -X -lXtst
SOURCES := $(wildcard src/*.vala) src/xrecord.c

%:
	dh $@

override_dh_auto_build:
	valac $(VALA_PKGS) $(VALA_CFLAGS) -o kavis-selftest $(SOURCES)

override_dh_auto_install:
	install -d $(DEST)/usr/bin $(DEST)/usr/share/kavis/selftest
	install -m755 kavis-selftest $(DEST)/usr/bin/kavis-selftest
	install -m644 scenarios/*.yaml $(DEST)/usr/share/kavis/selftest/

override_dh_auto_clean:
	rm -f kavis-selftest
