#!/bin/sh
# Plymouth'un varsayılan temasını Karan OS yap.
#
# `plymouth-set-default-theme -R` initramfs'i de yeniden üretiyor ama
# burada -R KULLANMIYORUZ: live-build chroot'unda her paket kurulumunda
# initramfs üretmek derlemeyi dakikalarca uzatıyor. initramfs'i
# iso/config/hooks/normal/0300-plymouth.hook.chroot bir kez, en sonda
# üretiyor. Kurulu sistemde paket elle kurulursa da aşağıdaki
# update-initramfs devreye giriyor.
set -e

case "$1" in
configure)
	if command -v plymouth-set-default-theme >/dev/null 2>&1; then
		plymouth-set-default-theme karanos
	fi
	# live-build chroot'unda değilsek initramfs'i tazele
	if [ -z "${LIVE_BUILD_CHROOT:-}" ] && [ ! -e /var/lib/live/config ] &&
		command -v update-initramfs >/dev/null 2>&1; then
		update-initramfs -u || true
	fi
	;;
esac

#DEBHELPER#

exit 0
